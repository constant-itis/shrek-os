#!/bin/sh
# mkosi postinst — runs on the HOST with the image tree exposed as $BUILDROOT (the sandbox's own /etc
# is read-only, so we must write into $BUILDROOT/etc, not /etc). Create the unprivileged 'shrek'
# control-plane user so oniond/shrekctl run non-root and the gatekeeperd socket peer-check has a uid to
# allow. Baked into the sealed /etc at build time — the runtime /etc is read-only (dm-verity), so a
# boot-time systemd-sysusers could never create it. Direct append (no useradd dependency in the image).
set -eu

grep -q '^shrek:' "$BUILDROOT/etc/group" \
    || echo 'shrek:x:700:' >> "$BUILDROOT/etc/group"
grep -q '^shrek:' "$BUILDROOT/etc/passwd" || {
    echo 'shrek:x:700:700:Shrek OS control plane:/nonexistent:/usr/sbin/nologin' >> "$BUILDROOT/etc/passwd"
    echo 'shrek:!*:19723:0:99999:7:::' >> "$BUILDROOT/etc/shadow"
}
echo "postinst: shrek control-plane user -> $(grep '^shrek:' "$BUILDROOT/etc/passwd")"

#!/bin/sh
# mkosi postinst — runs on the HOST with the image tree exposed as $BUILDROOT (the sandbox's own /etc
# is read-only, so we must write into $BUILDROOT/etc, not /etc). Create the unprivileged 'shrek'
# control-plane user so oniond/shrekctl run non-root and the gatekeeperd socket peer-check has a uid to
# allow. Baked into the sealed /etc at build time — the runtime /etc is read-only (dm-verity), so a
# boot-time systemd-sysusers could never create it. Direct append (no useradd dependency in the image).
set -eu

grep -q '^shrek:' "$BUILDROOT/etc/group" \
    || echo 'shrek:x:700:' >> "$BUILDROOT/etc/group"
grep -q '^shrek:' "$BUILDROOT/etc/passwd" || {
    echo 'shrek:x:700:700:Shrek OS control plane:/nonexistent:/usr/sbin/nologin' >> "$BUILDROOT/etc/passwd"
    echo 'shrek:!*:19723:0:99999:7:::' >> "$BUILDROOT/etc/shadow"
}
echo "postinst: shrek control-plane user -> $(grep '^shrek:' "$BUILDROOT/etc/passwd")"

# Dogfood-0 (M1): the real, non-root DESKTOP user (uid 1000). Replaces the M0 root tty1 autologin —
# getty@tty1 now autologins `dev` (image/overlay/.../getty@tty1.service.d/autologin.conf), and sway
# runs as this user. NO video/render/input groups: the ACTIVE logind session gets the DRM/input device
# ACLs via systemd-logind uaccess, so membership is unnecessary. dev's HOME is /home/dev on the
# persistent shrek-data disk (home.mount + tmpfiles.d/shrek-home.conf), created on first boot. Baked
# here (runtime /etc is read-only dm-verity).
#
# PASSWORD: an UNLOCKED sha512 hash of `shrek` — NOT the hash-LESS `!*` used for the nologin `shrek`
# control-plane user, and NOT an empty password. Sprint S3 (lock+idle) turned dev's password ON: the DMS
# lock screen authenticates dev via PAM (/etc/pam.d/login → pam_unix → this hash), so the hash must be
# UNLOCKED (no `!` prefix) or pam_unix refuses it and the screen can never be unlocked. tty1 autologin is
# unaffected (agetty --autologin execs `login -f`, which skips authentication). This does not widen
# exposure — dev is already the autologin console user and sudo is NOPASSWD (sudoers.d/dev-nopasswd).
# Default demo/dogfood credential `shrek` (documented; INSTALL-0 / the user can change it) — a throwaway
# like keys/, not a real secret. acct_mgmt still returns SUCCESS (valid, non-expired hash).
DEV_PW='$6$Ylf7qC855/ESKbuC$5K7c15ydx9s3vgGnYOtXg5nfDi0NaUuSBfgIEJdN5ilgPab9h/i3jXUpJbHFPla6Leq9S5ZLrvfM2TnRzrECh.'
grep -q '^dev:' "$BUILDROOT/etc/group" \
    || echo 'dev:x:1000:' >> "$BUILDROOT/etc/group"
grep -q '^dev:' "$BUILDROOT/etc/passwd" || {
    echo 'dev:x:1000:1000:Shrek OS dogfood dev:/home/dev:/bin/bash' >> "$BUILDROOT/etc/passwd"
    echo "dev:${DEV_PW}:20000:0:99999:7:::" >> "$BUILDROOT/etc/shadow"
}
echo "postinst: dev desktop user -> $(grep '^dev:' "$BUILDROOT/etc/passwd")"

# Bench-0 (ADR-003 Part 2): rootless Podman for the Bench plane needs a subordinate uid/gid range for
# `dev` so `newuidmap`/`newgidmap` (setuid, from the shrek-bench Onion's `uidmap` pkg) can map a full
# 65536-wide user namespace — without it podman rootless degrades to a single uid and most images break
# on chown. These live in /etc/subuid + /etc/subgid, which a sysext CANNOT provide (a sysext extends
# /usr only) and which the runtime /etc is sealed read-only, so — exactly like the dev/swamp/polkitd
# users above — they must be baked into the sealed base /etc now. Range 100000:65536 is the Debian
# useradd default block, clear of the low system/reserved uids (shrek=700, dev=1000, swamp=20001).
# Verified in a trixie container (bench0-prevalidate): this bake yields a 0..1000..65536 uid_map.
grep -q '^dev:' "$BUILDROOT/etc/subuid" || echo 'dev:100000:65536' >> "$BUILDROOT/etc/subuid"
grep -q '^dev:' "$BUILDROOT/etc/subgid" || echo 'dev:100000:65536' >> "$BUILDROOT/etc/subgid"
echo "postinst: dev subid range -> subuid $(grep '^dev:' "$BUILDROOT/etc/subuid") / subgid $(grep '^dev:' "$BUILDROOT/etc/subgid")"

# Bench-0 (ADR-003 Part 2): podman's /etc/containers footprint. A sysext extends /usr ONLY, so the
# shrek-bench Onion's storage.conf/containers.conf ride /usr/share/containers (podman reads there), but
# the containers-common package's /etc files (policy.json, registries.conf) get STRIPPED from a sysext and
# /etc is sealed read-only at runtime — so they must be baked into the base /etc now, same as subuid above
# and the desktop layer's polkit rules. policy.json is MANDATORY (podman refuses every image op without an
# image-signature policy); the Bench MVP runs offline seeds (podman load) so an accept-anything default is
# correct — real signature enforcement for *pulled* images is a later egress/trust decision. registries.conf
# disables unqualified short-name search (offline seeds use fully-qualified localhost/ names), matching the
# default-deny egress posture. Inert on a non-bench build (no podman until the shrek-bench sysext merges).
install -d -o 0 -g 0 -m 0755 "$BUILDROOT/etc/containers"
cat > "$BUILDROOT/etc/containers/policy.json" <<'CPOL'
{
    "default": [ { "type": "insecureAcceptAnything" } ]
}
CPOL
cat > "$BUILDROOT/etc/containers/registries.conf" <<'CREG'
# Shrek Bench plane (ADR-003): offline seeds are referenced by fully-qualified localhost/ names, so no
# unqualified short-name registry search is permitted (matches Shrek's default-deny / named-egress model).
unqualified-search-registries = []
CREG
chown 0:0 "$BUILDROOT/etc/containers/policy.json" "$BUILDROOT/etc/containers/registries.conf"
chmod 0644 "$BUILDROOT/etc/containers/policy.json" "$BUILDROOT/etc/containers/registries.conf"
echo "postinst: podman /etc/containers -> $(ls -1 "$BUILDROOT/etc/containers" | tr '\n' ' ')"

# Dogfood-0 (M3): the `swamp` system user+group. gatekeeperd writes its session/authority records
# root:swamp 0640 (session_view.rs `swamp_ids()` resolves BOTH the swamp user in /etc/passwd and the
# swamp group in /etc/group by NAME — absent either, the chown silently falls back to root:root and the
# 0640 record is unreadable by anyone but root). The desktop `dev` user JOINS swamp so the read-only
# SessionProvider can `cat` the records → a real `shrek run` T2 session appears LIVE in the Work drawer.
# This is the record's designed second reader; the 0640/root:swamp C1 property is unchanged (a non-root,
# non-swamp process still cannot read it).
grep -q '^swamp:' "$BUILDROOT/etc/group" \
    || echo 'swamp:x:20001:dev' >> "$BUILDROOT/etc/group"
grep -q '^swamp:' "$BUILDROOT/etc/passwd" || {
    echo 'swamp:x:20001:20001:Shrek swamp service:/nonexistent:/usr/sbin/nologin' >> "$BUILDROOT/etc/passwd"
    echo 'swamp:!*:20000:0:99999:7:::' >> "$BUILDROOT/etc/shadow"
}
echo "postinst: swamp svc + dev membership -> $(grep '^swamp:' "$BUILDROOT/etc/group")"

# Sprint S1 (power path): the shrek-desktop Onion layer adds polkit, whose polkit.service runs as
# User=polkitd. A layer ships its sysusers.d INSIDE the sysext — applied at multi-user, AFTER
# systemd-sysusers already ran at sysinit — and the merged /etc confext is read-only, so the polkitd
# user can never be created at runtime. Bake it into the sealed base /etc now (same reason as
# shrek/dev/swamp). uid/gid 701 sits in Shrek's reserved low-custom range (shrek=700), clear of the
# Debian system-user block. Also pre-create /etc/polkit-1/rules.d (root:polkitd 0750, exactly what
# polkit's tmpfiles.d would make) since that dir lives under the read-only /etc — same pattern as the
# /etc/bluetooth pre-create below. polkit's /usr bits (actions/*.policy, the D-Bus own-name policy) ride
# the sysext merge; only its /etc footprint needs baking here.
grep -q '^polkitd:' "$BUILDROOT/etc/group" \
    || echo 'polkitd:x:701:' >> "$BUILDROOT/etc/group"
grep -q '^polkitd:' "$BUILDROOT/etc/passwd" || {
    echo 'polkitd:x:701:701:User for polkitd:/:/usr/sbin/nologin' >> "$BUILDROOT/etc/passwd"
    echo 'polkitd:!*:20000:0:99999:7:::' >> "$BUILDROOT/etc/shadow"
}
install -d -o 0 -g 0   -m 0755 "$BUILDROOT/etc/polkit-1"
install -d -o 0 -g 701 -m 0750 "$BUILDROOT/etc/polkit-1/rules.d"
echo "postinst: polkitd user -> $(grep '^polkitd:' "$BUILDROOT/etc/passwd") / rules.d $(ls -ldn "$BUILDROOT/etc/polkit-1/rules.d" | awk '{print $1, $3":"$4}')"

# Sprint S2 (network): the DMS network center manages NetworkManager over its polkit-gated D-Bus API.
# For the ACTIVE seat0 user NM already defaults allow_active=yes for list/toggle/scan/connect
# (network-control, enable-disable-{network,wifi}, wifi.scan, settings.modify.own). The ONE gap is
# settings.modify.system (save/edit a SYSTEM connection, e.g. persisting a Wi-Fi password), which NM
# ships as auth_admin_keep — an admin prompt the sealed single-user session has no graphical polkit
# agent to answer, so the save silently fails and the connection never lands in the /home keyfile store.
# Grant that one action to the ACTIVE, LOCAL session with a baked rule (polkitd reads /etc/polkit-1/rules.d
# AND /usr/share/polkit-1/rules.d at startup; /etc is read-only at runtime so it must be baked now, same
# reason as the rules.d dir above). 49- sorts before any 50-default so its explicit YES wins. Inert on a
# bare base boot (no polkitd); it only takes effect once the desktop layer's polkit.service starts.
cat > "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-nm.rules" <<'NMRULE'
// Shrek OS — Sprint S2 (Network). Let the active, local seat0 session save/edit
// system NetworkManager connections without an admin agent. NM's other network-center
// actions (network-control, enable-disable-{network,wifi}, wifi.scan, settings.modify.own)
// already default allow_active=yes; only settings.modify.system needs this grant so
// Wi-Fi credentials persist into the /home-backed keyfile store.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.NetworkManager.settings.modify.system" &&
        subject.active && subject.local) {
        return polkit.Result.YES;
    }
});
NMRULE
chown 0:0 "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-nm.rules"
chmod 0644 "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-nm.rules"
echo "postinst: NM polkit rule -> $(ls -ln "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-nm.rules" | awk '{print $1, $3":"$4}')"

# Sprint S4 (storage): the DMS file manager mounts attached disks through udisks2's polkit-gated D-Bus API.
# Removable-media actions (filesystem-mount, eject-media, power-off-drive, encrypted-unlock) already default
# allow_active=yes, but a NON-removable disk (any internal disk, and a virtio disk in the VM) is classed as
# a "system" device whose *-system actions default auth_admin_keep — the same admin prompt the sealed
# single-user session has no graphical polkit agent to answer, so mounting it from the file manager would
# silently fail. Grant the *-system disk-management actions to the ACTIVE, LOCAL session (baked into
# read-only /etc, same as the NM rule). The -other-user/-other-seat variants stay denied — meaningless on a
# single-user, single-seat sealed desktop. Inert on a bare base boot (no polkitd until the desktop layer).
cat > "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-udisks.rules" <<'UDRULE'
// Shrek OS — Sprint S4 (Storage). Let the active, local seat0 session mount / unlock /
// eject / power-off SYSTEM disks (internal, and virtio disks in the VM) without an admin
// agent. Removable-media variants already default allow_active=yes; only the *-system
// actions need this grant so attaching a disk and opening it in the file manager works.
polkit.addRule(function(action, subject) {
    if (subject.active && subject.local &&
        (action.id == "org.freedesktop.udisks2.filesystem-mount-system" ||
         action.id == "org.freedesktop.udisks2.encrypted-unlock-system" ||
         action.id == "org.freedesktop.udisks2.eject-media-system" ||
         action.id == "org.freedesktop.udisks2.power-off-drive-system")) {
        return polkit.Result.YES;
    }
});
UDRULE
chown 0:0 "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-udisks.rules"
chmod 0644 "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-udisks.rules"
echo "postinst: udisks polkit rule -> $(ls -ln "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-udisks.rules" | awk '{print $1, $3":"$4}')"

# Sprint S6 (brightness): brightnessctl backs the DMS brightness keys. It writes /sys/class/backlight, whose
# node its packaged udev rule chgrp's to the `video` group — so the dev user must be IN video for the keys to
# work on real hardware. (brightnessctl also has a logind fallback, but group membership is the robust,
# driver-independent path.) No backlight node exists in the VM, so this is inert there; it matters on the Mac
# panel. Add dev to video idempotently, editing only the buildroot's group file.
GRPF="$BUILDROOT/etc/group"
if grep -q '^video:' "$GRPF"; then
    awk -F: 'BEGIN{OFS=":"} /^video:/{ has=0; n=split($4,m,","); for(i=1;i<=n;i++) if(m[i]=="dev") has=1;
             if(!has) $4=($4==""?"dev":$4",dev") } {print}' "$GRPF" > "$GRPF.tmp" && mv "$GRPF.tmp" "$GRPF"
else
    echo 'video:x:44:dev' >> "$GRPF"
fi
echo "postinst: dev -> video group -> $(grep '^video:' "$GRPF")"

# Sprint S6 (power-profiles): the DMS bar's power-profile widget switches the active profile through
# power-profiles-daemon, whose switch-profile / hold-profile polkit actions default auth_admin_keep — the
# same admin prompt the sealed single-user session has no graphical agent to answer. Grant the whole
# org.freedesktop.UPower.PowerProfiles.* action group to the ACTIVE, LOCAL seat0 session (baked into
# read-only /etc, same shape as the S1/S2/S4 rules). Prefix-match keeps it correct across ppd versions that
# rename individual actions. Inert on a bare base boot (no polkitd until the desktop layer).
cat > "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-ppd.rules" <<'PPDRULE'
// Shrek OS — Sprint S6 (Brightness + power-profiles). Let the active, local seat0 session
// switch / hold the system power profile (Performance / Balanced / Power Saver) without an
// admin agent. power-profiles-daemon defaults these actions to auth_admin_keep.
polkit.addRule(function(action, subject) {
    if (subject.active && subject.local &&
        action.id.indexOf("org.freedesktop.UPower.PowerProfiles.") == 0) {
        return polkit.Result.YES;
    }
});
PPDRULE
chown 0:0 "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-ppd.rules"
chmod 0644 "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-ppd.rules"
echo "postinst: ppd polkit rule -> $(ls -ln "$BUILDROOT/etc/polkit-1/rules.d/49-shrek-ppd.rules" | awk '{print $1, $3":"$4}')"

# Dogfood-0 (M1) LOGIN-RACE FIX: normalize the shadow files to the Debian-canonical DAC shape.
# mkosi/sysusers creates /etc/shadow + /etc/gshadow as mode 000 root:root — readable only via
# CAP_DAC_OVERRIDE. That interacts fatally with the Onion /etc confext merge: overlayfs re-checks
# every lower-inode access with the MOUNTER's credentials, and the merge is performed by gatekeeperd
# (CapabilityBoundingSet=CAP_SYS_ADMIN — deliberately NO CAP_DAC_OVERRIDE), so on any boot where the
# shrek-conf confext merges, mode-000 /etc/shadow becomes unreadable by EVERYONE, even full-caps root.
# login's pam_unix acct_mgmt then gets getspnam()==NULL -> PAM_AUTHINFO_UNAVAIL (silent) -> pam_deny
# -> the intermittent tty1 "Authentication failure" (green boots were logins that won the race against
# the merge). 0640 root:shadow (gid 42) is the stock Debian shape: root reads via the OWNER bit and
# unix_chkpwd via the shadow GROUP bit — no capability needed on either side of the overlay, so the
# account phase is merge-order-independent. gatekeeperd's bounding set stays untouched.
for f in shadow gshadow shadow- gshadow-; do
    [ -f "$BUILDROOT/etc/$f" ] || continue
    chown 0:42 "$BUILDROOT/etc/$f"      # root:shadow (gid 42 baked in /etc/group)
    chmod 0640 "$BUILDROOT/etc/$f"
done
echo "postinst: shadow files normalized -> $(ls -ln "$BUILDROOT/etc/shadow" | awk '{print $1, $3":"$4}')"

# Dogfood-0 (M1): the desktop sysext carries Debian's bluez package, whose packaged
# bluetooth.service has ConfigurationDirectory=bluetooth and ConfigurationDirectoryMode=0555.
# Runtime /etc is sealed read-only, so the directory must already exist with the exact mode;
# otherwise systemd fails the service at CONFIGURATION_DIRECTORY before bluetoothd execs.
install -d -o 0 -g 0 -m 0555 "$BUILDROOT/etc/bluetooth"
[ -f "$BUILDROOT/etc/bluetooth/main.conf" ] && chown 0:0 "$BUILDROOT/etc/bluetooth/main.conf"
[ -f "$BUILDROOT/etc/bluetooth/main.conf" ] && chmod 0644 "$BUILDROOT/etc/bluetooth/main.conf"
echo "postinst: bluetooth config dir -> $(ls -ldn "$BUILDROOT/etc/bluetooth" | awk '{print $1, $3":"$4}')"

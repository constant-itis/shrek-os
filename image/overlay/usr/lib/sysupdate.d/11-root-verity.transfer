# Shrek OS Phase-1 — S7: sysupdate transfer for the root VERITY (hash) partition (A/B).
# Adapted from particleos mkosi.sysupdate/11-usr-verity.transfer, retargeted usr→root. Installs the
# new version's hash tree into the inactive verity slot, paired with the data transfer (10-root).
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://shrekos-updates.iambu.dev/stable/
# zstd-compressed like the data split (see 10-root.transfer); MatchPattern includes the .zst suffix.
MatchPattern=%M_@v_%a.root-%a-verity.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v_verity
MatchPartitionType=root-verity
PartitionFlags=0
ReadOnly=1

# Dogfood-0 (M1) — persistent /home on the separate writable shrek-data disk.
#
# The sealed root stays read-only dm-verity and /var stays a volatile tmpfs (systemd.volatile=state,
# 25-writable-var.conf) — the ONLY durable state is /home, which lives on a dedicated writable virtio
# disk (out/shrek-data.raw, ext4 label `shrek-data`, created once by scripts/dogfood-data-disk.sh and
# attached writable+persistent by the daily libvirt domain and the acceptance oracle). This realizes the
# deferred "sealed /usr + writable /home" model without making root writable.
#
# The unit FILE is baked into the sealed image, but is only ENABLED when build-in-container.sh stages
# local-fs.target.wants/home.mount for a DOGFOOD or INSTALLABLE image. It has no [Install] section, so
# systemd presets cannot accidentally enable it. The systemd unit name MUST be `home.mount` to match
# Where=/home.
[Unit]
Description=Persistent /home on the shrek-data data disk (Dogfood-0 M1)
Documentation=file:///usr/share/doc/shrek/dogfood-0.md
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target local-fs.target

[Mount]
What=/dev/disk/by-label/shrek-data
Where=/home
Type=ext4
Options=nosuid,nodev,x-systemd.device-timeout=10s

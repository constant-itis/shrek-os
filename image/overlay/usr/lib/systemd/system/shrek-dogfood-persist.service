# Dogfood-0 (M1) — persistence + services acceptance probe (DOGFOOD oracle scaffolding).
#
# ENABLED only on DOGFOOD=1 builds (build-in-container.sh stages the multi-user.target.wants symlink,
# gitignored, removed on a normal build) because the probe REBOOTS the guest to prove /home persistence.
# The unit file ships in the sealed image but is inert unless that symlink exists — a CI/shipped image
# never runs it. Verdict is mirrored to the serial console for scripts/dogfood-vm.sh. Spike scaffolding:
# strip before ship with the other gate units.
[Unit]
Description=Shrek Dogfood-0 M1 persistence + services acceptance probe
Documentation=file:///usr/share/doc/shrek/dogfood-0.md
# Need /home mounted (persistence check) and the standard services started (functional report). These
# ordering deps are ignored if a unit is absent (bluetooth ships in the desktop layer).
After=home.mount NetworkManager.service systemd-resolved.service bluetooth.service local-fs.target
Wants=home.mount
ConditionPathExists=/dev/dri/card0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/shrek/dogfood-persist-probe
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target

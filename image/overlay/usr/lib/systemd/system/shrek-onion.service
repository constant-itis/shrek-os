# shrek-onion — Phase 4 (slice 2): oniond runs UNPRIVILEGED and only PROPOSES the sealed layer set to
# the gatekeeperd broker over the root-owned socket; the broker (the only privileged component) mounts
# the store, independently re-checks the sealed policy, and performs the merge. oniond holds no mount
# privilege — it cannot merge on its own (proven by its startup privilege probe). If the broker is
# unreachable oniond fails CLOSED (no layers merge) but exits 0 so the OS still boots.
# docs/phase4-gatekeeperd.md.
[Unit]
Description=Shrek Onion — oniond proposes the sealed layer set to the gatekeeperd broker
Documentation=file:///usr/share/doc/shrek/phase4-gatekeeperd.md
# Ordered after the broker so the store is mounted + socket bound; oniond also connect-retries to
# close the Type=simple readiness gap. Wants (not Requires) — a broker outage must not block boot.
After=gatekeeperd.service
Wants=gatekeeperd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The policy brain runs as the unprivileged control-plane user — the whole point of the slice.
User=shrek
ExecStart=/usr/libexec/shrek/oniond merge
# Operator query surface reads the broker's audit record back to the console (O4 proof).
ExecStartPost=/usr/libexec/shrek/shrekctl onion status
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target

# shrek-ai-model.service — the on-box inference server of the optional AI layer (ADR-006 §3, Mode A).
# Serves a small quantized model (3-4B Q4 GGUF, M1) on 127.0.0.1 ONLY. docs/adr-006-slice2-state-model.md.
#
# LAZY-START, NOT boot-enabled: there is deliberately NO [Install]/WantedBy. A resident multi-GB RSS on
# modest hardware is a real cost (ADR-006 §3), so the model is started ON DEMAND — the `shrek ai` front-door
# (slice 5) issues `systemctl start shrek-ai-model.service` on the first model-needing turn — not at boot,
# and NOT via a LISTEN_FDS socket unit (the inference server has no native socket activation — Fable's
# pipewire-precedent correction). IDLE-UNLOAD is the launcher's contract: it self-exits after an idle
# window; Restart=no keeps it down until the next on-demand start. Net effect = lazy-start + idle-unload
# without socket activation.
#
# Base-baked + Condition-gated (slice-1 discipline): in the boot transaction at sysinit, but structurally
# dormant unless the AI Onion merged AND shipped the launcher. GGUF readiness is a START-time gate, not a
# Condition, so an on-demand start that finds no verified model FAILS WITH A LOGGED REASON (the verify
# helper's exit codes) rather than skipping silently.
[Unit]
Description=Shrek AI — on-box inference server on 127.0.0.1 (small Q4 GGUF, ADR-006 Mode A)
Documentation=file:///usr/share/doc/shrek/adr-006-optional-ai-layer.md
After=shrek-onion.service shrek-ai-store.service home.mount
Wants=shrek-ai-store.service
# Structural dormancy: the Onion merged AND carried the inference launcher. Either absent ⇒ clean skip.
ConditionPathExists=/usr/lib/shrek/layers/ai
ConditionPathExists=/usr/lib/shrek/ai/shrek-ai-model

[Service]
# No ambient authority (ADR-006 §7: the AI layer never holds its own credential authority). A STATIC,
# authority-less system user (shrek-ai, uid 702, nologin/no-home/locked, baked in image/mkosi.postinst) —
# NOT DynamicUser=yes. WHY static (slice-6 ACL fix): DynamicUser makes systemd manage per-uid POSIX ACLs on
# the paths the transient user touches, and that ACL landed on the persistent /home mount root with
# OTHER=--- — silently stripping the `dev` user's traverse of /home and killing shrek-ai-mycelium (runs as
# dev, brain under /home/dev). A static uid reading the world-readable GGUF (0644 under 0755 parents) needs
# NO ACL, so systemd never touches /home. It cannot reach dev's home/.ssh/config.json: InaccessiblePaths=
# below over-mounts /home/dev away, and it holds no authority (nologin, no home) — the §7 posture.
User=shrek-ai
Group=shrek-ai
Type=simple
# Model-as-data gate: refuse to start unless a delivered GGUF matches the sealed baked digest (exit 0).
# A non-zero pre (no model configured / not delivered / digest mismatch) keeps the server down, logged.
ExecStartPre=/usr/lib/shrek/ai/shrek-ai-model-verify
# --host 127.0.0.1 is the load-bearing invariant (ADR-006 §7: every AI-layer listener binds loopback only).
# The launcher's remaining contract (port, GGUF path under /home/.shrek/ai/model, idle-unload window) is
# finalized with the inference-runtime substrate; it defaults the model dir to the shrek-ai-store landing.
ExecStart=/usr/lib/shrek/ai/shrek-ai-model --host 127.0.0.1
# Idle-unload is the launcher's job (it exits when idle); do NOT auto-restart, so it stays unloaded until
# the next on-demand start. Generous start timeout — loading a multi-GB GGUF off /home is slow.
Restart=no
TimeoutStartSec=180
# Zero-egress, enforced by the kernel not just the bind (ADR-006 §7 "egress stays zero with AI on"): the
# service may talk to loopback ONLY. Combined with the 127.0.0.1 bind and ADR-003's veth input-drop (which
# stops benches reaching the localhost model port), an unauthenticated localhost model server is acceptable.
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# §7 dev-home isolation WITHOUT poisoning /home (slice-6 final): earlier this used ProtectHome=tmpfs + a
# BindReadOnlyPaths back to /home/.shrek/ai/model. That combination is what poisoned /home — to bridge the
# bind source through the tmpfs mask systemd writes a POSIX ACL onto the real /home (OTHER=---), which locks
# the dev user (hence shrek-ai-mycelium) out of /home/dev while the model runs. Instead: the static shrek-ai
# user reads the world-readable model landing DIRECTLY (/home is 0755, GGUF 0644 — no bind, so systemd never
# touches /home's ACL), and dev's private home is hidden by a plain over-mount. InaccessiblePaths= is a mount,
# not an ACL op — it hides /home/dev (dev's ~, ~/.ssh, config.json — the §7 targets) with zero /home ACL churn.
# ProtectSystem=strict keeps all of /home read-only, so the model can only READ the landing, never write /home.
InaccessiblePaths=-/home/dev
# ProtectSystem=strict makes /run read-only; the launcher writes+reads its idle-unload activity marker under
# /run/shrek-ai (a missing marker makes the watchdog read age=huge and self-kill the server immediately).
# RuntimeDirectory gives the service its own writable /run/shrek-ai (0755, removed on stop).
RuntimeDirectory=shrek-ai
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

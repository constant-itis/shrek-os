#!/bin/sh
# Phase-2 — the merge + diagnostics helper behind shrek-onion.service (docs/phase2-onion.md).
# Merges the signed sysext/confext layers from the mounted store under a FIXED trusted image policy,
# and reports each step's outcome to the console. It never hard-fails the boot: a bad/again-refused
# layer is a normal, survivable condition (oniond will make it a policy decision in Phase 4), so the
# system must still reach login — the verdict is observed, not fatal.
POLICY='root=signed+absent:usr=signed+absent'

echo "shrek-onion: /var/lib/extensions ->"; ls -l /var/lib/extensions 2>&1
echo "shrek-onion: /var/lib/confexts   ->"; ls -l /var/lib/confexts 2>&1

echo "shrek-onion: merging sysext (policy=$POLICY)"
systemd-sysext  --image-policy="$POLICY" merge; echo "shrek-onion: sysext merge rc=$?"
echo "shrek-onion: merging confext (policy=$POLICY)"
systemd-confext --image-policy="$POLICY" merge; echo "shrek-onion: confext merge rc=$?"

systemd-sysext status 2>&1

if test -x /usr/bin/shrek-hello; then
    echo "shrek-onion: sysext MERGED — $(/usr/bin/shrek-hello)"
else
    echo "shrek-onion: sysext REFUSED (shrek-hello absent)"
fi
if test -f /etc/shrek-layer.conf; then
    echo "shrek-onion: confext MERGED — $(cat /etc/shrek-layer.conf)"
else
    echo "shrek-onion: confext ABSENT"
fi
exit 0

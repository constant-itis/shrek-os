#!/bin/sh
# Dogfood-0 (M1) — persistence + standard-services acceptance probe (DOGFOOD oracle scaffolding).
#
# Driven by shrek-dogfood-persist.service, which is ENABLED only on DOGFOOD=1 builds (it REBOOTS the
# guest — never wanted in a CI/shipped image). It proves the M1 acceptance to scripts/dogfood-vm.sh
# over the serial console (console=ttyS0), which greps these SHREK-DOGFOOD lines:
#
#   boot after key-enrollment (bootcount 0 -> 1): /home is a fresh ext4, so write a marker under
#     /home, fsync, and reboot — this is the reboot the acceptance requires.
#   next boot (bootcount 1 -> 2): the marker SURVIVED the reboot on the persistent shrek-data disk =>
#     emit PERSIST-OK and report that the standard desktop services returned functional, then stay up
#     so the oracle can screenshot the live desktop.
#
# If /home were NOT persistent the counter would never exceed 1 and the guest would reboot-loop; the
# oracle's wall-clock budget bounds that into a clean "no PERSIST-OK" FAILURE rather than a hang.
set -eu
MARK=/home/.shrek-dogfood
CNT="$MARK/bootcount"
say() { echo "SHREK-DOGFOOD $*"; }   # unit StandardOutput=journal+console -> ttyS0 -> oracle serial log

mkdir -p "$MARK"
n=0; [ -f "$CNT" ] && n=$(cat "$CNT" 2>/dev/null || echo 0)
n=$((n + 1)); echo "$n" > "$CNT"; sync

if [ "$n" -eq 1 ]; then
    printf 'boot1 marker written by dogfood-persist-probe\n' > "$MARK/marker"; sync
    say "MARKER-WRITTEN boot=$n path=$MARK/marker — rebooting to prove /home persistence"
    systemctl --no-block reboot
    exit 0
fi

# n >= 2: the marker survived a reboot on the shrek-data disk.
if [ -f "$MARK/marker" ]; then
    say "PERSIST-OK boot=$n marker-present=yes contents=[$(head -1 "$MARK/marker" 2>/dev/null)]"
else
    say "PERSIST-FAIL boot=$n marker-present=no — /home did NOT survive the reboot"
fi

# Wait for the dev user session (tty1 autologin → pam_systemd starts the user@1000 manager). `systemctl
# --user` talks to that manager via XDG_RUNTIME_DIR and does NOT need the session bus, so gate only on
# the manager being active — not on /run/user/1000/bus.
RT=/run/user/1000
# Wait up to 120s for dev's per-user manager to come active; progress lines timestamp the wait on the
# serial log.
i=0
while [ "$i" -lt 120 ]; do
    [ "$(systemctl is-active user@1000.service 2>/dev/null)" = active ] && break
    [ $(( i % 30 )) -eq 0 ] && say "user-session-wait t=${i}s user@1000=$(systemctl is-active user@1000.service 2>/dev/null || echo unknown)"
    sleep 1; i=$((i + 1))
done
say "user-session: user@1000=$(systemctl is-active user@1000.service 2>/dev/null || echo unknown) after ${i}s loginctl=[$(loginctl list-sessions --no-legend 2>&1 | tr '\n' '|')]"
say "user-runtime dir=[$(ls -1 "$RT" 2>&1 | tr '\n' ' ')] bus=$([ -S "$RT/bus" ] && echo present || echo absent)"

# Bluetooth: bluez's bluetooth.service is ConditionPathIsDirectory=/sys/class/bluetooth. The VM may have
# no Bluetooth controller, but bluetoothd runs correctly with an empty controller set once the kernel
# Bluetooth core exposes the class directory. Do not invent a fake adapter; zero controllers is a valid
# dogfood VM state. As of the HW-enablement batch (#2909) bluez is in the BASE image and bluetooth.service
# is BASE-enabled (multi-user.target.wants) — so it is loadable and STARTED at boot with NO daemon-reload
# and NO manual `systemctl start` here. Dropping that manual kick is deliberate: it makes the report below
# reflect TRUE boot-time enablement (the actual fix) instead of masking it. We still modprobe the BT core
# so the adapterless VM exposes a valid /sys/class/bluetooth, then poll the boot-started unit until settled.
modprobe bluetooth 2>/dev/null || true
j=0; while [ "$j" -lt 5 ]; do [ -d /sys/class/bluetooth ] && break; sleep 1; j=$((j + 1)); done
# Type=dbus (BusName=org.bluez): briefly `activating` until bluetoothd claims the bus name. Poll the
# BOOT-started unit until it settles to active (no adapter is needed for the daemon to run).
b=0; while [ "$b" -lt 20 ]; do [ "$(systemctl is-active bluetooth.service 2>/dev/null)" = active ] && break; sleep 1; b=$((b + 1)); done
say "bluetooth hci=[$(ls /sys/class/bluetooth 2>/dev/null | tr '\n' ' ')] settled-after=${b}s"

# HW-enablement batch (#2909): also report the new base services. systemd-timesyncd should be active
# (network is up); mbpfan is applesmc-condition-guarded, so on the adapterless/non-Apple VM it stays
# INACTIVE (condition-skipped, NOT failed — that is the universal-image guard working; it would be active
# on a real Mac); upower is D-Bus-activated (present, may be inactive until a client calls it).
for u in NetworkManager systemd-resolved bluetooth dbus-broker systemd-timesyncd mbpfan upower; do
    say "SVC system $u=$(systemctl is-active "$u" 2>/dev/null || echo unknown)"
done
say "SVC system user@1000.service=$(systemctl is-active user@1000.service 2>/dev/null || echo unknown)"

# User-session services (audio + portals): query dev's per-user manager directly (XDG_RUNTIME_DIR is
# sufficient; no session bus needed for systemctl --user). pipewire is socket-activated, so start it +
# wireplumber + the portal so the report shows capability, not a lazily-dead socket.
asdev() { runuser -u dev -- env XDG_RUNTIME_DIR="$RT" "$@"; }
say "SVC user failed=[$(asdev systemctl --user --failed --no-legend 2>&1 | tr '\n' '|')]"
asdev systemctl --user start pipewire.service wireplumber.service xdg-desktop-portal.service >/dev/null 2>&1 || true
for u in dbus.socket pipewire wireplumber xdg-desktop-portal; do
    say "SVC user $u=$(asdev systemctl --user is-active "$u" 2>/dev/null || echo unknown)"
done

# --- Dogfood-0 M2: user CLI on PATH (base) + toolchain sysext merged (shrek-dev) ------------------------
# `shrek` ships in the sealed base on /usr/bin (the owner hit `shrek: command not found`); rustc/cargo
# arrive only via the shrek-dev Onion sysext merge. Prove the CLI resolves and the toolchain can actually
# COMPILE (a dep-free crate, offline) — not merely that the binaries are present.
say "M2 shrek=$(command -v shrek 2>/dev/null || echo MISSING)"
if shrek --help >/dev/null 2>&1; then say "M2 shrek-help=ok"; else say "M2 shrek-help=FAIL"; fi
say "M2 rustc=$(rustc --version 2>/dev/null || echo MISSING)"
say "M2 cargo=$(cargo --version 2>/dev/null || echo MISSING)"
SM=$(mktemp -d 2>/dev/null || echo /tmp/m2smoke)
mkdir -p "$SM/src"
printf 'fn main(){println!("shrek-m2-ok");}\n' > "$SM/src/main.rs"
printf '[package]\nname="m2smoke"\nversion="0.0.0"\nedition="2021"\n\n[[bin]]\nname="m2smoke"\npath="src/main.rs"\n' > "$SM/Cargo.toml"
if ( cd "$SM" && CARGO_HOME="$SM/.cargo" cargo build --offline --quiet 2>/dev/null \
       && [ "$("$SM/target/debug/m2smoke" 2>/dev/null)" = "shrek-m2-ok" ] ); then
    say "M2 cargo-build=ok"
else
    say "M2 cargo-build=FAIL"
fi
rm -rf "$SM" 2>/dev/null || true

# --- Dogfood-0 M3: a REAL gatekeeperd T2 session appears LIVE in the Work drawer (ACCEPTANCE) ----------
# gatekeeperd constructs a genuine T2 gVisor session and writes the shrek-session/1 record (root:swamp
# 0640) which the dev-session SessionProvider (dev is in `swamp`) reads → a live row in the Work drawer.
# We drive the SAME engine path the sealed mount-plane-gate proves: `gatekeeperd sandbox --trust
# T-untrust` under `systemd-run --scope -p Delegate=yes` (cgroup delegation for runsc). NOTE: the `shrek
# run` FRONT DOOR cannot construct T2 in this endpoint-free sealed VM by design — it re-derives the band
# from an integrity anchor (the runsc harness fs-verity, unmeasurable on RO dm-verity /usr, OR a sealed
# entrypoint, which /bin/sh is not) and fail-highs to T-hostile. The engine call is gatekeeperd's own
# authorized explicit-trust path; DMS-BOOT-0 keeps the session-record lifecycle proof but no longer gates
# on the old Quickshell-shell Work drawer reading that record.
GK=/usr/libexec/shrek/gatekeeperd
SRV=/run/shrek-m3/srv
rm -rf /run/shrek-m3 2>/dev/null || true
mkdir -p "$SRV/m3"
printf 'int main(void){return 0;}\n' > "$SRV/m3/hello.c"
# native-workload proof: run the sandbox's own tcc on the granted source, then hold long enough for the
# live-record probe to catch it. `;` (not &&) so the hold+DONE run regardless of tcc.
M3WL='/usr/bin/tcc -c /srv/m3/hello.c -o /tmp/hello.o && echo M3-COMPILED || echo M3-COMPILE-FAIL; /bin/busybox sleep 16; echo M3-WORK-DONE'
# wait for the dev quickshell log if present; this is a legacy marker under DMS, not an acceptance gate.
QSLOG=; k=0
while [ "$k" -lt 30 ]; do
    QSLOG=$(ls /run/user/1000/quickshell/by-id/*/log.qslog 2>/dev/null | head -1)
    [ -n "$QSLOG" ] && break; sleep 1; k=$((k + 1))
done
say "M3 quickshell-log=[${QSLOG:-absent}] after ${k}s"
# real T2 construct in the background (systemd-run --scope for the delegated cgroup runsc needs)
( systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T2 --trust T-untrust \
    --caps C-ro-nosec --profile C-ro-nosec --id m3 --anchor "$SRV" --grant m3 \
    -- /bin/sh -c "$M3WL" > /run/m3-run.log 2>&1; echo "$?" > /run/m3-run.rc ) &
M3PID=$!
# poll for the live session record during the workload's hold window
rec=; tier=; sub=; i=0
while [ "$i" -lt 25 ]; do
    f=$(ls /run/shrek/session/*.json 2>/dev/null | head -1)
    if [ -n "$f" ]; then rec="$f"; tier=$(grep -oE '"tier"[^,]*' "$f" 2>/dev/null | head -1); break; fi
    sleep 1; i=$((i + 1))
done
say "M3 session-record=[${rec:-absent}] found-after=${i}s ${tier:-}"
[ -n "$rec" ] && say "M3 record-perms=[$(stat -c '%U:%G %a' "$rec" 2>/dev/null)]"
# nudge the legacy Quickshell shell if present; DMS ignores this path and the VM parser treats it optional.
runuser -u dev -- env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 \
    /usr/bin/quickshell ipc call work toggle >/dev/null 2>&1 || true
# give any legacy SessionProvider poll time to read the record + log the marker
sleep 5
if [ -n "$QSLOG" ] && grep -qa 'SHREK-DESKTOP work session' "$QSLOG" 2>/dev/null; then
    say "M3 drawer-marker=yes [$(grep -a 'SHREK-DESKTOP work session' "$QSLOG" | tail -1 | sed 's/.*SHREK-DESKTOP //')]"
else
    say "M3 drawer-marker=no"
fi
# wait for the workload to finish + teardown, then confirm the record was removed
w=0; while kill -0 "$M3PID" 2>/dev/null && [ "$w" -lt 40 ]; do sleep 1; w=$((w + 1)); done
wait "$M3PID" 2>/dev/null || true
say "M3 workload=[done=$(grep -ac M3-WORK-DONE /run/m3-run.log 2>/dev/null || echo 0) compiled=$(grep -ac M3-COMPILED /run/m3-run.log 2>/dev/null || echo 0)] rc=$(cat /run/m3-run.rc 2>/dev/null || echo '?')"
after=$(ls /run/shrek/session/*.json 2>/dev/null | head -1)
say "M3 record-after-teardown=[${after:-absent}]"

# --- Dogfood-0 M4: host/human VM networking works; no-egress sandbox still cannot reach Internet ------
# The interactive libvirt dogfood VM has an ordinary NAT virtio NIC so a human desktop can use
# NetworkManager DHCP. Workload egress remains controlled by gatekeeperd profiles; a sandbox without an
# egress grant must still be offline even while the host desktop reaches DNS/HTTPS/GitHub.
route=; i=0
while [ "$i" -lt 90 ]; do
    route=$(ip -4 route show default 2>/dev/null | head -1)
    [ -n "$route" ] && break
    [ $(( i % 30 )) -eq 0 ] && say "M4 network-wait t=${i}s nm-state=[$(nmcli -t -f STATE general 2>/dev/null || echo nmcli-missing)]"
    sleep 1; i=$((i + 1))
done

if [ -z "$route" ]; then
    say "M4 SKIP no-default-route nm-state=[$(nmcli -t -f STATE general 2>/dev/null || echo nmcli-missing)]"
else
    say "M4 default-route=[$route] after=${i}s nm-state=[$(nmcli -t -f STATE general 2>/dev/null || echo nmcli-missing)]"
    if getent ahostsv4 github.com >/run/m4-dns.out 2>/run/m4-dns.err; then
        say "M4 dns=ok github.com=[$(head -1 /run/m4-dns.out | awk '{print $1}')]"
    else
        say "M4 dns=FAIL err=[$(tr '\n' '|' < /run/m4-dns.err 2>/dev/null)]"
    fi
    if command -v git >/dev/null 2>&1; then
        if runuser -u dev -- env HOME=/home/dev git ls-remote https://github.com/github/gitignore.git HEAD >/run/m4-git.out 2>/run/m4-git.err; then
            say "M4 github-https=ok head=[$(awk '{print $1}' /run/m4-git.out | head -1)]"
        else
            say "M4 github-https=FAIL err=[$(tr '\n' '|' < /run/m4-git.err 2>/dev/null | tail -c 240)]"
        fi
    else
        say "M4 github-https=FAIL git=MISSING"
    fi

    M4SRV=/run/shrek-m4/srv
    rm -rf /run/shrek-m4 2>/dev/null || true
    mkdir -p "$M4SRV/project"
    printf 'm4 no-egress probe\n' > "$M4SRV/project/marker"
    M4WL='PATH=/bin:/usr/bin; export PATH; command -v nc >/dev/null 2>&1 && echo M4-SANDBOX-NC-OK || echo M4-SANDBOX-NC-MISSING; if timeout 5 nc -w 2 1.1.1.1 53 </dev/null >/dev/null 2>&1; then echo M4-SANDBOX-EGRESS-LEAK; else echo M4-SANDBOX-NO-EGRESS-OK; fi'
    if systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T2 --trust T-untrust \
        --caps C-ro-nosec --profile C-ro-nosec --id m4nonet --anchor "$M4SRV" --grant project \
        -- /bin/sh -c "$M4WL" >/run/m4-sandbox.out 2>/run/m4-sandbox.err; then
        if grep -q M4-SANDBOX-NC-OK /run/m4-sandbox.out 2>/dev/null \
            && grep -q M4-SANDBOX-NO-EGRESS-OK /run/m4-sandbox.out 2>/dev/null; then
            say "M4 sandbox-no-egress=ok"
        else
            say "M4 sandbox-no-egress=FAIL output=[$(tr '\n' '|' < /run/m4-sandbox.out 2>/dev/null)]"
        fi
    else
        say "M4 sandbox-no-egress=FAIL gatekeeper=[$(tr '\n' '|' < /run/m4-sandbox.err 2>/dev/null | tail -c 240)]"
    fi
fi

# --- Sprint S1: polkit power path (the shutdown/reboot/suspend buttons the owner reported dead) --------
# DMS's power buttons call logind (org.freedesktop.login1.Manager.PowerOff/Reboot/Suspend); logind
# delegates the yes/no to polkit. The sealed base shipped NO polkitd; adding it to the desktop layer is
# necessary but not sufficient, because (a) polkit.service runs User=polkitd and a layer's sysusers.d is
# applied too late / behind a read-only /etc — so the polkitd user is baked into the base /etc instead
# (image/mkosi.postinst); and (b) polkit.service is a LAYER unit that merges after systemd/dbus have
# already read their config, and the merge issues no reload — so shrek-desktop-polkit.service reloads +
# starts it post-merge. Prove the whole chain here: the user exists, the unit is active/owns the bus
# name, and polkit GRANTS power-off/reboot/suspend to the REAL active seat0 session. The grant is queried
# with `pkcheck --process <seat0-active-session-leader>` — that leader is inside dev's graphical seat0
# session, so polkit evaluates allow_active (a runuser'd caller would NOT be session-tracked and would
# falsely read "no"); full pid,starttime,uid triple so pkcheck can't reject a bare pid. `timeout` guards
# a hang and every step is fenced with || so a failure can't kill the probe (set -eu). Non-destructive:
# pkcheck only asks, it never powers off. login1 .policy defaults allow_active=yes => no graphical agent.
say "S1 polkitd-user=[$(getent passwd polkitd 2>/dev/null || echo MISSING)]"
say "S1 polkit-unit load=[$(systemctl show -p LoadState --value polkit.service 2>/dev/null || echo unknown)] active=[$(systemctl is-active polkit.service 2>/dev/null || echo unknown)]"
say "S1 polkit-busname=[$(busctl --system status org.freedesktop.PolicyKit1 >/dev/null 2>&1 && echo owned || echo unowned)]"
AS=$(loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null || true)
LEAD=$(loginctl show-session "$AS" -p Leader --value 2>/dev/null || true)
say "S1 seat0-active-session=[${AS:-none}] leader=[${LEAD:-none}] state=[$(loginctl show-session "$AS" -p Active -p Seat --value 2>/dev/null | tr '\n' ' ')]"
if [ -n "$LEAD" ] && [ -r "/proc/$LEAD/stat" ]; then
    STT=$(sed 's/.*) //' "/proc/$LEAD/stat" 2>/dev/null | awk '{print $20}' || echo 0)   # starttime = field 22 overall (20 after ") ")
    LUID=$(stat -c %u "/proc/$LEAD" 2>/dev/null || echo 1000)
    for act in power-off reboot suspend; do
        rc=0; timeout 15 pkcheck --action-id "org.freedesktop.login1.$act" --process "$LEAD,$STT,$LUID" >/dev/null 2>&1 || rc=$?
        [ "$rc" -eq 0 ] && say "S1 authz $act=yes" || say "S1 authz $act=no(rc=$rc)"
    done
else
    say "S1 authz power-off=no(no-active-seat0-session-leader)"
fi

# --- Sprint S2: Network (NetworkManager) — the DMS network center can manage + persist connections ----
# NM is a BASE daemon (already reported active above), so unlike polkit it needs no post-merge activation.
# The sealed-image gaps for a WORKING network center are (a) AUTHORIZATION and (b) PERSISTENCE:
#   (a) NM defaults allow_active=yes for list/toggle/scan/connect, but SAVING a system connection
#       (settings.modify.system) defaults auth_admin_keep — a prompt the sealed session has no graphical
#       polkit agent to answer. The baked rule /etc/polkit-1/rules.d/49-shrek-nm.rules grants it to the
#       active+local session. Prove it with pkcheck against the SAME seat0 active-session leader S1 used
#       ($LEAD/$STT/$LUID from the S1 block; a runuser'd caller is not session-tracked and would read no).
#   (b) /etc is read-only, so NM's keyfile store is redirected to /home (20-shrek-persistent-keyfile.conf).
#       Prove NM's effective keyfile path is the /home one AND that adding a system connection actually
#       writes a keyfile there. The `nmcli add` runs as root (bypasses polkit — the active-user authz is
#       proven separately by the pkcheck above); this isolates the persistence path from the authz path.
say "S2 nm-keyfile-path=[$(NetworkManager --print-config 2>/dev/null | sed -n '/^\[keyfile\]/,/^\[/p' | sed -n 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*//p' | head -1)]"
if [ -n "$LEAD" ] && [ -r "/proc/$LEAD/stat" ]; then
    rc=0; timeout 15 pkcheck --action-id org.freedesktop.NetworkManager.settings.modify.system --process "$LEAD,$STT,$LUID" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] && say "S2 authz modify-system=yes" || say "S2 authz modify-system=no(rc=$rc)"
else
    say "S2 authz modify-system=no(no-active-seat0-session-leader)"
fi
PSTORE=/home/.shrek-system/NetworkManager/system-connections
nmcli connection delete shrek-s2-probe >/dev/null 2>&1 || true   # clean any prior run's leftover
addout=$(nmcli connection add type ethernet ifname '*' con-name shrek-s2-probe 2>&1) || true
if [ -f "$PSTORE/shrek-s2-probe.nmconnection" ]; then
    say "S2 conn-persist=ok path=[$PSTORE/shrek-s2-probe.nmconnection]"
else
    say "S2 conn-persist=FAIL store=[$(ls "$PSTORE" 2>&1 | tr '\n' ' ')] add=[$(echo "$addout" | tr '\n' ' ' | tail -c 160)]"
fi
nmcli connection delete shrek-s2-probe >/dev/null 2>&1 || true

# --- Sprint S4: Storage / mounts (udisks2) — attach a disk, mount it via the file-manager path, read it -
# udisks2 is a BASE daemon (D-Bus activated, runs as root) so it needs no post-merge activation. The
# sealed-image gap is the same shape as S2: a NON-removable disk (the attached virtio disk, like any
# internal disk) is a "system" device whose filesystem-mount-system defaults auth_admin_keep — unanswerable
# in a sealed session with no graphical polkit agent. The baked rule 49-shrek-udisks.rules grants the
# active+local session that action; prove it with pkcheck against the seat0 leader ($LEAD/$STT/$LUID from
# S1). Then prove the capability end-to-end: mount the attached SHREKUSB disk through udisks and read the
# marker seeded into it (attach -> mount -> open). The mount runs as root (bypasses polkit — the active-user
# authz is proven separately by the pkcheck), isolating the daemon/device capability from the authz path.
say "S4 udisks-unit active=[$(systemctl is-active udisks2.service 2>/dev/null || echo unknown)]"
udisksctl status >/dev/null 2>&1 || true   # dbus-activate udisksd so it claims its bus name
say "S4 udisks-busname=[$(busctl --system status org.freedesktop.UDisks2 >/dev/null 2>&1 && echo owned || echo unowned)]"
if [ -n "$LEAD" ] && [ -r "/proc/$LEAD/stat" ]; then
    rc=0; timeout 15 pkcheck --action-id org.freedesktop.udisks2.filesystem-mount-system --process "$LEAD,$STT,$LUID" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] && say "S4 authz mount-system=yes" || say "S4 authz mount-system=no(rc=$rc)"
else
    say "S4 authz mount-system=no(no-active-seat0-session-leader)"
fi
USBDEV=$(readlink -f /dev/disk/by-label/SHREKUSB 2>/dev/null || true)
if [ -n "$USBDEV" ]; then
    mout=$(udisksctl mount -b "$USBDEV" 2>&1) || true
    mp=$(printf '%s' "$mout" | sed -n 's/^Mounted .* at \(.*\)$/\1/p' | tr -d '.' | head -1)
    [ -z "$mp" ] && mp=$(findmnt -n -o TARGET "$USBDEV" 2>/dev/null | head -1)
    if [ -n "$mp" ] && [ -f "$mp/shrek-usb-marker" ]; then
        say "S4 mount-open=ok dev=[$USBDEV] at=[$mp] marker=[$(head -1 "$mp/shrek-usb-marker")]"
    else
        say "S4 mount-open=FAIL dev=[$USBDEV] mp=[${mp:-none}] out=[$(printf '%s' "$mout" | tr '\n' ' ' | tail -c 140)]"
    fi
    udisksctl unmount -b "$USBDEV" >/dev/null 2>&1 || true
else
    say "S4 mount-open=FAIL no-SHREKUSB-disk blk=[$(lsblk -no NAME,LABEL 2>/dev/null | tr '\n' '|')]"
fi

# --- Sprint S6: Brightness + power-profiles — the DMS brightness keys + bar power-profile widget ----------
# Both are HARDWARE features that no-op in the VM (no /sys/class/backlight node, no cpufreq/platform_profile
# driver), so the oracle proves what is hardware-INDEPENDENT: the sealed-image PACKAGING + AUTHORIZATION that
# make them work on the real Mac panel. brightnessctl drives XF86MonBrightness* (sway.config) and writes the
# backlight node via its `video`-group udev rule, so dev must be IN video. power-profiles-daemon backs the DMS
# PowerProfileWatcher; switching the profile is polkit-gated (switch-profile defaults auth_admin_keep) — the
# baked rule 49-shrek-ppd.rules grants the active seat0 session, proven with pkcheck against the SAME leader
# S1 used. The live profile-switch / brightness-set are the no-op-in-VM part: the profile list is INFO only,
# never failed on absent hardware (empty in the VM is expected).
say "S6 brightnessctl-present=[$(command -v brightnessctl >/dev/null 2>&1 && echo yes || echo MISSING)]"
say "S6 dev-in-video-grp=[$(id -nG dev 2>/dev/null | tr ' ' '\n' | grep -qx video && echo yes || echo no)]"
say "S6 ppd-present=[$(command -v powerprofilesctl >/dev/null 2>&1 && echo yes || echo MISSING)]"
if [ -n "$LEAD" ] && [ -r "/proc/$LEAD/stat" ]; then
    rc=0; timeout 15 pkcheck --action-id org.freedesktop.UPower.PowerProfiles.switch-profile --process "$LEAD,$STT,$LUID" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] && say "S6 authz switch-profile=yes" || say "S6 authz switch-profile=no(rc=$rc)"
else
    say "S6 authz switch-profile=no(no-active-seat0-session-leader)"
fi
s6prof=$(powerprofilesctl list 2>&1 | sed -n 's/^[* ]*\([a-z][a-z-]*\):.*/\1/p' | tr '\n' ',' || true)
say "S6 ppd-profiles=[${s6prof:-none(vm-no-cpufreq-driver)}]"

# --- Sprint S3: Lock + idle — the DMS lock screen authenticates the dev user via PAM -------------------
# DMS's lock screen (ext-session-lock-v1 via Quickshell) authenticates dev through PAM. With
# SettingsData.lockPamExternallyManaged=true (seeded in the DMS defaults) it uses the STOCK /etc/pam.d/login
# service (pam_unix -> /etc/shadow) and never tries to write a pam config to the read-only /etc. The knot:
# dev must have an UNLOCKED password hash (S3 dropped the `!` prefix baked in image/mkosi.postinst) or
# pam_unix refuses every unlock. Prove the real auth path headlessly (not the GUI): quickshell links libpam;
# /etc/pam.d/login exists; pamtester authenticates dev+correct password AND rejects a wrong one. Idle->lock
# + lock-on-suspend are DMS-internal (IdleService/ext-idle-notify + lockBeforeSuspend), config-enabled via
# the seeded settings and manual lock via loginctl lock-session (loginctlLockIntegration).
say "S3 quickshell-pam=[$(ldd /usr/bin/quickshell 2>/dev/null | grep -qi libpam && echo linked || echo MISSING)]"
say "S3 pam-login-service=[$([ -f /etc/pam.d/login ] && echo present || echo MISSING)]"
rc=0; printf 'shrek\n' | timeout 15 pamtester login dev authenticate >/dev/null 2>&1 || rc=$?
[ "$rc" -eq 0 ] && say "S3 pam-auth-correct=ok" || say "S3 pam-auth-correct=FAIL(rc=$rc)"
rc=0; printf 'not-the-password\n' | timeout 15 pamtester login dev authenticate >/dev/null 2>&1 || rc=$?
[ "$rc" -ne 0 ] && say "S3 pam-auth-wrong-rejected=ok" || say "S3 pam-auth-wrong-rejected=FAIL(accepted-bad-pw)"
DSET=/usr/share/shrek/dms/default-settings.json
if grep -q '"lockPamExternallyManaged": *true' "$DSET" 2>/dev/null; then
    say "S3 lock-settings=[externally-managed acLockTimeout=$(grep -oE '"acLockTimeout": *[0-9]+' "$DSET" | grep -oE '[0-9]+') lockBeforeSuspend=$(grep -oE '"lockBeforeSuspend": *(true|false)' "$DSET" | grep -oE '(true|false)')]"
else
    say "S3 lock-settings=[MISSING in $DSET]"
fi

# --- Sprint S5: Dynamic theming (matugen) — the vendored binary is present, runs under the image's glibc,
# and turns the wallpaper into a Material palette. matugen has no Debian package, so the pinned upstream
# release binary is staged into /usr/bin (see third_party/matugen). DMS drives it via `dms matugen queue`
# only when the theme is `dynamic` (the seeded default); it is glibc-dynamic but trixie's glibc 2.41
# satisfies its GLIBC_2.39 need and its libc/libm/libgcc_s deps ride in the base. Prove headlessly:
# binary present+executable, `--version` runs (the dynamic link resolves in-image), and it extracts a
# palette from the shipped wallpaper (the wallpaper->palette loop). The full recolor is visual — screenshot.
MATUGEN=/usr/bin/matugen
say "S5 matugen-binary=[$([ -x "$MATUGEN" ] && echo present || echo MISSING)]"
rc=0; mver=$("$MATUGEN" --version 2>&1) || rc=$?
[ "$rc" -eq 0 ] && say "S5 matugen-runs=[ok $mver]" || say "S5 matugen-runs=FAIL(rc=$rc out=[$(printf '%s' "$mver" | tr '\n' ' ' | tail -c 120)])"
S5_WP=$(ls /usr/share/shrek/desktop/wallpaper.* 2>/dev/null | head -1)
if [ -n "$S5_WP" ]; then
    rc=0; s5pal=$(HOME=/tmp "$MATUGEN" image "$S5_WP" --type scheme-tonal-spot --prefer saturation --json hex --dry-run 2>&1) || rc=$?
    if [ "$rc" -eq 0 ] && printf '%s' "$s5pal" | grep -q '#'; then
        say "S5 matugen-palette=ok wallpaper=[$S5_WP] colors=[$(printf '%s' "$s5pal" | grep -oE '#[0-9a-fA-F]{6}' | head -3 | tr '\n' ' ')]"
    else
        say "S5 matugen-palette=FAIL wallpaper=[$S5_WP] rc=$rc out=[$(printf '%s' "$s5pal" | tr '\n' ' ' | tail -c 140)]"
    fi
else
    say "S5 matugen-palette=FAIL no-wallpaper"
fi
if grep -q '"currentThemeName": *"dynamic"' "$DSET" 2>/dev/null && grep -q '"runUserMatugenTemplates": *true' "$DSET" 2>/dev/null; then
    say "S5 theme-settings=[dynamic runUserMatugenTemplates=true scheme=$(grep -oE '"matugenScheme": *"[^"]+"' "$DSET" | grep -oE '[^"]+"$' | tr -d '"')]"
else
    say "S5 theme-settings=[MISSING dynamic-default in $DSET]"
fi

# --- Sprint S5 (foot sub-task): the terminal follows the dynamic palette ------------------------------
# matugen has no ANSI-16, so a user template (/usr/share/shrek/matugen/{config.toml,templates/
# foot-colors.ini}) maps Material roles -> foot [colors], writing ~/.local/state/shrek/foot-colors.ini
# that foot.ini pulls in via `include=`. DMS's own foot template is DISABLED (it emits [colors-dark],
# which trixie's foot 1.21 rejects). shrek-foot-osc retints open windows live. Prove headlessly:
# the wiring files are present, DMS's foot template is off, and — the money check — matugen renders the
# template from the real wallpaper into a file that `foot --check-config` ACCEPTS (template valid against
# this matugen + foot). Run under a throwaway HOME so the probe never dirties /root.
grep -q '^include=~/.local/state/shrek/foot-colors.ini' /usr/share/shrek/xdg/foot/foot.ini 2>/dev/null \
    && say "S5foot include-wired=yes" || say "S5foot include-wired=FAIL"
[ -x /usr/bin/shrek-foot-osc ] && say "S5foot osc-helper=present" || say "S5foot osc-helper=MISSING"
if [ -r /usr/share/shrek/matugen/config.toml ] && [ -r /usr/share/shrek/matugen/templates/foot-colors.ini ] && [ -r /usr/share/shrek/matugen/foot-colors.default.ini ]; then
    say "S5foot wiring-files=present"
else
    say "S5foot wiring-files=MISSING"
fi
grep -q '"matugenTemplateFoot": *false' "$DSET" 2>/dev/null \
    && say "S5foot dms-foot-template=disabled" || say "S5foot dms-foot-template=FAIL(still-on)"
S5F_HOME=$(mktemp -d 2>/dev/null || echo /tmp/s5foot)
mkdir -p "$S5F_HOME" 2>/dev/null || true
S5F_WP=$(ls /usr/share/shrek/desktop/wallpaper.* 2>/dev/null | head -1)
if [ -n "$S5F_WP" ] && [ -x /usr/bin/matugen ] && [ -x /usr/bin/foot ]; then
    rc=0; HOME="$S5F_HOME" /usr/bin/matugen image "$S5F_WP" --type scheme-tonal-spot --prefer saturation \
        --config /usr/share/shrek/matugen/config.toml >/dev/null 2>&1 || rc=$?
    S5F_OUT="$S5F_HOME/.local/state/shrek/foot-colors.ini"
    if [ "$rc" -eq 0 ] && [ -s "$S5F_OUT" ]; then
        # Check the REAL shipped foot.ini (its `include=` resolves to $HOME/.local/state/shrek/
        # foot-colors.ini, which matugen just wrote) — NOT a synthetic one. This is what catches an
        # include placed in the wrong section (foot rejects `include` inside [colors]).
        rc=0; HOME="$S5F_HOME" LC_ALL=C.UTF-8 /usr/bin/foot --check-config -c /usr/share/shrek/xdg/foot/foot.ini >/dev/null 2>&1 || rc=$?
        [ "$rc" -eq 0 ] \
            && say "S5foot render+check=ok colors=[$(grep -oE '^(background|foreground|regular2)=[0-9a-fA-F]{6}' "$S5F_OUT" | tr '\n' ' ')]" \
            || say "S5foot render+check=FAIL(shipped foot.ini rejected rc=$rc)"
    else
        say "S5foot render+check=FAIL(matugen rc=$rc out=[$(ls -l "$S5F_OUT" 2>&1 | tail -c 80)])"
    fi
else
    say "S5foot render+check=FAIL(missing wallpaper/matugen/foot)"
fi

# --- Sprint S5 (foot sub-task): config-merge safety + REAL dms worker ---------------------------------
# The render+check above runs matugen --config DIRECTLY, which parses config.toml as proper TOML and
# IGNORES comments — so it did NOT catch the bug that shipped: DMS's `dms matugen queue` does NOT parse
# the file, it SLICES it with a naive substring search for the literal tokens [config] and [templates]
# (core buildMergedConfig -> extractTOMLSection). A bracketed section token inside a COMMENT makes the
# splitter capture comment text as the config section; matugen then dies with "invalid table header"
# and BOTH shell and foot theming break silently ("Theme worker failed"). Two guards below.
#
# (1) Cheap deterministic guard: no comment line in config.toml may contain a bracketed section token.
if grep -nE '^[[:space:]]*#' /usr/share/shrek/matugen/config.toml 2>/dev/null | grep -qE '\[(config|templates)'; then
    say "S5foot config-merge-safe=FAIL(bracketed [config]/[templates] token in a comment breaks the dms substring merge)"
else
    say "S5foot config-merge-safe=ok"
fi
# (2) Money check: run the REAL `dms matugen generate` (same merge path as the runtime `queue`) so a
# broken merge is caught end-to-end. dms refuses to run as root, so drop to the 'dev' user under a
# throwaway HOME. Assert BOTH outputs: shell palette (dms-colors.json) AND foot recolored off the seed.
S5W_HOME=$(mktemp -d 2>/dev/null || echo /tmp/s5worker)
if [ -x /usr/bin/dms ] && [ -n "$S5F_WP" ] && id dev >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1 \
   && [ -f /usr/share/quickshell/dms/shell.qml ]; then
    cat > "$S5W_HOME/run.sh" <<S5WEOF
H="$S5W_HOME"; export HOME="\$H"
mkdir -p "\$H/.config/matugen" "\$H/.cache/DankMaterialShell" "\$H/.local/state/shrek"
cp /usr/share/shrek/matugen/config.toml "\$H/.config/matugen/config.toml"
cp /usr/share/shrek/matugen/foot-colors.default.ini "\$H/.local/state/shrek/foot-colors.ini"
/usr/bin/dms matugen generate --state-dir "\$H/.cache/DankMaterialShell" \
    --shell-dir /usr/share/quickshell/dms --config-dir "\$H/.config" \
    --kind image --value "$S5F_WP" --mode dark --matugen-type scheme-tonal-spot >/dev/null 2>&1
S5WEOF
    chown -R dev:dev "$S5W_HOME" 2>/dev/null
    runuser -u dev -- sh "$S5W_HOME/run.sh" 2>/dev/null
    S5W_SHELL="$S5W_HOME/.cache/DankMaterialShell/dms-colors.json"
    S5W_FOOT="$S5W_HOME/.local/state/shrek/foot-colors.ini"
    if [ -s "$S5W_SHELL" ] && [ -s "$S5W_FOOT" ] && ! grep -q '^background=101014' "$S5W_FOOT"; then
        say "S5foot dms-worker=ok shell-palette=yes foot-recolored=[$(grep -m1 '^background=' "$S5W_FOOT")]"
    else
        say "S5foot dms-worker=FAIL(shell=[$(ls -l "$S5W_SHELL" 2>&1 | tail -c 40)] foot-bg=[$(grep -m1 '^background=' "$S5W_FOOT" 2>/dev/null)])"
    fi
else
    say "S5foot dms-worker=SKIP(no dms/dev/runuser/shell.qml/wallpaper)"
fi
rm -rf "$S5W_HOME" 2>/dev/null

# --- Sprint S5 (wallpaper set sub-task): give the DMS wallpaper switcher a gallery to browse ----------
# A small first-party set is staged as JPG in /usr/share/shrek/wallpapers (JPG: the sealed image has no
# Qt webp plugin, and JPG adds no extra image decoder). The DMS switcher is pointed at it via
# wallpaperCyclingFolderPath in the default session. Prove headlessly: the gallery has a real set of
# files that are all valid JPEG (magic FF D8 FF — od is in the base; foot/matugen only decode what the
# base can), and the switcher folder is seeded. The picker UI itself is visual, out of scope here.
WPDIR=/usr/share/shrek/wallpapers
if [ -d "$WPDIR" ]; then
    wpn=0; wpbad=0
    for f in "$WPDIR"/*.jpg; do
        [ -f "$f" ] || continue
        wpn=$((wpn + 1))
        sig=$(od -An -tx1 -N3 "$f" 2>/dev/null | tr -d ' \n\r')
        [ "$sig" = "ffd8ff" ] || wpbad=$((wpbad + 1))
    done
    if [ "$wpn" -ge 10 ] && [ "$wpbad" -eq 0 ]; then
        say "S5wall gallery=ok count=$wpn all-jpeg=yes"
    else
        say "S5wall gallery=FAIL count=$wpn non-jpeg=$wpbad"
    fi
else
    say "S5wall gallery=FAIL no-dir"
fi
grep -q '"wallpaperCyclingFolderPath": *"/usr/share/shrek/wallpapers"' /usr/share/shrek/dms/default-session.json 2>/dev/null \
    && say "S5wall picker-folder=seeded" || say "S5wall picker-folder=FAIL"

# --- Agent-launch L4/L5 (docs/agent-launch.md): the shrek-agent dispatcher + set-default helper. --------
# The sealed VM is endpoint-free, so we do NOT run a model round-trip here (that's the host-side coder
# oracle, slice-3 §5). We prove the STRUCTURE: the dispatcher exists, its L4->L0 provider map emits the
# expected sealed egress names, it fail-closes on an unknown id, and the L5 default round-trips. The
# authoritative "every emitted egress is a sealed L0 profile" check runs host-side at de-risk time.
if [ -x /usr/bin/shrek-agent ] && [ -x /usr/bin/shrek-default-agent ]; then
    say "Sagent binaries=present"
else
    say "Sagent binaries=FAIL agent=[$(ls -l /usr/bin/shrek-agent 2>&1 | tail -c 60)] def=[$(ls -l /usr/bin/shrek-default-agent 2>&1 | tail -c 60)]"
fi
# L4 map: each id -> its sealed profile (must match crates/shrek-policy EGRESS_PROFILES verbatim).
amap="$(shrek-agent --list 2>/dev/null | awk '{print $1"="$4}' | tr '\n' ' ')"
if [ "$amap" = "local=model-local anthropic=model-anthropic claude=model-claude-cli codex=model-codex-cli " ]; then
    say "Sagent map=ok [$amap]"
else
    say "Sagent map=FAIL [$amap]"
fi
# fail-closed: an unknown provider id must exit nonzero, never resolve to a backend.
if shrek-agent --print --provider bogus --project /w/p --task x >/dev/null 2>&1; then
    say "Sagent fail-closed=FAIL(unknown id accepted)"
else
    say "Sagent fail-closed=ok"
fi
# L5 round-trip (as user dev, own HOME): set default -> shrek-agent reads it back into the right profile.
ACFG="$(asdev sh -c 'echo "$HOME"')/.config/shrek/agent.json"
asdev rm -f "$ACFG" 2>/dev/null || true
asdev shrek-default-agent claude >/dev/null 2>&1 || true
ares="$(asdev shrek-agent --print --project /w/p --task noop 2>/dev/null)"
case "$ares" in
    *"--egress model-claude-cli -- coder --provider anthropic"*) say "Sagent set-default=ok" ;;
    *) say "Sagent set-default=FAIL [$ares]" ;;
esac
asdev rm -f "$ACFG" 2>/dev/null || true

# --- Agent-launch name-resolution layer (docs/agent-launch.md §7): shrek-connect hook-up + hosts seed. --
# Shrek ships with NO model wired; shrek-connect binds a sealed name -> an address on the writable /home
# store that /etc/hosts symlinks to. We prove: the tool exists; its provider->sealed-name map matches the
# L0 policy; the bind/list/forget round-trip writes a correct hosts line; shrek-agent fail-closes with a
# "hook one up" hint when the chosen provider is UNbound; and the real image wiring (the /etc/hosts
# symlink + the boot seed) is in place. A bound real launch is the host-side coder oracle's job (slice-3).
if [ -x /usr/bin/shrek-connect ]; then
    say "Sconnect binary=present"
else
    say "Sconnect binary=FAIL [$(ls -l /usr/bin/shrek-connect 2>&1 | tail -c 60)]"
fi
# provider -> sealed host name map (must match crates/shrek-policy egress hosts, 1:1 with the profiles).
cmap="$(shrek-connect --list 2>/dev/null | awk '{print $1"="$2}' | tr '\n' ' ')"
if [ "$cmap" = "local=shrek-model anthropic=shrek-model-proxy claude=shrek-claude-cli codex=shrek-codex-cli " ]; then
    say "Sconnect map=ok [$cmap]"
else
    say "Sconnect map=FAIL [$cmap]"
fi
# bind/list/forget round-trip against a private store (SHREK_HOSTS), as the dev user in its own HOME.
CHOSTS="$(asdev sh -c 'echo "$HOME"')/.cache/shrek-connect-test-hosts"
asdev sh -c "rm -f '$CHOSTS'; SHREK_HOSTS='$CHOSTS' shrek-connect local 127.0.0.1 >/dev/null 2>&1" || true
cbound="$(asdev sh -c "SHREK_HOSTS='$CHOSTS' shrek-connect --list 2>/dev/null" | awk '$1=="local"{print $3}')"
if [ "$cbound" = "127.0.0.1" ] && asdev sh -c "grep -qx '127.0.0.1 shrek-model' '$CHOSTS'"; then
    say "Sconnect bind=ok"
else
    say "Sconnect bind=FAIL [local=$cbound file=$(asdev sh -c "tr '\n' '|' < '$CHOSTS' 2>&1")]"
fi
# the unbound provider guard: with `local` bound but `claude` not, shrek-agent must fail-closed (exit 3)
# on --provider claude and emit the hook-up hint — never reach a launch. Capture is set -e-SAFE: the
# guard firing IS a non-zero exit (the feature working), so `|| arc=$?` catches it instead of killing
# this probe (a bare `aout=$(...)` assignment would propagate the 3 and abort the whole oneshot).
arc=0
aout="$(asdev sh -c "SHREK_HOSTS='$CHOSTS' shrek-agent --provider claude --project /w/p --task noop 2>&1")" || arc=$?
if [ "$arc" = 3 ] && printf '%s' "$aout" | grep -q "no brain connected for 'claude'"; then
    say "Sconnect unbound-guard=ok"
else
    say "Sconnect unbound-guard=FAIL [rc=$arc msg=$(printf '%s' "$aout" | tr '\n' '/')]"
fi
asdev sh -c "SHREK_HOSTS='$CHOSTS' shrek-connect --forget local >/dev/null 2>&1; rm -f '$CHOSTS'" || true
# real image wiring: /etc/hosts is the baked symlink and the boot seed ran (oneshot RemainAfterExit).
link="$(readlink /etc/hosts 2>/dev/null || true)"
if [ "$link" = "/home/.shrek-system/hosts" ] && grep -qx '127.0.0.1 localhost' /etc/hosts 2>/dev/null; then
    say "Sconnect etc-hosts-wired=ok"
else
    say "Sconnect etc-hosts-wired=FAIL [link=$link]"
fi
if systemctl is-active shrek-hosts-seed.service >/dev/null 2>&1; then
    say "Sconnect seed-service=active"
else
    say "Sconnect seed-service=FAIL [$(systemctl is-active shrek-hosts-seed.service 2>&1 | tr '\n' ' ')]"
fi

# --- Sprint S7: Weather tab — DISABLED (no shell egress) ----------------------------------------------
# Decision (owner, 2026-08-27): the DMS weather tab curls a third-party weather API on a timer — an
# undeclared, recurring phone-home from the SYSTEM shell, which Shrek's default-deny / named-egress model
# does not grant ad hoc. Rather than open a shell egress hole, the tab is seeded OFF in the DMS dashTabs
# (default-settings.json). A named-egress broker for the shell (reusable for Tailscale/VPN) is a separate
# future slice. Prove the seed disables it, so no weather egress is attempted by default.
if grep -Eq '"id"[[:space:]]*:[[:space:]]*"weather"[[:space:]]*,[[:space:]]*"enabled"[[:space:]]*:[[:space:]]*false' "$DSET" 2>/dev/null; then
    say "S7 weather-tab=disabled-in-seed"
else
    say "S7 weather-tab=FAIL [$(grep -o '"id": *"weather"[^}]*' "$DSET" 2>/dev/null | tr -d '\n')]"
fi

# --- ADR-003 Part 1: baseline-application MERGE proof on the REAL sealed boot ------------------------
# The shrek-browser (firefox-esr) + shrek-apps Onions merge onto the sealed /usr; assert the binaries,
# their .desktop entries, the real font set (emoji + CJK — the thin-font fix), and the promoted CLI utils
# are actually PRESENT on the merged /usr. This is the "does it LAND" half; whether firefox/GTK actually
# draw pixels is proven separately by scripts/apps-render-proof.sh (VM screendump lies about GTK, #2923).
# `set +e` so every check reports a SHREK-DOGFOOD line regardless of individual rc. Gated on presence so
# stores WITHOUT the Part-1 layers skip cleanly (no new FAIL on a pre-Part-1 dogfood run), same as Bench.
set +e
have() { command -v "$1" >/dev/null 2>&1; }
desk() { [ -f "/usr/share/applications/$1" ]; }
# BROWSER: firefox-esr as its own Onion (owner decision 2).
if have firefox-esr; then
    { have firefox-esr && desk firefox-esr.desktop; } && say "APPS browser=ok" \
      || say "APPS browser=FAIL bin=$(command -v firefox-esr 2>/dev/null||echo no) desktop=$([ -f /usr/share/applications/firefox-esr.desktop ]&&echo yes||echo no)"
else
    say "APPS browser=ABSENT (shrek-browser sysext not merged into /usr)"
fi
# APPS: the everyday baseline set. Gate the whole block on the file manager as the tell.
if have nautilus; then
    { have nautilus && desk org.gnome.Nautilus.desktop; } && say "APPS filemanager=ok" \
      || say "APPS filemanager=FAIL bin=$(command -v nautilus 2>/dev/null||echo no) desktop=$(ls /usr/share/applications/*[Nn]autilus*.desktop 2>/dev/null|head -1||echo no)"
    # viewers: image (loupe), PDF (papers), media (mpv) — bins present + a .desktop each.
    vfail=""
    for b in loupe papers mpv; do have "$b" || vfail="$vfail $b"; done
    ls /usr/share/applications/*[Ll]oupe*.desktop >/dev/null 2>&1 || ls /usr/share/applications/org.gnome.Loupe.desktop >/dev/null 2>&1 || vfail="$vfail loupe.desktop"
    [ -z "$vfail" ] && say "APPS viewers=ok" || say "APPS viewers=FAIL missing[$vfail]"
    # editor + archive manager (+ the backends file-roller shells out to for the common formats).
    have gnome-text-editor && say "APPS editor=ok" || say "APPS editor=FAIL"
    { have file-roller && have unzip && have zip && { have 7z || have 7za; } && have xz; } \
      && say "APPS archive=ok" || say "APPS archive=FAIL file-roller=$(have file-roller&&echo y||echo n) unzip=$(have unzip&&echo y||echo n) 7z=$({ have 7z||have 7za;}&&echo y||echo n) xz=$(have xz&&echo y||echo n)"
    # fonts — the thin-font fix: emoji kills tofu boxes, CJK gives coverage. Check the font FILES directly
    # (fontconfig may not be on this /usr); glob the noto trees for a color-emoji + a CJK face.
    EMOJI=$(find /usr/share/fonts -iname 'NotoColorEmoji*' 2>/dev/null | head -1)
    CJK=$(find /usr/share/fonts -iname '*NotoSansCJK*' -o -iname '*NotoSerifCJK*' -o -iname 'NotoSansCJK*' 2>/dev/null | head -1)
    { [ -n "$EMOJI" ] && [ -n "$CJK" ]; } && say "APPS fonts=ok emoji=[$(basename "$EMOJI" 2>/dev/null)] cjk=[$(basename "$CJK" 2>/dev/null)]" \
      || say "APPS fonts=FAIL emoji=[${EMOJI:-none}] cjk=[${CJK:-none}]"
    # everyday CLI utils promoted from the installer sysext onto the installed disk (fd installs as fdfind).
    cfail=""
    for b in curl wget git ssh jq rg fdfind less htop rsync; do have "$b" || cfail="$cfail $b"; done
    [ -z "$cfail" ] && say "APPS cli=ok" || say "APPS cli=FAIL missing[$cfail]"
else
    say "APPS filemanager=ABSENT (shrek-apps sysext not merged into /usr)"
fi
set -e

# --- Bench-0 (ADR-003 Part 2): rootless-container Bench runtime on the REAL sealed boot ---------------
# Fable's smallest-next-proof, phase B — the sealed userns/AppArmor posture a debian:trixie container
# cannot faithfully fake (bench0-prevalidate proved the mechanics; this proves them on the sealed image).
# The shrek-bench Onion (podman/crun/conmon/fuse-overlayfs/uidmap/catatonit) is merged; /etc/subuid+subgid
# are baked (mkosi.postinst); /usr/share/containers/*.conf point rootless graphroot at the /home pool.
# `set +e` for the whole block: every assertion must run and report a SHREK-DOGFOOD BENCH line regardless
# of individual rc (a bare failing cmd under set -e would abort before $? is captured — the #2815 trap).
set +e
BSEED=/usr/share/shrek/bench/seeds
BPOOL=/home/.shrek/benches
# Durable Bench records now live under the ROOT-owned /home/.shrek anchor, NOT inside the dev-owned 0700
# pool (mycelium #2982 hole 2). The BENCH-SEC block below proves dev cannot swap this dir.
BRECS=/home/.shrek/records
bdev() { runuser -u dev -- env HOME=/home/dev XDG_RUNTIME_DIR="$RT" PATH=/usr/bin:/bin "$@"; }
if command -v podman >/dev/null 2>&1; then
    # (i) sealed-boot unprivileged-userns posture (Fable assertion i; apparmor_restrict_unprivileged_userns
    #     is the one distro decision that would break it — assert live, don't trust the Debian default).
    if bdev unshare -U true 2>/dev/null; then say "BENCH userns=ok"; else say "BENCH userns=FAIL"; fi
    # bench pool = a noexec,nosuid,nodev bind sub-mount on the PERSISTENT, prjquota-armed shrek-data /home,
    # now stood up at boot by shrek-bench-pool.service (ADR-003 step 3, the PRODUCT mechanism — was a probe-
    # local loopback stopgap). Verify the service ran; keep a fallback so a service miss still exercises the
    # podman assertions, and NAME which path set it up (a real product signal, not silent self-healing).
    if mountpoint -q "$BPOOL" && findmnt -no OPTIONS "$BPOOL" 2>/dev/null | grep -q noexec; then
        say "BENCH pool-service=ok"
    else
        say "BENCH pool-service=FAIL fell-back"
        mkdir -p "$BPOOL"
        mount --bind "$BPOOL" "$BPOOL" 2>/dev/null && mount -o remount,bind,noexec,nosuid,nodev "$BPOOL" 2>/dev/null
        mkdir -p "$BPOOL/storage" "$BPOOL/tmp"; chown -R dev:dev "$BPOOL"
    fi
    say "BENCH pool=[$(findmnt -no OPTIONS "$BPOOL" 2>/dev/null || echo unmounted)]"
    # (SEC, mycelium #2982 hole 2) record-forgery is now STRUCTURALLY blocked: the durable records live at
    # $BRECS under the ROOT-owned /home/.shrek anchor, not inside the dev-owned 0700 $POOL. Prove dev owns
    # NEITHER the anchor nor its entries, so it can neither plant a forged records dir nor rename the real
    # one aside — the exact swap that would let a neutral `bench run` materialize ungranted grants/exports.
    SECPAR=/home/.shrek
    SECOWN=$(stat -c '%U:%G:%a' "$SECPAR" 2>/dev/null)
    [ "$SECOWN" = "root:root:755" ] && say "BENCH-SEC anchor-root-owned=ok [$SECOWN]" || say "BENCH-SEC anchor-root-owned=FAIL [$SECOWN]"
    # dev must NOT be able to create an entry in the anchor (plant a dir) nor rename the records dir aside.
    if runuser -u dev -- sh -c "mkdir '$SECPAR/evil' 2>/dev/null || mv '$BRECS' '$BRECS.evil' 2>/dev/null"; then
        say "BENCH-SEC forge-blocked=FAIL dev-mutated-anchor"
        rmdir "$SECPAR/evil" 2>/dev/null; [ -d "$BRECS.evil" ] && mv "$BRECS.evil" "$BRECS" 2>/dev/null
    else
        say "BENCH-SEC forge-blocked=ok"
    fi
    # (prjquota) rule 1 — prove a Bench can be DISK-CAPPED by project quota on the GROWABLE /home. Assign a
    # project id to a pool subdir, cap it at 1 MiB, and show a 4 MiB write is refused (EDQUOT). This is the
    # substrate bench_plane (step 4) caps each Bench with. Needs shrek-data mkfs -O quota,project +
    # home.mount `prjquota` + the `quota` tools (setquota/repquota) — the whole point of step 3.
    QDIR="$BPOOL/.qtest"; QPROJ=7777; rm -rf "$QDIR"; mkdir -p "$QDIR"; chown dev:dev "$QDIR"
    if chattr -p "$QPROJ" +P "$QDIR" 2>/tmp/bq.err && setquota -P "$QPROJ" 0 1024 0 0 /home 2>>/tmp/bq.err; then
        # Two load-bearing details (each cost a VM cycle to pin down):
        #  * write as NON-ROOT (`dev`): root is EXEMPT from quota enforcement (CAP_SYS_RESOURCE), so a
        #    root write sails past the cap while repquota shows it over-limit. A real Bench runs as `dev`.
        #  * conv=fsync: ext4 delayed allocation defers block allocation (and the quota check) to writeback,
        #    so a plain buffered write returns before EDQUOT can fire; fsync forces allocation during dd.
        # With both, a `dev` write crossing the 1 MiB hard cap fails EDQUOT (blocks at ~960 KiB).
        if runuser -u dev -- dd if=/dev/zero of="$QDIR/fill" bs=64k count=64 conv=fsync 2>/tmp/bq.dd; then QW=wrote-all; else QW=blocked; fi
        say "BENCH prjquota-write=$QW after=[$(repquota -P /home 2>/dev/null | awk -v p="#$QPROJ" '$1==p{print}' | tr -s ' ')] dd=[$(tr -d '\r' </tmp/bq.dd 2>/dev/null | tail -1)]"
        # PASS only if the block was EDQUOT ("Disk quota exceeded"), not an unrelated write error.
        if [ "$QW" = blocked ] && grep -qi "quota" /tmp/bq.dd 2>/dev/null; then say "BENCH prjquota=ok"; else say "BENCH prjquota=FAIL wrote-past-cap"; fi
    else
        say "BENCH prjquota=FAIL setup [$(tr -d '\r' </tmp/bq.err 2>/dev/null | tail -1)]"
    fi
    setquota -P "$QPROJ" 0 0 0 0 /home 2>/dev/null || true; rm -rf "$QDIR"
    # (ii) native rootless overlay + graphroot on the /home pool, driven by the BAKED system storage.conf.
    DRV=$(bdev podman info --format '{{.Store.GraphDriverName}}' 2>/dev/null); [ -n "$DRV" ] || DRV=ERR
    GR=$(bdev podman info --format '{{.Store.GraphRoot}}' 2>/dev/null); [ -n "$GR" ] || GR=ERR
    say "BENCH driver=$DRV graphroot=$GR"
    [ "$DRV" = overlay ] && say "BENCH overlay-native=ok" || say "BENCH overlay-native=FAIL"
    case "$GR" in "$BPOOL"*) say "BENCH graphroot-on-pool=ok";; *) say "BENCH graphroot-on-pool=FAIL";; esac
    # (iii) subuid mapped to the full 65536 range (setuid newuidmap survived the sysext merge).
    UMW=$(bdev podman unshare cat /proc/self/uid_map 2>/dev/null | awk '$3==65536{print 65536}' | head -1)
    [ "${UMW:-0}" = 65536 ] && say "BENCH uidmap=ok width=$UMW" || say "BENCH uidmap=FAIL width=${UMW:-none}"
    # ensure dev's session bus is up — podman's default (systemd) cgroup manager creates the container's
    # transient scope via the user D-Bus; the headless probe doesn't otherwise guarantee it (a real
    # graphical bench session always has it via dbus-user-session). Best-effort.
    bdev systemctl --user start dbus.socket >/dev/null 2>&1 || true
    # (iv) THE proof: load the REAL offline seed (alpine+coreutils+ffmpeg+exit42, step 6) + run the baked
    #      exit42 helper — a real compiled ELF that execs off the fresh overlay superblock on the noexec pool.
    bdev podman load -i "$BSEED/scratch.tar" >/dev/null 2>&1
    if bdev env DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus" podman run --rm --network=none --no-hosts --runtime crun localhost/scratch exit42 2>/tmp/brun.err; then BRC=0; else BRC=$?; fi
    if [ "$BRC" -ne 42 ]; then
        # fall back to the cgroupfs manager (no session-bus / systemd-scope dependency) — isolates a
        # cgroup-manager wiring failure from a genuine container-runtime failure. Whichever runs the ELF
        # off the noexec pool proves rule 2; the log names which path worked (a product cgroup-mgr signal).
        if bdev podman --cgroup-manager=cgroupfs run --rm --network=none --no-hosts --runtime crun localhost/scratch exit42 2>/tmp/brun2.err; then BRC2=0; else BRC2=$?; fi
        say "BENCH run-retry cgroupfs-rc=$BRC2 systemd-rc=$BRC systemd-err=[$(tr -d '\r' </tmp/brun.err 2>/dev/null | tail -2 | tr '\n' '|')]"
        [ "$BRC2" -eq 42 ] && BRC=42
    fi
    [ "$BRC" -eq 42 ] && say "BENCH run-exit42=ok rc=$BRC" || say "BENCH run-exit42=FAIL rc=$BRC err=[$(tr -d '\r' </tmp/brun2.err 2>/dev/null | tail -2 | tr '\n' '|')]"
    # (iv-b) the seed is a REAL media base, not a bare ELF — prove ffmpeg is present + runs (the step-8
    #        north-star substrate: an offline video convert in a Bench). Just -version here; a real transcode
    #        with granted in/out dirs is step 8's job.
    if bdev env DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus" podman run --rm --network=none --no-hosts --runtime crun localhost/scratch ffmpeg -hide_banner -version >/tmp/bff.log 2>&1; then
        say "BENCH seed-ffmpeg=ok [$(head -1 /tmp/bff.log | tr -d '\r')]"
    else say "BENCH seed-ffmpeg=FAIL [$(tr -d '\r' </tmp/bff.log 2>/dev/null | tail -1)]"; fi
    # (v) negative control: exec the SAME ELF directly from the noexec pool -> must be blocked (not 42/0).
    cp "$BSEED/exit42.elf" "$BPOOL/probe-exec" 2>/dev/null; chmod +x "$BPOOL/probe-exec" 2>/dev/null
    if "$BPOOL/probe-exec" >/dev/null 2>&1; then NRC=0; else NRC=$?; fi
    { [ "$NRC" -ne 42 ] && [ "$NRC" -ne 0 ]; } && say "BENCH noexec-negctl=ok rc=$NRC" || say "BENCH noexec-negctl=FAIL rc=$NRC"
    # (vi) informational: cgroup manager/version + dev-slice delegation (bench lands under user-1000.slice).
    say "BENCH cgroup mgr=$(bdev podman info --format '{{.Host.CgroupManager}}' 2>/dev/null) ver=$(bdev podman info --format '{{.Host.CgroupVersion}}' 2>/dev/null) delegate=$(systemctl show user@1000.service -p Delegate --value 2>/dev/null)"

    # --- Bench supervisor (ADR-003 Part 2 step 4): drive `gatekeeperd bench` END-TO-END on the real
    # sealed image — create (project quota) -> run the exit42 helper IN the bench via rootless podman ->
    # enforce the cap (non-root) -> destroy. Uses the /home defaults (pool + records + /home fs) and the
    # default seed name localhost/scratch (no SHREK_BENCH_SEED override — this exercises the product path).
    GKB=/usr/libexec/shrek/gatekeeperd
    if [ -x "$GKB" ]; then
        if "$GKB" bench create probe1 --quota 1024 >/tmp/bs.log 2>&1; then
            say "BENCH-SUP create=ok proj=$(sed -n 's/^project //p' "$BRECS/probe1" 2>/dev/null) rec=[$(tr '\n' ',' <"$BRECS/probe1" 2>/dev/null)]"
        else say "BENCH-SUP create=FAIL [$(tr -d '\r' </tmp/bs.log | tail -1)]"; fi
        # PROVE the product seed loader (bench_plane ensure_seed, step 6): drop the Bench-0 pre-loaded image
        # so the supervisor MUST re-load the offline seed from the sysext archive (/usr/.../scratch.tar,
        # digest-keyed) before it can run — the real vanilla-boot path where nothing pre-loaded the seed.
        bdev podman rmi -f localhost/scratch >/dev/null 2>&1
        # run the exit42 helper IN the bench via the supervisor (proves ensure_seed autoload + rootless run).
        "$GKB" bench run probe1 -- exit42 >/tmp/bs2.log 2>&1; BSRC=$?
        [ "$BSRC" -eq 42 ] && say "BENCH-SUP run-exit42=ok rc=$BSRC" || say "BENCH-SUP run-exit42=FAIL rc=$BSRC [$(tr -d '\r' </tmp/bs2.log | tail -2 | tr '\n' '|')]"
        bdev podman image exists localhost/scratch && say "BENCH-SUP seed-autoload=ok" || say "BENCH-SUP seed-autoload=FAIL (ensure_seed did not re-load the sysext archive)"
        # record state returns to stopped after the run.
        [ "$(sed -n 's/^state //p' "$BRECS/probe1" 2>/dev/null)" = stopped ] && say "BENCH-SUP state-stopped=ok" || say "BENCH-SUP state-stopped=FAIL"
        # the supervisor's project cap is EDQUOT-enforced for a non-root writer in the bench data dir.
        if su dev -s /bin/sh -c "dd if=/dev/zero of=$BPOOL/b/probe1/fill bs=64k count=64 conv=fsync" 2>/tmp/bs3.err; then BSQ=wrote-all; else BSQ=blocked; fi
        { [ "$BSQ" = blocked ] && grep -qi quota /tmp/bs3.err; } && say "BENCH-SUP quota-enforce=ok" || say "BENCH-SUP quota-enforce=FAIL [$(tr -d '\r' </tmp/bs3.err | tail -1)]"

        # --- Bench GRANTS (ADR-003 Part 2 step 5): route an FS grant through the Gatekeeper on the REAL
        # sealed mount ns + the real prjquota /home + the real /home/dev anchor. The live CONTAINER
        # round-trip (grant readable/writable inside podman) + LIVE egress inject are proven in the host
        # oracle (which has a writable seed + DNS); this endpoint-free sealed VM proves what only it can:
        # the grant materializes as a host-ns NOEXEC bind on the sealed image, the grants dir is
        # root:dev 0710 (redirect-safe, #2982 hole 3), it survives boot re-issuance, and the network verb
        # honors sealed egress policy.
        install -d -o dev -g dev /home/dev/g_out 2>/dev/null
        if "$GKB" bench grant probe1 /home/dev/g_out --rw >/tmp/bg.log 2>&1; then
            GD=/run/shrek/bench/probe1/grants/g_out
            GDIR=/run/shrek/bench/probe1/grants
            { findmnt -no OPTIONS "$GD" 2>/dev/null | grep -q noexec; } && say "BENCH-GRANT materialized-noexec=ok" || say "BENCH-GRANT materialized-noexec=FAIL [$(findmnt -no OPTIONS "$GD" 2>/dev/null)]"
            # (SEC, #2982 hole 3) the grants dir is root-owned (owner 0), dev GROUP for traverse, mode 0710
            # — dev owns neither it nor its parent <id>, so it cannot plant a symlink leaf nor rename the
            # dir to redirect the root bind onto a system target (e.g. /etc). Fable fix-1 kept via other ---.
            { [ "$(stat -c '%u %g %a' "$GDIR" 2>/dev/null)" = "0 $(id -g dev) 710" ]; } && say "BENCH-GRANT grantdir-root0710=ok" || say "BENCH-GRANT grantdir-root0710=FAIL [$(stat -c '%u %g %a' "$GDIR" 2>/dev/null)]"
            # the ACTUAL attack, proven blocked: as dev, planting a symlink leaf OR renaming the grants dir
            # must both fail (no write on grants nor on its root-owned parent <id>).
            if runuser -u dev -- sh -c "ln -s /etc '$GDIR/evil' 2>/dev/null || mv '$GDIR' '$GDIR.x' 2>/dev/null"; then
                say "BENCH-GRANT redirect-blocked=FAIL dev-wrote-grantdir"
                rm -f "$GDIR/evil" 2>/dev/null; [ -d "$GDIR.x" ] && mv "$GDIR.x" "$GDIR" 2>/dev/null
            else
                say "BENCH-GRANT redirect-blocked=ok"
            fi
            grep -q '^grant fs-rw /home/dev/g_out' "$BRECS/probe1" && say "BENCH-GRANT recorded=ok" || say "BENCH-GRANT recorded=FAIL"
            # boot re-issuance: drop the /run bind (as a reboot would) then `reissue` must re-materialize it.
            umount "$GD" 2>/dev/null; rm -rf /run/shrek/bench/probe1
            "$GKB" bench reissue >/tmp/bgr.log 2>&1
            { findmnt -no OPTIONS "$GD" 2>/dev/null | grep -q noexec; } && say "BENCH-GRANT reissue-rematerialize=ok" || say "BENCH-GRANT reissue-rematerialize=FAIL [$(tr -d '\r' </tmp/bgr.log | tail -1)]"
        else
            say "BENCH-GRANT grant=FAIL [$(tr -d '\r' </tmp/bg.log | tail -1)]"
        fi
        # network verb is default-deny: a sealed profile records, an unknown one is refused.
        "$GKB" bench network probe1 github-https >/dev/null 2>&1
        grep -q '^grant net github-https' "$BRECS/probe1" && say "BENCH-GRANT egress-recorded=ok" || say "BENCH-GRANT egress-recorded=FAIL"
        if "$GKB" bench network probe1 allow-all >/dev/null 2>&1; then say "BENCH-GRANT egress-deny-unknown=FAIL accepted"; else say "BENCH-GRANT egress-deny-unknown=ok"; fi

        # destroy removes the record + the data dir + the /run bench dir (identity + quota + grants gone).
        "$GKB" bench destroy probe1 >/dev/null 2>&1
        { [ ! -f "$BRECS/probe1" ] && [ ! -d "$BPOOL/b/probe1" ] && [ ! -d /run/shrek/bench/probe1 ]; } && say "BENCH-SUP destroy=ok" || say "BENCH-SUP destroy=FAIL"

        # --- Bench EXPORT (ADR-003 Part 2 step 7): the constrained .desktop launcher plane on the SEALED
        # image (env overrides compiled OUT here — the shipped build uses /home defaults). A FRESH bench
        # (no egress grant) so run-export takes the PLAIN run path — the networked late-attach is the host
        # oracle's job (the VM is endpoint-free). Export the baked exit42 seed helper as a launcher app:
        # a CONSTRAINED .desktop written AS DEV + a key->workload map in the root-owned record; run-export
        # resolves the key server-side + runs it (rc42); a forged key is refused; the wrapper is baked;
        # destroy sweeps the .desktop.
        DAPPS=/home/dev/.local/share/applications
        install -d -o dev -g dev /home/dev/.local /home/dev/.local/share "$DAPPS" 2>/dev/null
        DFILE="$DAPPS/shrek-bench-probe2-e42.desktop"
        [ -x /usr/bin/shrek-bench-run ] && say "BENCH-EXPORT wrapper-baked=ok" || say "BENCH-EXPORT wrapper-baked=FAIL (/usr/bin/shrek-bench-run absent)"
        "$GKB" bench create probe2 --quota 1024 >/tmp/bxc.log 2>&1
        if "$GKB" bench export probe2 e42 --label "Exit42 App" -- exit42 >/tmp/bx.log 2>&1; then
            { [ -f "$DFILE" ] && [ "$(stat -c %U "$DFILE" 2>/dev/null)" = dev ]; } && say "BENCH-EXPORT desktop-as-dev=ok" || say "BENCH-EXPORT desktop-as-dev=FAIL [$(stat -c '%U %a' "$DFILE" 2>/dev/null)]"
            grep -qx 'Exec=/usr/bin/shrek-bench-run probe2 e42' "$DFILE" 2>/dev/null && say "BENCH-EXPORT fixed-exec=ok" || say "BENCH-EXPORT fixed-exec=FAIL [$(grep '^Exec=' "$DFILE" 2>/dev/null)]"
            { grep -qiE '^(DBusActivatable|Actions|MimeType)=' "$DFILE" 2>/dev/null || grep '^Exec=' "$DFILE" 2>/dev/null | grep -qE '%[fFuUick]'; } && say "BENCH-EXPORT no-command=FAIL leaks-fieldcode-or-risky-directive" || say "BENCH-EXPORT no-command=ok"
            grep -q '^export e42 ' "$BRECS/probe2" && say "BENCH-EXPORT recorded=ok" || say "BENCH-EXPORT recorded=FAIL"
            # run-export resolves the registered key server-side and runs the exit42 helper in the bench (rc42).
            "$GKB" bench run-export probe2 e42 >/tmp/bx2.log 2>&1; XRC=$?
            [ "$XRC" -eq 42 ] && say "BENCH-EXPORT run-export=ok rc=$XRC" || say "BENCH-EXPORT run-export=FAIL rc=$XRC [$(tr -d '\r' </tmp/bx2.log | tail -1)]"
            # a forged / unregistered launcher key is REFUSED (the whole trust anchor: a .desktop carries only a key).
            if "$GKB" bench run-export probe2 forged >/dev/null 2>&1; then say "BENCH-EXPORT forged-key-refused=FAIL accepted"; else say "BENCH-EXPORT forged-key-refused=ok"; fi
        else
            say "BENCH-EXPORT export=FAIL [$(tr -d '\r' </tmp/bx.log | tail -1)]"
        fi
        # destroy sweeps the exported .desktop(s) with the bench.
        "$GKB" bench destroy probe2 >/dev/null 2>&1
        [ ! -f "$DFILE" ] && say "BENCH-EXPORT destroy-sweep=ok" || say "BENCH-EXPORT destroy-sweep=FAIL (.desktop survived destroy)"

        # --- Bench MEDIA north-star (ADR-003 Part 2 step 8): the whole point of the interaction model — an
        # OFFLINE video transcode INSIDE a Bench with the REAL shipped seed's ffmpeg, host sealed, granted
        # ONLY the input (ro) + dest (rw) dirs, output round-tripping to the host, and `destroy` removing the
        # bench's tooling + mutable state while the delivered output PERSISTS. This is the endpoint-free VM's
        # to prove: the pure offline path on the actual sealed image + baked seed (no build, no network).
        install -d -o dev -g dev /home/dev/m_in /home/dev/m_out 2>/dev/null
        # fabricate a real input video offline with the shipped seed's ffmpeg (testsrc -> mpeg4), owned by dev.
        bdev podman load -i "$BSEED/scratch.tar" >/dev/null 2>&1
        bdev env DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus" podman run --rm --network=none --no-hosts --runtime crun \
            -v /home/dev/m_in:/o localhost/scratch \
            ffmpeg -hide_banner -y -f lavfi -i testsrc=duration=1:size=128x96:rate=12 -pix_fmt yuv420p -c:v mpeg4 /o/clip.mp4 >/tmp/bmgen.log 2>&1
        { [ -s /home/dev/m_in/clip.mp4 ] && [ "$(stat -c %u /home/dev/m_in/clip.mp4 2>/dev/null)" = 1000 ]; } && say "BENCH-MEDIA input-fixture=ok bytes=$(stat -c %s /home/dev/m_in/clip.mp4 2>/dev/null)" || say "BENCH-MEDIA input-fixture=FAIL [$(tr -d '\r' </tmp/bmgen.log | tail -1)]"
        # drop the image so the bench run's ensure_seed must RE-LOAD the seed from the sysext archive.
        bdev podman rmi -f localhost/scratch >/dev/null 2>&1
        "$GKB" bench create media --quota 8192 >/tmp/bmc.log 2>&1
        "$GKB" bench grant media /home/dev/m_in  --ro >/tmp/bmg1.log 2>&1
        "$GKB" bench grant media /home/dev/m_out --rw >/tmp/bmg2.log 2>&1
        # THE north-star: a real ffmpeg transcode inside the bench, reading the ro input, writing the rw dest.
        "$GKB" bench run media -- ffmpeg -hide_banner -y -i /grants/m_in/clip.mp4 -c:v libvpx -b:v 200k -an /grants/m_out/out.webm >/tmp/bm.log 2>&1; MRC=$?
        MOUT=/home/dev/m_out/out.webm
        { [ "$MRC" -eq 0 ] && [ -s "$MOUT" ]; } && say "BENCH-MEDIA transcode=ok rc=$MRC bytes=$(stat -c %s "$MOUT" 2>/dev/null)" || say "BENCH-MEDIA transcode=FAIL rc=$MRC [$(tr -d '\r' </tmp/bm.log | tail -2 | tr '\n' '|')]"
        [ "$(stat -c %u "$MOUT" 2>/dev/null)" = 1000 ] && say "BENCH-MEDIA output-owned-by-dev=ok" || say "BENCH-MEDIA output-owned-by-dev=FAIL [$(stat -c %u "$MOUT" 2>/dev/null)]"
        bdev podman image exists localhost/scratch && say "BENCH-MEDIA seed-autoload=ok" || say "BENCH-MEDIA seed-autoload=FAIL (ensure_seed did not re-load the seed for the media run)"
        # validate it's a REAL decodable video (probe with the seed's own ffprobe), not an empty/garbage file.
        MVC=$(bdev env DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus" podman run --rm --network=none --no-hosts --runtime crun -v /home/dev/m_out:/o:ro localhost/scratch ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=nw=1:nk=1 /o/out.webm 2>/dev/null | tr -d '\r')
        [ "$MVC" = vp8 ] && say "BENCH-MEDIA output-is-video=ok codec=$MVC" || say "BENCH-MEDIA output-is-video=FAIL codec=[$MVC]"
        # host stays SEALED: a write to the read-only input grant from inside the bench is denied.
        "$GKB" bench run media -- sh -c 'echo pwn > /grants/m_in/pwn.txt' >/dev/null 2>&1
        [ ! -e /home/dev/m_in/pwn.txt ] && say "BENCH-MEDIA ro-input-sealed=ok" || say "BENCH-MEDIA ro-input-sealed=FAIL (ro grant was writable)"
        # destroy removes the bench (record + data + /run) but the delivered output PERSISTS on the host.
        "$GKB" bench destroy media >/dev/null 2>&1
        { [ ! -f "$BRECS/media" ] && [ ! -d "$BPOOL/b/media" ] && [ ! -d /run/shrek/bench/media ] && [ -s "$MOUT" ]; } && say "BENCH-MEDIA destroy-keeps-output=ok" || say "BENCH-MEDIA destroy-keeps-output=FAIL"
    else
        say "BENCH-SUP gatekeeperd=MISSING (not at $GKB)"
    fi
else
    say "BENCH podman=MISSING (shrek-bench sysext not merged into /usr?)"
fi
set -e

# --- Bench-authz step 3: the console consent ceremony (BENCH-CONSENT) --------------------------------
# Marker-gated: bench-consent-vm-proof.sh seeds /home/.shrek-consent-dogfood into the data disk so this
# runs ONLY under that proof (a plain dogfood-vm.sh run has no marker and skips clean — an undriven
# ceremony would burn 60s SAK-arm timeouts + arm per-(uid,verb) cooldowns). It needs boot2 (desktop up),
# which is exactly where the persist probe already is. Never aborts the persist run (guarded).
if [ -f /home/.shrek-consent-dogfood ]; then
    # Fast-iteration hook: prefer a probe seeded on the data disk (bench-consent-vm-proof.sh can update it
    # without a full image rebuild — /home may be noexec, so run it through `sh`), else the baked one.
    if [ -f /home/.shrek-consent-probe ]; then
        say "BENCH-CONSENT marker present — invoking data-disk override probe"
        sh /home/.shrek-consent-probe || say "BENCH-CONSENT probe exited non-zero rc=$?"
    elif [ -x /usr/lib/shrek/dogfood-consent-probe ]; then
        say "BENCH-CONSENT marker present — invoking baked dogfood-consent-probe"
        /usr/lib/shrek/dogfood-consent-probe || say "BENCH-CONSENT probe exited non-zero rc=$?"
    fi
fi


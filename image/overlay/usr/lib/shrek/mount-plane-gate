#!/bin/sh
# Phase-5/6 VM GATE: slice-1 M4 mount plane + slice-2 decision plane + slice-3 egress plane + slice-4 T0 +
# slice-6 T2 (S5 block) + slice-8 positive pin (S6) + slice-9 exec island (S7) + slice-10 closure (S8) +
# Phase-6 slice-1a untrusted-ingest coding session (P6) + slice-1b named egress on that session (P6B, inside
# P6). SPIKE ONLY: remove this file, shrek-mount-gate.service,
# and the multi-user.target.wants symlink before any real/shipped image
# (docs/phase5-slice1-mount.md, docs/phase5-slice2-tier.md, docs/phase5-slice8-pin-manifest.md §8, docs/phase6-slice1a-*.md).
#
# Runs on the sealed, enforcing-Secure-Boot image. Drives `gatekeeperd sandbox` to construct a
# capability-enforced T1 sandbox from a grant, and asserts the four mount-plane properties from
# INSIDE the sandbox, emitting anchored `SHREK_GATE:` lines on the serial console. The unit's
# Success/FailureAction powers the VM off afterwards; absence of a PASS line (hang/crash) fails
# closed because the host harness times out and never sees `PASS M4`.
set -u
GK=/usr/libexec/shrek/gatekeeperd
# Slice-7 (B1): the sealed CLOSED-WORLD in-sandbox probe. gatekeeperd DERIVES the trust band from the
# entrypoint measurement now, and a shell is open-world ⇒ T-hostile ⇒ cannot run at T0/T1. The probe
# is sealed on dm-verity /usr + enrolled in gatekeeperd's CLOSED_WORLD, so it legitimately derives
# T-first and drives the T0/T1 mechanics gates below. (docs/phase5-slice7-trust-provenance.md §8.1)
GP=/usr/libexec/shrek/gate-probe
SRV=/run/shrek-m4/srv
verdict_done=0

emit() { echo "SHREK_GATE: $*"; }
# EXIT trap keyed on $? — a crash before the verdict still prints a FAIL, never silence.
on_exit() {
  rc=$?
  [ "$verdict_done" = 1 ] || emit "FAIL M4 mount-plane VM gate reason=crashed rc=$rc"
}
trap on_exit EXIT

emit "M4-BEGIN Phase-5 slice-1 mount plane"
command -v systemd-nspawn >/dev/null 2>&1 || { emit "FAIL M4 mount-plane VM gate reason=nspawn-missing"; verdict_done=1; exit 1; }

# Fixtures on the writable tmpfs /run (the sealed dm-verity root is read-only): granted 'project',
# denied 'vault'.
mkdir -p "$SRV/project" "$SRV/vault"
echo PROJECT > "$SRV/project/marker"
echo VAULT   > "$SRV/vault/marker"

# In-sandbox probe: assert the caps-enforced mount set and emit a gate per property.
# F-M4 hygiene (docs/phase5-consolidation.md §1c/§2b): the token is assembled from parts (`$G $P`/`$G
# $F`) so the probe SOURCE contains NO literal `SHREK_GATE: FAIL`/`PASS`. gatekeeperd echoes the nspawn
# argv (incl. this `-c` body) to its stderr/console; with the literal removed, that echo no longer
# prints a stray `SHREK_GATE: FAIL` line. Runtime stdout still expands to the real tokens, so the
# anchored `^SHREK_GATE: PASS` parser is unchanged. (Acceptance for the NEXT image cycle: 0 raw
# SHREK_GATE:FAIL on the console — VM-confirmation of this cosmetic change is deferred to that cycle.)
PROBE='
G="SHREK_GATE:"; P="PASS"; F="FAIL"
m=$(cat /srv/project/marker 2>/dev/null); [ "$m" = PROJECT ] && echo "$G $P gate=in-project-readable" || echo "$G $F gate=in-project-readable m=$m"
if cat /srv/vault/marker 2>&1 | grep -qi "No such file"; then echo "$G $P gate=in-vault-enoent"; else echo "$G $F gate=in-vault-enoent"; fi
l=$(ls /srv | tr "\n" ,); [ "$l" = "project," ] && echo "$G $P gate=in-vault-absent" || echo "$G $F gate=in-vault-absent l=$l"
o=$(stat -c %u /srv/project/marker); [ "$o" = 65534 ] && echo "$G $P gate=in-private-users" || echo "$G $F gate=in-private-users o=$o"
'
# Capture the workload's STDOUT only (the in-sandbox gate lines); let gatekeeperd's diagnostics flow
# to the console via stderr. (Historically the 2>&1 argv-echo folded literal SHREK_GATE strings into
# the console; the F-M4 token-assembly above removes that literal at the source.)
OUT=$("$GK" sandbox --id m4 --anchor "$SRV" --grant project -- /bin/sh -c "$PROBE")
gkrc=$?
printf '%s\n' "$OUT"

# Anchored ^ so only real gate lines count — never an incidental echo of the probe source.
P=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: PASS gate=in-')
F=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: FAIL')
if [ "$gkrc" = 0 ] && [ "$F" = 0 ] && [ "$P" -ge 4 ]; then
  emit "PASS M4 mount-plane VM gate (gatekeeperd rc=0, ${P}/4 in-sandbox gates)"
else
  emit "FAIL M4 mount-plane VM gate (gkrc=${gkrc} pass=${P} fail=${F})"
fi

# ---- Phase-5 slice-2: the decision plane on the SEALED image (docs/phase5-slice2-tier.md) ----
# G6: on the dm-verity read-only /usr the gatekeeperd binary — and its COMPILED-IN (trust×caps)→tier
# matrix — is immutable, so the privileged re-check has NO writable input to tamper. Assert the plane
# behaves exactly as in the oracle: a cleared T1 request constructs; a ⇒T2 request fails CLOSED and
# the workload NEVER runs (no unconfined/weaker fallback — security-model.md §7).
s2fail=0
emit "S2-BEGIN Phase-5 slice-2 decision plane"

# G2: slice-7 — the entrypoint is the sealed closed-world gate-probe, so gatekeeperd DERIVES T-first
# (a shell would derive T-hostile). First/C-proj-rw floors at T0 and the requested T1 is a legal
# upward escalation ⇒ constructs at T1, and the slice-1 caps property still holds through the derived
# decision path. --trust T-first is only the audit proposal (matches the derivation). Same in-sandbox
# gate assertions as before (stdout-only capture; gatekeeperd's `exec …` echo goes to stderr/console).
OUT=$("$GK" sandbox --tier T1 --trust T-first --caps C-proj-rw --profile C-proj-rw \
        --id s2 --anchor "$SRV" --grant project -- "$GP" mount-guest)
s2rc=$?
printf '%s\n' "$OUT"
P2=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: PASS gate=in-')
F2=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: FAIL')
if [ "$s2rc" = 0 ] && [ "$F2" = 0 ] && [ "$P2" -ge 4 ]; then
  emit "PASS S2-cleared derived-T-first escalated to T1 (${P2}/4 gates)"
else
  emit "FAIL S2-cleared (rc=${s2rc} pass=${P2} fail=${F2})"; s2fail=1
fi

# G3*: slice-7 — a shell entrypoint DERIVES T-hostile; T-hostile/C-net floors at T3, so a request for
# the weaker T2 wall is a FORBIDDEN DOWNGRADE (rc=10) and the workload NEVER runs (0 in-sandbox gate
# lines). This is the B1 form of the slice-2 fail-closed property: a networked untrusted workload
# cannot obtain a wall weaker than its provenance+caps demand — no silent weaker fallback.
OUT=$("$GK" sandbox --tier T2 --trust T-hostile --caps C-net --profile C-net \
        --id s2r --anchor "$SRV" --grant project -- /bin/sh -c "$PROBE" 2>/dev/null)
rrc=$?
G2N=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE')
if [ "$rrc" = 10 ] && [ "$G2N" = 0 ]; then
  emit "PASS S2-refused hostile/C-net@T2 downgrade-refused fail-closed (rc=10, 0 workload gates)"
else
  emit "FAIL S2-refused (rc=${rrc} workload-gates=${G2N})"; s2fail=1
fi

[ "$s2fail" = 0 ] && emit "PASS S2 decision-plane VM gate" || emit "FAIL S2 decision-plane VM gate"

# ---- Phase-5 slice-3: the egress plane on the SEALED image (checkpoint #2567) ----
# The headless VM has NO NIC and a read-only /etc, so it cannot hermetically REACH a dst or map DNS;
# positive reach/deny/teardown are proven in the container oracle (scripts/egress-construct-proof.sh)
# against the IDENTICAL release binary. Here we assert the sealed-image properties that ARE provable
# without a network: (a) --private-network is applied (no-net cell = loopback-only, the closed
# host-net hole); (b) the fail-closed refusals hold on the sealed re-check; (c) a C-net request
# cannot SILENTLY egress when the broker cannot resolve (no NIC ⇒ construction fails closed).
s3fail=0
emit "S3-BEGIN Phase-5 slice-3 egress plane"

# (a) no-net cell: a cleared C-ro-nosec sandbox owns a FRESH netns with ONLY loopback (the historical
# host-netns hole — construct() used to pass no network flag — is shut on the sealed image). Slice-7:
# gate-probe derives T-first; First/C-ro-nosec floors T0, the requested T1 is a legal escalation.
OUT=$("$GK" sandbox --tier T1 --trust T-first --caps C-ro-nosec --profile C-ro-nosec \
        --id s3n --anchor "$SRV" --grant project -- "$GP" nonet)
printf '%s\n' "$OUT"
if printf '%s\n' "$OUT" | grep -q '^SHREK_GATE: PASS gate=s3-nonet-loopback-only'; then
  emit "PASS S3-nonet C-ro-nosec is loopback-only (host-net hole closed on sealed image)"
else
  emit "FAIL S3-nonet (no loopback-only gate)"; s3fail=1
fi

# (b) unknown egress profile ⇒ REFUSED (rc 13) at the sealed re-check; the workload NEVER runs.
"$GK" sandbox --tier T1 --trust T-first --caps C-net --egress-profile bogus-exfil --profile C-net \
      --id s3u --anchor "$SRV" --grant project -- "$GP" nonet >/dev/null 2>&1
urc=$?
[ "$urc" = 13 ] && emit "PASS S3-unknown-profile refused (rc=13)" || { emit "FAIL S3-unknown-profile (rc=$urc)"; s3fail=1; }

# (b) C-broad ⇒ REFUSED (rc 13): no plane for unrestricted egress, no silent downgrade to loopback.
"$GK" sandbox --tier T1 --trust T-first --caps C-broad --profile C-broad \
      --id s3b --anchor "$SRV" --grant project -- "$GP" nonet >/dev/null 2>&1
brc=$?
[ "$brc" = 13 ] && emit "PASS S3-cbroad refused (rc=13)" || { emit "FAIL S3-cbroad (rc=$brc)"; s3fail=1; }

# (c) C-net + a real sealed profile: with no NIC the broker cannot resolve the profile hosts, so
# construction FAILS CLOSED (nonzero) and hands back NO sandbox/egress — never a silent open network.
# (The positive "resolves ⇒ injects ⇒ reaches allowed / drops denied" path is an oracle gate.)
timeout 30 "$GK" sandbox --tier T1 --trust T-first --caps C-net --egress-profile github-https \
      --profile C-net --id s3c --anchor "$SRV" --grant project -- "$GP" nonet >/dev/null 2>&1
crc=$?
[ "$crc" != 0 ] && emit "PASS S3-cnet-failclosed C-net did not egress w/o resolver (rc=$crc)" || { emit "FAIL S3-cnet-failclosed (constructed unexpectedly rc=0)"; s3fail=1; }

[ "$s3fail" = 0 ] && emit "PASS S3 egress-plane VM gate" || emit "FAIL S3 egress-plane VM gate"

# ---- Phase-5 slice-4: GENUINE T0 (Landlock+seccomp+ns+cgroup) on the SEALED image ----
# The oracle (scripts/t0-construct-proof.sh) proves construction against the IDENTICAL release binary;
# the VM proves Landlock actually ENFORCES on the sealed kernel + dm-verity /usr — the one thing a
# container's kernel cannot guarantee. Landlock deliberately denies the sandbox its own /proc + /sys,
# so every probe is in-band. gatekeeperd is launched in a fresh systemd-delegated scope so its cgroup
# self-management (move-self-to-_daemon, then bound the sandbox leaf) has a base it alone occupies.
s4fail=0
emit "S4-BEGIN Phase-5 slice-4 T0 process sandbox"
# T0 has NO mount remap (unlike T1's bind to /srv guest-prefix): the grant is Landlock-allowed at its
# REAL anchor path, so the probe reads "$SRV/project", not "/srv/project". Slice-7: the sealed
# closed-world gate-probe (derives T-first; First/C-ro-nosec ⇒ T0) runs the SAME four T0 mechanics
# checks a shell used to; $SRV is passed as a DATA argument (the anchor to stat), never as code.
# 2>&1 capture is safe here: the T0 path prints NO argv echo (unlike the nspawn path), so the only
# SHREK_GATE lines are real in-sandbox results, and the construct-at=T0 decision line is grep-able.
if command -v systemd-run >/dev/null 2>&1; then
  OUT=$(systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T0 --trust T-first \
          --caps C-ro-nosec --profile C-ro-nosec --id s4 --anchor "$SRV" --grant project \
          -- "$GP" landlock "$SRV" 2>&1)
else
  OUT=$("$GK" sandbox --tier T0 --trust T-first --caps C-ro-nosec --profile C-ro-nosec \
          --id s4 --anchor "$SRV" --grant project -- "$GP" landlock "$SRV" 2>&1)
fi
printf '%s\n' "$OUT"
printf '%s\n' "$OUT" | grep -q 'construct-at=T0 effective=T0' \
  && emit "PASS S4-decision genuine-T0-on-sealed-kernel" || { emit "FAIL S4-decision (no construct-at=T0)"; s4fail=1; }
for g in t0-grant-readable t0-vault-landlock-denied t0-seccomp-mount-eperm t0-sys-landlock-denied; do
  printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" && emit "PASS S4-$g" || { emit "FAIL S4-$g"; s4fail=1; }
done
[ "$s4fail" = 0 ] && emit "PASS S4 T0-plane VM gate" || emit "FAIL S4 T0-plane VM gate"

# ---- Phase-5 slice-6: GENUINE T2 (gVisor/runsc) on the SEALED image (docs/phase5-slice6-t2.md §S5) ----
# The oracle (scripts/t2-construct-proof.sh) proves construction against the IDENTICAL release
# gatekeeperd + PINNED runsc; the VM proves the SEALED artifacts drive off gatekeeperd's compiled-in
# PROD default paths (/usr/lib/shrek/{runsc,t2-rootfs} on dm-verity /usr — NO SHREK_T2_* override here)
# AND that platform selection is correct: this VM is NESTED, so systemd-detect-virt reports a VM and
# the KVM_CREATE_VM probe must fail ⇒ platform=systrap. platform=kvm here would be a policy regression
# (nested-KVM attack surface). gatekeeperd runs in a fresh systemd-delegated scope so its cgroup-leaf
# self-management (move-self-to-_daemon, then bound the sandbox leaf) has a base it alone occupies — as S4.
s5fail=0
emit "S5-BEGIN Phase-5 slice-6 T2 gVisor sandbox"
# In-sandbox probe: fixed T2 guest paths (/srv/<grant>); the vault is simply not mounted ⇒ ENOENT. The
# minimal T2 rootfs has no /usr, so a host path like /usr/libexec/shrek is absent = host-fs isolated;
# --network=none makes any egress attempt fail.
T2PROBE='
[ -r /srv/project/marker ] && echo "SHREK_GATE: PASS gate=s5-grant-readable" || echo "SHREK_GATE: FAIL gate=s5-grant-readable"
[ -e /srv/vault ] && echo "SHREK_GATE: FAIL gate=s5-vault-absent" || echo "SHREK_GATE: PASS gate=s5-vault-absent"
[ -e /usr/libexec/shrek ] && echo "SHREK_GATE: FAIL gate=s5-host-fs-isolated" || echo "SHREK_GATE: PASS gate=s5-host-fs-isolated"
if timeout 5 nc -w 2 1.1.1.1 53 </dev/null >/dev/null 2>&1; then echo "SHREK_GATE: FAIL gate=s5-no-egress"; else echo "SHREK_GATE: PASS gate=s5-no-egress"; fi
'
# 2>&1 capture is safe: the T2 construct() path prints NO argv echo (like T0, unlike the nspawn T1
# path), so the only ^SHREK_GATE: lines are real in-sandbox results; the SANDBOX-DECISION line
# (construct-at=T2 … platform=…, on stderr) is grep-able from the same combined capture.
# SHREK_T2_DEBUG=1 (spike-only) makes the T2 constructor emit a runsc Sentry/boot debug log to
# /run/shrek-t2-debug/s5/ (persistent across the sandbox teardown) so a startup failure is diagnosable
# on the sealed image where there is no shell. systemd-run --scope runs GK as a direct child, so the
# env is inherited.
if command -v systemd-run >/dev/null 2>&1; then
  OUT=$(SHREK_T2_DEBUG=1 systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T2 --trust T-untrust \
          --caps C-ro-nosec --profile C-ro-nosec --id s5 --anchor "$SRV" --grant project \
          -- /bin/sh -c "$T2PROBE" 2>&1)
else
  OUT=$(SHREK_T2_DEBUG=1 "$GK" sandbox --tier T2 --trust T-untrust --caps C-ro-nosec --profile C-ro-nosec \
          --id s5 --anchor "$SRV" --grant project -- /bin/sh -c "$T2PROBE" 2>&1)
fi
printf '%s\n' "$OUT"
printf '%s\n' "$OUT" | grep -q 'construct-at=T2 effective=T2' \
  && emit "PASS S5-decision genuine-T2-on-sealed-kernel" || { emit "FAIL S5-decision (no construct-at=T2)"; s5fail=1; }
if printf '%s\n' "$OUT" | grep -q 'platform=systrap'; then
  emit "PASS S5-platform-systrap (nested VM ⇒ systemd-detect-virt + KVM_CREATE_VM probe chose systrap)"
else
  emit "FAIL S5-platform-systrap"; s5fail=1
fi
printf '%s\n' "$OUT" | grep -q 'platform=kvm' \
  && { emit "FAIL S5-picked-nested-KVM (policy regression)"; s5fail=1; } \
  || emit "PASS S5-did-not-pick-nested-kvm"
for g in s5-grant-readable s5-vault-absent s5-host-fs-isolated s5-no-egress; do
  printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" && emit "PASS S5-$g" || { emit "FAIL S5-$g"; s5fail=1; }
done
# On failure, surface the runsc Sentry/boot debug log (SHREK_T2_DEBUG) so we can see WHY the sandbox
# died on the sealed kernel — no shell on the image, so it must come out over the serial console. Kept
# to error-relevant lines + a short tail so it does not flood the console / blow the boot budget.
if [ "$s5fail" != 0 ]; then
  for f in /run/shrek-t2-debug/s5/*; do
    [ -f "$f" ] || continue
    emit "S5-DEBUG ==== $f ===="
    grep -inE 'panic|fatal|error|fail|unsupported|not permitted|denied|refus|cannot|eperm|enosys|lockdown|seccomp|mmap|ptrace|memfd' "$f" 2>/dev/null | tail -40 | sed 's/^/SHREK_GATE: S5-DEBUG /'
    emit "S5-DEBUG ---- tail ----"
    tail -20 "$f" | sed 's/^/SHREK_GATE: S5-DEBUG /'
  done
fi
[ "$s5fail" = 0 ] && emit "PASS S5 T2-plane VM gate" || emit "FAIL S5 T2-plane VM gate"

# ---- Phase-5 slice-8/9: POSITIVE PIN (B1 T-pinned) + T0 EXEC ISLAND on the SEALED image ----
# (docs/phase5-slice8-pin-manifest.md §8 + docs/phase5-slice9-pin-exec-home.md §7 build step 5)
# The oracles drive the IDENTICAL release binary on a genuine fs-verity fs and cover the cases a sealed
# image cannot (open-world/empty/malformed need a WRITABLE manifest; dynamic-pin fail-closed needs a
# PT_INTERP pin). The VM proves what only the sealed image can: the manifest BAKED under dm-verity /usr
# at build time (fsverity digest of the sealed gate-probe, build-in-container.sh) matches the REAL kernel
# FS_IOC_MEASURE_VERITY at runtime ⇒ gatekeeperd DERIVES T-pinned (S6), and — slice-9 — the closed-world
# static-PIE pin then RUNS from a per-inode T0 exec island while mutable grants stay MS_NOEXEC (S7).
# fs-verity is per-file; the sealed root is block-level dm-verity (RO), so the gate provisions a DEDICATED
# ext4 -O verity loopback on the writable tmpfs /run. FAIL, never skip (amendment D): if the sealed
# kernel/fs lacks fs-verity the gate goes RED, not silently green.
s6fail=0
emit "S6-BEGIN Phase-5 slice-8/9 positive pin + exec island (T-pinned)"
PINIMG=/run/shrek-pinfs.img
PINMNT=/run/shrek-pinfs
PINLOOP=
if ! command -v mkfs.ext4 >/dev/null 2>&1; then
  emit "FAIL S6 reason=mkfs.ext4-missing (e2fsprogs not in image)"; s6fail=1
else
  dd if=/dev/zero of="$PINIMG" bs=1M count=64 status=none 2>/dev/null
  # -b 4096: fs-verity requires the Merkle block size to equal the page size; a small ext4 otherwise
  # defaults to 1K blocks and FS_IOC_ENABLE_VERITY returns EINVAL.
  if mkfs.ext4 -q -b 4096 -O verity "$PINIMG" 2>/dev/null; then
    # loop nodes may be absent — pre-create a small range (same STM lesson as the oracle).
    i=0; while [ "$i" -le 15 ]; do [ -e /dev/loop$i ] || mknod -m660 /dev/loop$i b 7 "$i"; i=$((i + 1)); done
    mkdir -p "$PINMNT"
    PINLOOP=$(losetup -f --show "$PINIMG" 2>/dev/null)
    if [ -n "$PINLOOP" ] && mount "$PINLOOP" "$PINMNT" 2>/dev/null; then
      # Copy the SEALED gate-probe; make the rogue differ BEFORE enabling verity (immutable after).
      cp "$GP" "$PINMNT/pinned-probe"
      cp "$GP" "$PINMNT/rogue-probe"
      printf '\000' >> "$PINMNT/rogue-probe"
      if "$GK" pin-verity enable "$PINMNT/pinned-probe" >/dev/null 2>&1 \
         && "$GK" pin-verity enable "$PINMNT/rogue-probe" >/dev/null 2>&1; then
        DL=$("$GK" pin-verity measure "$PINMNT/pinned-probe" 2>/dev/null)
        emit "S6-provisioned fs-verity pinned-probe=[$DL] (vs baked /usr/lib/shrek/pin-manifest)"

        emit "PASS S6 pin-manifest classification provisioned (baked-manifest == kernel measure)"

        # ---- Phase-5 slice-9: the pinned EXECUTION home — the T0 exec ISLAND, on the sealed kernel ----
        # The oracle (pin-manifest-proof.sh §1,§6,§7) proves the full mechanism (island runs, mutable-
        # grant mmap/execve EPERM, rogue no-island, dynamic-pin fail-closed) on genuine fs-verity. The VM
        # proves the SAME positive path on the SEALED kernel: a closed-world static-PIE pin RUNS from a
        # per-inode exec island (NOEXEC dropped for that ONE re-verified inode) while every mutable grant
        # stays MS_NOEXEC — shown by the pinned workload's own mmap(PROT_EXEC)+execve of a mutable grant
        # both returning EPERM (the mmap case is the load-bearing no-laundering control Landlock does not
        # govern). gatekeeperd runs in a systemd-delegated scope so its cgroup self-management has a base
        # it alone occupies (as S4/S5). Dynamic-pin fail-closed is oracle-only (needs a PT_INTERP pin the
        # sealed image does not carry) — not silently skipped, stated here.
        # A mutable grant: a real +x executable on the writable grant dir, so ONLY the island's MS_NOEXEC
        # bind can stop execve/mmap(PROT_EXEC) of it (not file perms). $SRV is writable (S4 staged it).
        install -m0755 "$GP" "$SRV/project/evil"
        if command -v systemd-run >/dev/null 2>&1; then
          OUT=$(systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T0 --trust T-pinned \
                  --caps C-ro-nosec --profile C-ro-nosec --id s7 --anchor "$SRV" --grant project \
                  -- "$PINMNT/pinned-probe" island "$SRV/project/evil" 2>&1); prc=$?
        else
          OUT=$("$GK" sandbox --tier T0 --trust T-pinned --caps C-ro-nosec --profile C-ro-nosec \
                  --id s7 --anchor "$SRV" --grant project -- "$PINMNT/pinned-probe" island "$SRV/project/evil" 2>&1); prc=$?
        fi
        printf '%s\n' "$OUT"
        if printf '%s\n' "$OUT" | grep -q 'derived=T-pinned' \
           && printf '%s\n' "$OUT" | grep -q 'exec_fd_bound=true'; then
          emit "PASS S7-classify baked-manifest ⇒ derived=T-pinned exec_fd_bound=true (offline bake == kernel measure)"
        else
          emit "FAIL S7-classify (baked digest did not derive T-pinned)"; s6fail=1
        fi
        printf '%s\n' "$OUT" | grep -q 'construct-at=T0 island=exec' \
          && emit "PASS S7-island-construct (exec surface opened for exactly one inode on the sealed kernel)" \
          || { emit "FAIL S7-island-construct (no construct-at=T0 island=exec, rc=$prc)"; s6fail=1; }
        for g in island-ran island-grant-mmap-exec-eperm island-grant-execve-denied; do
          printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" \
            && emit "PASS S7-$g" || { emit "FAIL S7-$g"; s6fail=1; }
        done
        # F2 (docs/phase5-consolidation.md §2): island root NOEXEC, entry mount independently
        # exec-capable — the fail-closed statfs self-check emits this only when the invariant holds.
        printf '%s\n' "$OUT" | grep -q 'SANDBOX-ISLAND-FLAGS parent-noexec=1 members-exec-ok=1' \
          && emit "PASS S7-island-flags (root NOEXEC, entry mount independently exec-capable)" \
          || { emit "FAIL S7-island-flags (self-check absent)"; s6fail=1; }

        # anti-spoof: the one-byte-different second verity inode is not pinned ⇒ T-hostile ⇒ no island is
        # constructed and the pinned bytes never run. Its T0 request is a downgrade-below-floor(T2)
        # refusal, so assert the DERIVED band on the always-printed provenance line, not the rc.
        OUT=$("$GK" sandbox --tier T0 --trust T-pinned --caps C-ro-nosec --profile C-ro-nosec \
                --id s7r --anchor "$SRV" --grant project -- "$PINMNT/rogue-probe" island "$SRV/project/evil" 2>&1)
        if printf '%s\n' "$OUT" | grep -q 'derived=T-hostile' \
           && ! printf '%s\n' "$OUT" | grep -q 'island=exec' \
           && ! printf '%s\n' "$OUT" | grep -q 'gate=island-ran'; then
          emit "PASS S7-antispoof rogue verity inode ⇒ T-hostile, no island, pinned bytes never ran"
        else
          emit "FAIL S7-antispoof"; s6fail=1
        fi
      else
        emit "FAIL S6 reason=enable-verity (sealed kernel/fs lacks fs-verity)"; s6fail=1
      fi
      umount "$PINMNT" 2>/dev/null
    else
      emit "FAIL S6 reason=losetup/mount"; s6fail=1
    fi
    [ -n "$PINLOOP" ] && losetup -d "$PINLOOP" 2>/dev/null
  else
    emit "FAIL S6 reason=mkfs-verity (ext4 -O verity unsupported on sealed kernel)"; s6fail=1
  fi
fi
[ "$s6fail" = 0 ] && emit "PASS S7 pin-exec-plane VM gate" || emit "FAIL S7 pin-exec-plane VM gate"

# ============= Phase-5 slice-10: sealed-dynamic closure island (S8) =============
# docs/phase5-slice10-sealed-dynamic.md §9. Proves the PRODUCTION CUSTODY PATH on the sealed image: the
# v2 closure manifest BAKED under dm-verity /usr (build-in-container.sh STAGE 2, offline fsverity digest)
# matches the runtime kernel FS_IOC_MEASURE_VERITY, so a pinned DYNAMIC entrypoint + its pinned
# interpreter (exact PT_INTERP) + transitive pinned libs RE-MEASURE successfully and RUN from the N-inode
# island, while /usr and mutable grants stay MS_NOEXEC outside the closure (the mutable-grant
# mmap(PROT_EXEC)=EPERM assertion). A TAMPERED closure member (a byte-different, unpinned interp inode)
# re-measures wrong ⇒ construction fails closed and the pinned bytes never run. Same dedicated
# ext4 -O verity loopback as S6/S7 (the sealed root is block-level dm-verity, RO — no per-file verity).
# The oracle (pin-manifest-proof.sh §8/§9) proves the identical mechanism on genuine fs-verity first.
s8fail=0
emit "S8-BEGIN Phase-5 slice-10 sealed-dynamic closure island (T-pinned)"
DYNSRC=/usr/libexec/shrek/dynpkg
DYNIMG=/run/shrek-dynfs.img
DYNMNT=/run/shrek-dynfs
DYNLOOP=
if [ ! -f "$DYNSRC/dyn-probe" ] || [ ! -f "$DYNSRC/closure.meta" ]; then
  emit "FAIL S8 reason=dynpkg-missing (build-in-container S8 stage not baked)"; s8fail=1
elif ! command -v mkfs.ext4 >/dev/null 2>&1; then
  emit "FAIL S8 reason=mkfs.ext4-missing"; s8fail=1
else
  IB=$(basename "$(awk '$1=="interp"{print $2}' "$DYNSRC/closure.meta")")   # interp basename
  dd if=/dev/zero of="$DYNIMG" bs=1M count=96 status=none 2>/dev/null
  if mkfs.ext4 -q -b 4096 -O verity "$DYNIMG" 2>/dev/null; then
    i=0; while [ "$i" -le 15 ]; do [ -e /dev/loop$i ] || mknod -m660 /dev/loop$i b 7 "$i"; i=$((i + 1)); done
    mkdir -p "$DYNMNT"
    DYNLOOP=$(losetup -f --show "$DYNIMG" 2>/dev/null)
    if [ -n "$DYNLOOP" ] && mount "$DYNLOOP" "$DYNMNT" 2>/dev/null; then
      # enable fs-verity on the entrypoint + every closure member of a delivered dir; echo ok|bad.
      enable_pkg() {  # $1 = target dir already populated with the closure files
        ok=1
        "$GK" pin-verity enable "$1/dyn-probe" >/dev/null 2>&1 || ok=0
        "$GK" pin-verity enable "$1/$IB" >/dev/null 2>&1 || ok=0
        for so in $(awk '$1=="lib"{print $2}' "$DYNSRC/closure.meta"); do
          "$GK" pin-verity enable "$1/$so" >/dev/null 2>&1 || ok=0
        done
        [ "$ok" = 1 ]
      }
      # ---- positive: the intact pinned closure RUNS ----
      mkdir -p "$DYNMNT/dynpkg"; cp "$DYNSRC"/* "$DYNMNT/dynpkg/" 2>/dev/null
      if enable_pkg "$DYNMNT/dynpkg"; then
        install -m0755 "$GP" "$SRV/project/evil"   # mutable grant for the NOEXEC assertion
        if command -v systemd-run >/dev/null 2>&1; then
          OUT=$(systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T0 --trust T-pinned \
                  --caps C-ro-nosec --profile C-ro-nosec --id s8 --anchor "$SRV" --grant project \
                  -- "$DYNMNT/dynpkg/dyn-probe" island "$SRV/project/evil" 2>&1); prc=$?
        else
          OUT=$("$GK" sandbox --tier T0 --trust T-pinned --caps C-ro-nosec --profile C-ro-nosec \
                  --id s8 --anchor "$SRV" --grant project -- "$DYNMNT/dynpkg/dyn-probe" island "$SRV/project/evil" 2>&1); prc=$?
        fi
        printf '%s\n' "$OUT"
        if printf '%s\n' "$OUT" | grep -q 'derived=T-pinned' && printf '%s\n' "$OUT" | grep -q 'exec_fd_bound=true'; then
          emit "PASS S8-classify baked v2 closure ⇒ derived=T-pinned (offline bake == kernel measure)"
        else emit "FAIL S8-classify (baked closure digests did not derive T-pinned)"; s8fail=1; fi
        printf '%s\n' "$OUT" | grep -q 'construct-at=T0 island=closure' \
          && emit "PASS S8-closure-construct (N-inode closure island on the sealed kernel)" \
          || { emit "FAIL S8-closure-construct (no island=closure, rc=$prc)"; s8fail=1; }
        for g in island-ran island-grant-mmap-exec-eperm island-grant-execve-denied; do
          printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" \
            && emit "PASS S8-$g" || { emit "FAIL S8-$g"; s8fail=1; }
        done
        # F2: island root NOEXEC while entry + every closure-member (lib) mount is independently
        # exec-capable — the statfs self-check line proves the mount-flag independence directly.
        printf '%s\n' "$OUT" | grep -q 'SANDBOX-ISLAND-FLAGS parent-noexec=1 members-exec-ok=1' \
          && emit "PASS S8-island-flags (root NOEXEC, all closure-member mounts independently exec-capable)" \
          || { emit "FAIL S8-island-flags (self-check absent under closure)"; s8fail=1; }
        # ---- negative: a tampered (byte-different, unpinned) interp inode ⇒ fail closed ----
        # The entrypoint digest still matches (⇒ derived=T-pinned), but relocate_member re-measures the
        # interp against the baked digest and rejects the tampered bytes ⇒ island never completes.
        mkdir -p "$DYNMNT/dynrogue"; cp "$DYNSRC"/* "$DYNMNT/dynrogue/" 2>/dev/null
        printf '\000' >> "$DYNMNT/dynrogue/$IB"    # differ BEFORE enabling verity (immutable after)
        if enable_pkg "$DYNMNT/dynrogue"; then
          OUT=$("$GK" sandbox --tier T0 --trust T-pinned --caps C-ro-nosec --profile C-ro-nosec \
                  --id s8r --anchor "$SRV" --grant project -- "$DYNMNT/dynrogue/dyn-probe" island "$SRV/project/evil" 2>&1); rrc=$?
          if printf '%s\n' "$OUT" | grep -q 'derived=T-pinned' \
             && ! printf '%s\n' "$OUT" | grep -q 'gate=island-ran' && [ "$rrc" != 0 ]; then
            emit "PASS S8-tamper tampered interp inode ⇒ construction fails closed, pinned bytes never ran (rc=$rrc)"
          else emit "FAIL S8-tamper (tampered closure member not fail-closed, rc=$rrc)"; s8fail=1; fi
        else emit "FAIL S8-tamper reason=enable-verity-rogue"; s8fail=1; fi
      else
        emit "FAIL S8 reason=enable-verity (sealed kernel/fs lacks fs-verity)"; s8fail=1
      fi
      umount "$DYNMNT" 2>/dev/null
    else
      emit "FAIL S8 reason=losetup/mount"; s8fail=1
    fi
    [ -n "$DYNLOOP" ] && losetup -d "$DYNLOOP" 2>/dev/null
  else
    emit "FAIL S8 reason=mkfs-verity (ext4 -O verity unsupported on sealed kernel)"; s8fail=1
  fi
fi
[ "$s8fail" = 0 ] && emit "PASS S8 sealed-dynamic-plane VM gate" || emit "FAIL S8 sealed-dynamic-plane VM gate"

# ============= Phase-6 slice-1a: integrity-bound untrusted-ingest coding session (P6) =============
# docs/phase6-slice1a-*.md. The end-to-end coding-agent slice on the sealed kernel: an --ingest-harness
# session earns Origin::UntrustedIngest (T-untrust, not the T-hostile floor) ONLY because the T2 runsc
# harness fs-verity-measures into the sealed admit-list, constructs at GENUINE T2 (gVisor), and runs a
# REAL edit → compile → execute loop with project-scoped write-through, while home/Vault + network stay
# unavailable. The real compiler (tcc, sealed into the T2 rootfs) is what makes this a true test: a real
# ELF compiled from project source EXECUTES from the exec-capable build grant, while the SAME ELF copied
# into the noexec project grant CANNOT run (the owner build-grant design — gVisor needs mmap(PROT_EXEC) of
# a gofer file, denied by a MS_NOEXEC host mount; this supersedes the earlier shell-script G3 stand-in).
#
# The sealed /usr runsc is block-level dm-verity, NOT per-file fs-verity, so it has no fs-verity digest to
# admit. As S6/S8 do for the pin-manifest, provision a DEDICATED ext4 -O verity loopback, copy the SEALED
# runsc onto it, enable fs-verity, and point the T2 substrate at it via SHREK_T2_RUNSC (spike-only). Its
# kernel-measured digest EQUALS the OFFLINE `fsverity digest` baked into /usr/lib/shrek/t2-ingest-admit at
# seal time (content-addressed), so the BAKED admit-list authenticates it — offline bake == kernel measure,
# the same property S6 proves. The rootfs (busybox + tcc + freestanding template) is the SEALED
# /usr/lib/shrek/t2-rootfs (NO SHREK_T2_ROOTFS override). FAIL, never skip, if fs-verity is unavailable.
p6fail=0
emit "P6-BEGIN Phase-6 slice-1a untrusted-ingest T2 coding session (real compile+execute)"
P6IMG=/run/shrek-ingestfs.img
P6MNT=/run/shrek-ingestfs
P6LOOP=
if [ ! -x /usr/lib/shrek/runsc ]; then
  emit "FAIL P6 reason=sealed-runsc-missing (seal-t2-artifacts not baked)"; p6fail=1
elif [ ! -f /usr/lib/shrek/t2-ingest-admit ]; then
  emit "FAIL P6 reason=admit-list-missing (seal-t2-artifacts did not bake it)"; p6fail=1
elif [ ! -x /usr/lib/shrek/t2-rootfs/usr/bin/tcc ]; then
  emit "FAIL P6 reason=tcc-missing (seal-t2-artifacts did not bake the compiler)"; p6fail=1
elif ! command -v mkfs.ext4 >/dev/null 2>&1; then
  emit "FAIL P6 reason=mkfs.ext4-missing"; p6fail=1
else
  # 256 MB: the runsc harness is ~100 MB, so the loopback fs must hold it + its fs-verity Merkle tree
  # (a 96 MB image can't even fit the copy — the S6/S8 probes are small, this one is not).
  dd if=/dev/zero of="$P6IMG" bs=1M count=256 status=none 2>/dev/null
  if mkfs.ext4 -q -b 4096 -O verity "$P6IMG" 2>/dev/null; then
    i=0; while [ "$i" -le 15 ]; do [ -e /dev/loop$i ] || mknod -m660 /dev/loop$i b 7 "$i"; i=$((i + 1)); done
    mkdir -p "$P6MNT"
    P6LOOP=$(losetup -f --show "$P6IMG" 2>/dev/null)
    if [ -n "$P6LOOP" ] && mount -o exec "$P6LOOP" "$P6MNT" 2>/dev/null; then
      # Copy the SEALED runsc onto the verity fs (must fit — the image is sized for it). Verify the copy
      # is complete before enabling verity, so a size/space problem reports as itself, not enable-verity.
      SZSRC=$(stat -c%s /usr/lib/shrek/runsc 2>/dev/null)
      cp /usr/lib/shrek/runsc "$P6MNT/runsc" 2>/dev/null; cprc=$?; chmod +x "$P6MNT/runsc" 2>/dev/null
      SZDST=$(stat -c%s "$P6MNT/runsc" 2>/dev/null)
      if [ "$cprc" != 0 ] || [ "$SZSRC" != "$SZDST" ]; then
        emit "FAIL P6 reason=runsc-copy (cprc=$cprc src=$SZSRC dst=$SZDST — verity fs too small?)"; p6fail=1
      elif "$GK" pin-verity enable "$P6MNT/runsc" >/dev/null 2>&1; then
        DL=$("$GK" pin-verity measure "$P6MNT/runsc" 2>/dev/null)
        emit "P6-provisioned fs-verity runsc=[$DL] (vs baked /usr/lib/shrek/t2-ingest-admit)"
        # Anchor on writable tmpfs: project (source, noexec) + build (exec) + ungranted vault. README is
        # pre-existing (teardown must not destroy it); vault sentinel proves the wall.
        P6SRV=/run/shrek-p6/srv
        rm -rf "$P6SRV"; mkdir -p "$P6SRV/project" "$P6SRV/build" "$P6SRV/vault"
        echo "pre-existing-project-file" > "$P6SRV/project/README"
        echo "TOP-SECRET" > "$P6SRV/vault/secret"
        # The coding loop: edit a real .c into the project grant (write-through) → tcc-compile OUTPUT into
        # the exec build grant → EXECUTE it there → prove the same ELF copied into the project CANNOT run.
        # project-exec is judged on the run MARKER (not the exit code — the ELF's own success exit is 42,
        # itself nonzero), so a leak cannot hide. No single quotes inside (LOOP is single-quoted here).
        LOOP='echo PROBE-START; PATH=/usr/bin:/bin:/sbin; export PATH; cd /srv/project || { echo NO-PROJECT; exit 40; }; cp /coder-src/hello.c ./hello.c && echo "/* edit-9f3a */" >> ./hello.c && echo EDIT-WROTE-OK; if /usr/bin/tcc -nostdlib -static -o /srv/build/hello ./hello.c 2>/srv/build/tcc.err; then echo TCC-COMPILE-OK; BO=$(/srv/build/hello); echo "BUILD-RAN out=[$BO] exit=$?"; else echo TCC-COMPILE-FAIL; cat /srv/build/tcc.err; fi; cp /srv/build/hello ./proj-copy 2>/dev/null; PJ=$(./proj-copy 2>&1); case "$PJ" in *REAL-COMPILE-RUN-OK*) echo PROJECT-EXEC-LEAK-BAD;; *) echo PROJECT-NOEXEC-ENFORCED-OK;; esac; if [ -e /srv/vault ]; then echo VAULT-VISIBLE-BAD; else echo VAULT-ABSENT-OK; fi; if [ -e /usr/libexec/shrek ]; then echo HOST-FS-LEAK-BAD; else echo HOST-FS-ISOLATED-OK; fi; if timeout 5 nc -w 2 1.1.1.1 53 </dev/null >/dev/null 2>&1; then echo EGRESS-REACHED-BAD; else echo NO-EGRESS-OK; fi; echo PROBE-END'
        # G1 uses the BAKED admit-list (no SHREK_INGEST_ADMIT) — proving offline bake == kernel measure.
        # SHREK_T2_RUNSC points at the loopback per-file-verity runsc; systemd-run --scope inherits the env.
        if command -v systemd-run >/dev/null 2>&1; then
          # --setenv makes the SHREK_T2_RUNSC relocation explicit to the scoped child (belt-and-suspenders
          # over --scope env inheritance); the prefix covers the non-systemd-run fallback below.
          OUT=$(SHREK_T2_RUNSC="$P6MNT/runsc" systemd-run --scope --quiet -p Delegate=yes \
                  --setenv=SHREK_T2_RUNSC="$P6MNT/runsc" -- "$GK" sandbox \
                  --tier T2 --trust T-hostile --caps C-proj-rw --profile C-proj-rw --ingest-harness --id p6 \
                  --anchor "$P6SRV" --rw-grant project --build-grant build -- /bin/sh -c "$LOOP" 2>&1)
        else
          OUT=$(SHREK_T2_RUNSC="$P6MNT/runsc" "$GK" sandbox --tier T2 --trust T-hostile --caps C-proj-rw \
                  --profile C-proj-rw --ingest-harness --id p6 --anchor "$P6SRV" --rw-grant project \
                  --build-grant build -- /bin/sh -c "$LOOP" 2>&1)
        fi
        printf '%s\n' "$OUT"
        # G1: integrity-bound admission ⇒ T-untrust ⇒ genuine T2 (baked admit-list authenticated runsc).
        printf '%s\n' "$OUT" | grep -q 'mode=ingest-harness derived=T-untrust' \
          && emit "PASS P6-G1 admission⇒derived=T-untrust (baked admit-list authenticated runsc)" || { emit "FAIL P6-G1 derived=T-untrust"; p6fail=1; }
        printf '%s\n' "$OUT" | grep -q 'harness_authentic=true' \
          && emit "PASS P6-G1 harness_authentic=true (offline bake == kernel measure)" || { emit "FAIL P6-G1 harness_authentic"; p6fail=1; }
        printf '%s\n' "$OUT" | grep -q 'construct-at=T2 effective=T2' \
          && emit "PASS P6-G1 construct-at=T2 (genuine gVisor on sealed kernel)" || { emit "FAIL P6-G1 construct-at=T2"; p6fail=1; }
        # REAL-COMPILE-OK: a real freestanding compiler produced an ELF that ran from the exec build grant.
        printf '%s\n' "$OUT" | grep -q 'TCC-COMPILE-OK' \
          && emit "PASS P6-REAL-COMPILE tcc produced an ELF from freshly-written project source" || { emit "FAIL P6-REAL-COMPILE (tcc did not compile)"; p6fail=1; }
        printf '%s\n' "$OUT" | grep -q 'BUILD-RAN out=\[REAL-COMPILE-RUN-OK\] exit=42' \
          && emit "PASS P6-G3 REAL-COMPILE-OK compiled ELF ran from exec build grant + controlled exit (=42)" || { emit "FAIL P6-G3 build-exec (compiled ELF did not run from build grant)"; p6fail=1; }
        # G3 wall: the SAME ELF copied into the noexec project grant CANNOT execute.
        printf '%s\n' "$OUT" | grep -q 'PROJECT-NOEXEC-ENFORCED-OK' \
          && emit "PASS P6-G3 project noexec ENFORCED (same ELF cannot execute from project grant)" || { emit "FAIL P6-G3 project-noexec (execution from project grant not blocked)"; p6fail=1; }
        printf '%s\n' "$OUT" | grep -q 'PROJECT-EXEC-LEAK-BAD' \
          && { emit "FAIL P6-G3 PROJECT-EXEC-LEAK (ran from noexec project)"; p6fail=1; } || emit "PASS P6-G3 no project-exec leak"
        # G2 write-through across both grants (probed content on the host inodes — the M4 lesson, not a
        # console string): edited source on the project inode, a real ELF on the build inode; README survives.
        printf '%s\n' "$OUT" | grep -q 'EDIT-WROTE-OK' \
          && emit "PASS P6-G2 workload wrote source into project grant" || { emit "FAIL P6-G2 workload-wrote"; p6fail=1; }
        grep -q 'edit-9f3a' "$P6SRV/project/hello.c" 2>/dev/null \
          && emit "PASS P6-G2 write-through: edited hello.c on project (host)" || { emit "FAIL P6-G2 write-through-source"; p6fail=1; }
        if [ -f "$P6SRV/build/hello" ] && head -c4 "$P6SRV/build/hello" 2>/dev/null | grep -qa ELF; then
          emit "PASS P6-G2 write-through: compiled ELF on build grant (host, ELF magic)"
        else emit "FAIL P6-G2 write-through-ELF-on-host"; p6fail=1; fi
        grep -q 'pre-existing-project-file' "$P6SRV/project/README" 2>/dev/null \
          && emit "PASS P6-G2 teardown non-destructive: pre-existing README intact" || { emit "FAIL P6-G2 teardown DESTROYED project content"; p6fail=1; }
        # G4 the wall.
        for probe in VAULT-ABSENT-OK HOST-FS-ISOLATED-OK NO-EGRESS-OK; do
          printf '%s\n' "$OUT" | grep -q "$probe" && emit "PASS P6-G4 $probe" || { emit "FAIL P6-G4 $probe"; p6fail=1; }
        done
        printf '%s\n' "$OUT" | grep -qE 'VAULT-VISIBLE-BAD|HOST-FS-LEAK-BAD|EGRESS-REACHED-BAD' \
          && { emit "FAIL P6-G4 LEAK DETECTED"; p6fail=1; } || emit "PASS P6-G4 no-leak-markers"

        # G5: SAME request, admit-list that admits NOTHING (SHREK_INGEST_ADMIT override, spike-only) ⇒
        # T-hostile ⇒ (T-hostile,C-proj-rw)=T3 ⇒ refused below floor, nothing constructed/ran/wrote. Only
        # the admit-list differs — the SAME cell flips construct→refuse purely on harness integrity.
        BADADMIT=/run/shrek-p6/admit.bad
        printf 'shrek-t2-ingest-admit v1\n' > "$BADADMIT"
        rm -f "$P6SRV/project/leak.txt"
        OUT5=$(SHREK_T2_RUNSC="$P6MNT/runsc" SHREK_INGEST_ADMIT="$BADADMIT" "$GK" sandbox --tier T2 \
                 --trust T-hostile --caps C-proj-rw --profile C-proj-rw --ingest-harness --id p6b \
                 --anchor "$P6SRV" --rw-grant project --build-grant build \
                 -- /bin/sh -c 'echo LEAKED > /srv/project/leak.txt; echo LEAKED' 2>&1); rc5=$?
        printf '%s\n' "$OUT5"
        printf '%s\n' "$OUT5" | grep -q 'mode=ingest-harness derived=T-hostile' \
          && emit "PASS P6-G5 no-admit⇒derived=T-hostile" || { emit "FAIL P6-G5 no-admit⇒T-hostile"; p6fail=1; }
        { { [ "$rc5" = 10 ] || [ "$rc5" = 12 ]; } && printf '%s\n' "$OUT5" | grep -q 'SANDBOX-DECISION refused'; } \
          && emit "PASS P6-G5 failed-closed rc=$rc5 (refused)" || { emit "FAIL P6-G5 failed-closed rc=$rc5"; p6fail=1; }
        printf '%s\n' "$OUT5" | grep -q 'construct-at=' && { emit "FAIL P6-G5 constructed (should refuse)"; p6fail=1; } || emit "PASS P6-G5 never-constructed"
        printf '%s\n' "$OUT5" | grep -q 'LEAKED' && { emit "FAIL P6-G5 workload-ran (LEAK)"; p6fail=1; } || emit "PASS P6-G5 workload-never-ran"
        [ -e "$P6SRV/project/leak.txt" ] && { emit "FAIL P6-G5 workload wrote to host (LEAK)"; p6fail=1; } || emit "PASS P6-G5 no-host-write"

        # ---- Phase-6 slice-1b: NAMED EGRESS wired into the T2 ingest constructor (sealed kernel) ----
        # The oracle (scripts/p6-egress-proof.sh) proves the POSITIVE path on the IDENTICAL binary:
        # netstack egresses from the pre-created netns to the sealed profile's pinned dst, drops the rest,
        # tears down clean. The VM (no NIC, RO /etc ⇒ no resolver) proves the sealed-kernel WIRING +
        # fail-closed: a C-net ingest cell reaches the T2 constructor WITH the resolved egress profile,
        # then FAILS CLOSED rather than silently opening a network; unknown/broad still refuse. (Same
        # split as S3: the endpoint-free VM cannot show reach, so reach lives in the oracle.)
        # (a) C-net + sealed profile: the decision carries egress=github-https at construct-at=T2 (egress
        #     WIRED into the T2 constructor on the sealed kernel), then construction FAILS CLOSED (no NIC ⇒
        #     resolve_profile_v4 finds no A-record), the workload NEVER runs.
        OUTB=$(SHREK_T2_RUNSC="$P6MNT/runsc" timeout 30 "$GK" sandbox --tier T2 --trust T-hostile \
                 --caps C-net --profile C-net --ingest-harness --id p6be --anchor "$P6SRV" --grant project \
                 --egress-profile github-https -- /bin/sh -c 'echo SHOULD-NOT-RUN' 2>&1); rcb=$?
        printf '%s\n' "$OUTB"
        printf '%s\n' "$OUTB" | grep -q 'construct-at=T2 effective=T2 .*egress=github-https' \
          && emit "PASS P6B-wired egress=github-https reached the T2 constructor (sealed kernel)" || { emit "FAIL P6B-wired (egress not wired into T2 constructor)"; p6fail=1; }
        { [ "$rcb" != 0 ] && ! printf '%s\n' "$OUTB" | grep -q 'SHOULD-NOT-RUN'; } \
          && emit "PASS P6B-failclosed C-net did not egress w/o resolver (rc=$rcb, workload never ran)" || { emit "FAIL P6B-failclosed (rc=$rcb or workload ran)"; p6fail=1; }
        # (b) unknown egress profile ⇒ REFUSED (rc 13), nothing constructed.
        SHREK_T2_RUNSC="$P6MNT/runsc" "$GK" sandbox --tier T2 --trust T-hostile --caps C-net --profile C-net \
              --ingest-harness --id p6bu --anchor "$P6SRV" --grant project --egress-profile bogus-exfil \
              -- /bin/sh -c 'echo SHOULD-NOT-RUN' >/dev/null 2>&1; ubrc=$?
        [ "$ubrc" = 13 ] && emit "PASS P6B-unknown-profile refused (rc=13)" || { emit "FAIL P6B-unknown-profile (rc=$ubrc)"; p6fail=1; }
        # (c) C-broad ⇒ (T-untrust,C-broad)=T3 ⇒ no constructor; naming a profile does NOT buy egress.
        SHREK_T2_RUNSC="$P6MNT/runsc" "$GK" sandbox --tier T3 --trust T-hostile --caps C-broad --profile C-broad \
              --ingest-harness --id p6bb --anchor "$P6SRV" --grant project --egress-profile github-https \
              -- /bin/sh -c 'echo SHOULD-NOT-RUN' >/dev/null 2>&1; bbrc=$?
        [ "$bbrc" = 12 ] && emit "PASS P6B-cbroad refused (rc=12 no-constructor-T3)" || { emit "FAIL P6B-cbroad (rc=$bbrc)"; p6fail=1; }
        # (d) no residual netns / veth / nft after the fail-closed run.
        rns=$(ip netns list 2>/dev/null | grep -oE 'shrek-p6b[a-z]+' | tr '\n' ,)
        rif=$(ip -o link show 2>/dev/null | grep -oE 'skh[0-9a-f]{4}' | tr '\n' ,)
        rtb=$(nft list tables 2>/dev/null | grep -o 'shrek_egress_[a-z0-9_]*' | tr '\n' ,)
        { [ -z "$rns" ] && [ -z "$rif" ] && [ -z "$rtb" ]; } && emit "PASS P6B-teardown no residual egress plumbing" || { emit "FAIL P6B-teardown ns=[$rns] if=[$rif] tb=[$rtb]"; p6fail=1; }

        # ---- Phase-6 slice-2: the SEALED CODER AGENT as the T2 workload (docs/phase6-slice2-coder-agent.md) ----
        # The oracle (scripts/p6-coder-agent-proof.sh) proves the POSITIVE end-to-end on the IDENTICAL
        # binary: the model-driven coder drives read->write->build/run->done through the shipped `shrek run`
        # front door over the sealed `model-local` egress (21/21 canned gate + LIVE 35B). The endpoint-free
        # VM cannot REACH a model dst (no NIC, RO /etc ⇒ no resolver, no python3 responder) — the SAME split
        # as S3/P6B — so reach stays the oracle and the VM proves what ONLY the sealed image can: (1) the
        # coder binary is SEALED under dm-verity /usr (seal-t2-artifacts.sh baked it), and (2) the SAME
        # model-driven coder session WIRES the sealed `model-local` egress into the genuine-T2 constructor on
        # the sealed kernel, then FAILS CLOSED (no resolver) so the coder never dials and never runs — no
        # silent open network. This is exactly the gatekeeperd argv `shrek run --egress model-local --
        # /usr/bin/coder …` composes (crates/shrek: a named egress ⇒ caps=C-net ⊇ C-proj-rw, --profile
        # mirrors, --ingest-harness on, --rw-grant/--build-grant carried through).
        emit "P62-BEGIN Phase-6 slice-2 sealed coder agent as the T2 workload (seal + wiring + fail-closed)"
        # (1) the seal baked the coder into the sealed T2 rootfs (its integrity is dm-verity /usr, NOT the
        #     ingest admit-list — that measures the runsc HARNESS, so runsc stays the admitted harness).
        if [ -x /usr/lib/shrek/t2-rootfs/usr/bin/coder ]; then
          emit "PASS P62-sealed coder baked under dm-verity /usr (t2-rootfs/usr/bin/coder)"
        else
          emit "FAIL P62-sealed coder missing from sealed t2-rootfs (seal-t2-artifacts did not bake it)"; p6fail=1
        fi
        # Phase-6 slice-7: the re-sealed coder carries the opaque per-session handle emit (X-Shrek-Session).
        # The endpoint-free VM coder fails closed before it dials (below), so the header's ON-WIRE behavior
        # stays oracle/unit territory (scripts/p6-session-broker-proof.sh); here we prove only that the
        # SEALED binary was rebuilt WITH the slice-7 change — i.e. the sealed image is not stale.
        if grep -aq 'X-Shrek-Session' /usr/lib/shrek/t2-rootfs/usr/bin/coder; then
          emit "PASS P62-slice7 sealed coder carries the session-handle emit (X-Shrek-Session)"
        else
          emit "FAIL P62-slice7 sealed coder lacks X-Shrek-Session (stale seal — re-run seal-t2-artifacts)"; p6fail=1
        fi
        # Phase-6 Swamp slice-2: this image cycle must have baked the slice-2 change into BOTH on-image
        # halves — the sealed CODER (a new swamp_find tool) and the sealed POLICY (compiled into
        # gatekeeperd, the swamp-query egress dst). Broker-routing itself is oracle/unit territory
        # (scripts/swamp-broker-find-proof.sh, off-image swamp-broker); here we prove only that the sealed
        # image is not stale w.r.t. slice-2. A missing marker means a seal/rebuild was skipped.
        if grep -aq 'swamp_find' /usr/lib/shrek/t2-rootfs/usr/bin/coder; then
          emit "PASS P62-swamp2 sealed coder carries the swamp_find tool (broker-routed in-sandbox find)"
        else
          emit "FAIL P62-swamp2 sealed coder lacks swamp_find (stale seal — re-run seal-t2-artifacts)"; p6fail=1
        fi
        if grep -aq 'shrek-swamp-broker' "$GK"; then
          emit "PASS P62-swamp2 sealed policy carries the swamp-query egress dst (shrek-swamp-broker)"
        else
          emit "FAIL P62-swamp2 sealed policy lacks swamp-query (stale gatekeeperd — rebuild the image)"; p6fail=1
        fi
        P62TASK="Make the program print REAL-COMPILE-RUN-OK and exit 42."
        OUT62=$(SHREK_T2_RUNSC="$P6MNT/runsc" timeout 30 "$GK" sandbox --tier T2 --trust T-hostile \
                  --caps C-net --profile C-net --ingest-harness --id p62 --anchor "$P6SRV" \
                  --rw-grant project --build-grant build --egress-profile model-local \
                  -- /usr/bin/coder --task "$P62TASK" --max-steps 4 2>&1); rc62=$?
        printf '%s\n' "$OUT62"
        # (2a) integrity: the baked admit-list authenticated the runsc harness for this coder session.
        printf '%s\n' "$OUT62" | grep -q 'mode=ingest-harness derived=T-untrust' \
          && emit "PASS P62-integrity coder session ⇒ derived=T-untrust (baked admit-list authenticated runsc)" || { emit "FAIL P62-integrity (coder session not derived=T-untrust)"; p6fail=1; }
        # (2b) wired: the sealed model-local egress reached the genuine-T2 constructor for the coder workload
        #      (proves the sealed policy carries `model-local` — an unknown profile would rc=13 with no line).
        printf '%s\n' "$OUT62" | grep -q 'construct-at=T2 effective=T2 .*egress=model-local' \
          && emit "PASS P62-wired sealed model-local egress wired into the T2 coder constructor (sealed kernel)" || { emit "FAIL P62-wired (model-local not wired into the T2 coder constructor)"; p6fail=1; }
        # (2c) fail-closed: no NIC ⇒ resolve finds no A-record ⇒ construction fails closed, coder never runs.
        { [ "$rc62" != 0 ] && ! printf '%s\n' "$OUT62" | grep -q 'CODER-START'; } \
          && emit "PASS P62-failclosed C-net coder session did not egress w/o resolver (rc=$rc62, coder never started)" || { emit "FAIL P62-failclosed (rc=$rc62 or coder ran)"; p6fail=1; }
        # (2d) no residual egress plumbing after the fail-closed coder session.
        r2ns=$(ip netns list 2>/dev/null | grep -oE 'shrek-p62[a-z0-9]*' | tr '\n' ,)
        r2if=$(ip -o link show 2>/dev/null | grep -oE 'skh[0-9a-f]{4}' | tr '\n' ,)
        r2tb=$(nft list tables 2>/dev/null | grep -o 'shrek_egress_[a-z0-9_]*' | tr '\n' ,)
        { [ -z "$r2ns" ] && [ -z "$r2if" ] && [ -z "$r2tb" ]; } && emit "PASS P62-teardown no residual egress plumbing" || { emit "FAIL P62-teardown ns=[$r2ns] if=[$r2if] tb=[$r2tb]"; p6fail=1; }

        # ---- Phase-6 slice-3: the HOSTED-MODEL (Anthropic) provider path (docs/phase6-slice3-provider-abstraction.md) ----
        # The oracle (scripts/p6-anthropic-proxy-proof.sh) proves the POSITIVE end-to-end on the IDENTICAL
        # binary: the coder speaks the messages API in PLAINTEXT to the broker proxy over `model-anthropic`,
        # the proxy injects the key + does TLS to Anthropic, the box holds no secret and reaches only the
        # proxy (23/23). The endpoint-free VM cannot reach the broker proxy (no NIC/resolver, and the proxy
        # is BROKER-SIDE — never sealed into the image), so — the SAME S3/P6B/P6-2 split — the VM proves what
        # only the sealed image can: the SAME sealed coder with `--provider anthropic` WIRES the sealed
        # `model-anthropic` egress into the genuine-T2 constructor on the sealed kernel, then FAILS CLOSED so
        # the coder never dials and never runs. No secret and no TLS ever enter the box (both live in the
        # broker proxy, out of the image's scope entirely).
        emit "P63-BEGIN Phase-6 slice-3 hosted-model (anthropic) provider (wiring + fail-closed)"
        OUT63=$(SHREK_T2_RUNSC="$P6MNT/runsc" timeout 30 "$GK" sandbox --tier T2 --trust T-hostile \
                  --caps C-net --profile C-net --ingest-harness --id p63 --anchor "$P6SRV" \
                  --rw-grant project --build-grant build --egress-profile model-anthropic \
                  -- /usr/bin/coder --provider anthropic --task "$P62TASK" --max-steps 4 2>&1); rc63=$?
        printf '%s\n' "$OUT63"
        printf '%s\n' "$OUT63" | grep -q 'mode=ingest-harness derived=T-untrust' \
          && emit "PASS P63-integrity anthropic coder session ⇒ derived=T-untrust" || { emit "FAIL P63-integrity"; p6fail=1; }
        # The sealed policy carries `model-anthropic` (an unknown profile would rc=13 with no decision line).
        printf '%s\n' "$OUT63" | grep -q 'construct-at=T2 effective=T2 .*egress=model-anthropic' \
          && emit "PASS P63-wired sealed model-anthropic egress wired into the T2 coder constructor (sealed kernel)" || { emit "FAIL P63-wired (model-anthropic not wired into the T2 constructor)"; p6fail=1; }
        { [ "$rc63" != 0 ] && ! printf '%s\n' "$OUT63" | grep -q 'CODER-START'; } \
          && emit "PASS P63-failclosed anthropic session did not egress w/o resolver (rc=$rc63, coder never started; no secret/TLS in box)" || { emit "FAIL P63-failclosed (rc=$rc63 or coder ran)"; p6fail=1; }
        r3ns=$(ip netns list 2>/dev/null | grep -oE 'shrek-p63[a-z0-9]*' | tr '\n' ,)
        r3tb=$(nft list tables 2>/dev/null | grep -o 'shrek_egress_[a-z0-9_]*' | tr '\n' ,)
        { [ -z "$r3ns" ] && [ -z "$r3tb" ]; } && emit "PASS P63-teardown no residual egress plumbing" || { emit "FAIL P63-teardown ns=[$r3ns] tb=[$r3tb]"; p6fail=1; }
      else
        emit "FAIL P6 reason=enable-verity (sealed kernel/fs lacks fs-verity)"; p6fail=1
      fi
      umount "$P6MNT" 2>/dev/null
    else
      emit "FAIL P6 reason=losetup/mount"; p6fail=1
    fi
    [ -n "$P6LOOP" ] && losetup -d "$P6LOOP" 2>/dev/null
  else
    emit "FAIL P6 reason=mkfs-verity (ext4 -O verity unsupported on sealed kernel)"; p6fail=1
  fi
fi
[ "$p6fail" = 0 ] && emit "PASS P6 untrusted-ingest coding-session VM gate" || emit "FAIL P6 untrusted-ingest coding-session VM gate"
verdict_done=1

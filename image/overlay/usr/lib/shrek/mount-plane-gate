#!/bin/sh
# Phase-5 VM GATE: slice-1 M4 mount plane + slice-2 decision plane + slice-3 egress plane + slice-4 T0 +
# slice-6 T2 (S5 block) + slice-8 positive pin (S6) + slice-9 exec island (S7). SPIKE ONLY: remove this file,
# shrek-mount-gate.service, and the multi-user.target.wants symlink before any real/shipped image
# (docs/phase5-slice1-mount.md, docs/phase5-slice2-tier.md, docs/phase5-slice8-pin-manifest.md §8).
#
# Runs on the sealed, enforcing-Secure-Boot image. Drives `gatekeeperd sandbox` to construct a
# capability-enforced T1 sandbox from a grant, and asserts the four mount-plane properties from
# INSIDE the sandbox, emitting anchored `SHREK_GATE:` lines on the serial console. The unit's
# Success/FailureAction powers the VM off afterwards; absence of a PASS line (hang/crash) fails
# closed because the host harness times out and never sees `PASS M4`.
set -u
GK=/usr/libexec/shrek/gatekeeperd
# Slice-7 (B1): the sealed CLOSED-WORLD in-sandbox probe. gatekeeperd DERIVES the trust band from the
# entrypoint measurement now, and a shell is open-world ⇒ T-hostile ⇒ cannot run at T0/T1. The probe
# is sealed on dm-verity /usr + enrolled in gatekeeperd's CLOSED_WORLD, so it legitimately derives
# T-first and drives the T0/T1 mechanics gates below. (docs/phase5-slice7-trust-provenance.md §8.1)
GP=/usr/libexec/shrek/gate-probe
SRV=/run/shrek-m4/srv
verdict_done=0

emit() { echo "SHREK_GATE: $*"; }
# EXIT trap keyed on $? — a crash before the verdict still prints a FAIL, never silence.
on_exit() {
  rc=$?
  [ "$verdict_done" = 1 ] || emit "FAIL M4 mount-plane VM gate reason=crashed rc=$rc"
}
trap on_exit EXIT

emit "M4-BEGIN Phase-5 slice-1 mount plane"
command -v systemd-nspawn >/dev/null 2>&1 || { emit "FAIL M4 mount-plane VM gate reason=nspawn-missing"; verdict_done=1; exit 1; }

# Fixtures on the writable tmpfs /run (the sealed dm-verity root is read-only): granted 'project',
# denied 'vault'.
mkdir -p "$SRV/project" "$SRV/vault"
echo PROJECT > "$SRV/project/marker"
echo VAULT   > "$SRV/vault/marker"

# In-sandbox probe: assert the caps-enforced mount set and emit a gate per property.
PROBE='
m=$(cat /srv/project/marker 2>/dev/null); [ "$m" = PROJECT ] && echo "SHREK_GATE: PASS gate=in-project-readable" || echo "SHREK_GATE: FAIL gate=in-project-readable m=$m"
if cat /srv/vault/marker 2>&1 | grep -qi "No such file"; then echo "SHREK_GATE: PASS gate=in-vault-enoent"; else echo "SHREK_GATE: FAIL gate=in-vault-enoent"; fi
l=$(ls /srv | tr "\n" ,); [ "$l" = "project," ] && echo "SHREK_GATE: PASS gate=in-vault-absent" || echo "SHREK_GATE: FAIL gate=in-vault-absent l=$l"
o=$(stat -c %u /srv/project/marker); [ "$o" = 65534 ] && echo "SHREK_GATE: PASS gate=in-private-users" || echo "SHREK_GATE: FAIL gate=in-private-users o=$o"
'
# Capture the workload's STDOUT only (the in-sandbox gate lines); let gatekeeperd's diagnostics flow
# to the console via stderr. Capturing 2>&1 would fold in the `exec …` echo, whose embedded probe
# source literally contains SHREK_GATE strings and would corrupt the counts.
OUT=$("$GK" sandbox --id m4 --anchor "$SRV" --grant project -- /bin/sh -c "$PROBE")
gkrc=$?
printf '%s\n' "$OUT"

# Anchored ^ so only real gate lines count — never an incidental echo of the probe source.
P=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: PASS gate=in-')
F=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: FAIL')
if [ "$gkrc" = 0 ] && [ "$F" = 0 ] && [ "$P" -ge 4 ]; then
  emit "PASS M4 mount-plane VM gate (gatekeeperd rc=0, ${P}/4 in-sandbox gates)"
else
  emit "FAIL M4 mount-plane VM gate (gkrc=${gkrc} pass=${P} fail=${F})"
fi

# ---- Phase-5 slice-2: the decision plane on the SEALED image (docs/phase5-slice2-tier.md) ----
# G6: on the dm-verity read-only /usr the gatekeeperd binary — and its COMPILED-IN (trust×caps)→tier
# matrix — is immutable, so the privileged re-check has NO writable input to tamper. Assert the plane
# behaves exactly as in the oracle: a cleared T1 request constructs; a ⇒T2 request fails CLOSED and
# the workload NEVER runs (no unconfined/weaker fallback — security-model.md §7).
s2fail=0
emit "S2-BEGIN Phase-5 slice-2 decision plane"

# G2: slice-7 — the entrypoint is the sealed closed-world gate-probe, so gatekeeperd DERIVES T-first
# (a shell would derive T-hostile). First/C-proj-rw floors at T0 and the requested T1 is a legal
# upward escalation ⇒ constructs at T1, and the slice-1 caps property still holds through the derived
# decision path. --trust T-first is only the audit proposal (matches the derivation). Same in-sandbox
# gate assertions as before (stdout-only capture; gatekeeperd's `exec …` echo goes to stderr/console).
OUT=$("$GK" sandbox --tier T1 --trust T-first --caps C-proj-rw --profile C-proj-rw \
        --id s2 --anchor "$SRV" --grant project -- "$GP" mount-guest)
s2rc=$?
printf '%s\n' "$OUT"
P2=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: PASS gate=in-')
F2=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE: FAIL')
if [ "$s2rc" = 0 ] && [ "$F2" = 0 ] && [ "$P2" -ge 4 ]; then
  emit "PASS S2-cleared derived-T-first escalated to T1 (${P2}/4 gates)"
else
  emit "FAIL S2-cleared (rc=${s2rc} pass=${P2} fail=${F2})"; s2fail=1
fi

# G3*: slice-7 — a shell entrypoint DERIVES T-hostile; T-hostile/C-net floors at T3, so a request for
# the weaker T2 wall is a FORBIDDEN DOWNGRADE (rc=10) and the workload NEVER runs (0 in-sandbox gate
# lines). This is the B1 form of the slice-2 fail-closed property: a networked untrusted workload
# cannot obtain a wall weaker than its provenance+caps demand — no silent weaker fallback.
OUT=$("$GK" sandbox --tier T2 --trust T-hostile --caps C-net --profile C-net \
        --id s2r --anchor "$SRV" --grant project -- /bin/sh -c "$PROBE" 2>/dev/null)
rrc=$?
G2N=$(printf '%s\n' "$OUT" | grep -c '^SHREK_GATE')
if [ "$rrc" = 10 ] && [ "$G2N" = 0 ]; then
  emit "PASS S2-refused hostile/C-net@T2 downgrade-refused fail-closed (rc=10, 0 workload gates)"
else
  emit "FAIL S2-refused (rc=${rrc} workload-gates=${G2N})"; s2fail=1
fi

[ "$s2fail" = 0 ] && emit "PASS S2 decision-plane VM gate" || emit "FAIL S2 decision-plane VM gate"

# ---- Phase-5 slice-3: the egress plane on the SEALED image (checkpoint #2567) ----
# The headless VM has NO NIC and a read-only /etc, so it cannot hermetically REACH a dst or map DNS;
# positive reach/deny/teardown are proven in the container oracle (scripts/egress-construct-proof.sh)
# against the IDENTICAL release binary. Here we assert the sealed-image properties that ARE provable
# without a network: (a) --private-network is applied (no-net cell = loopback-only, the closed
# host-net hole); (b) the fail-closed refusals hold on the sealed re-check; (c) a C-net request
# cannot SILENTLY egress when the broker cannot resolve (no NIC ⇒ construction fails closed).
s3fail=0
emit "S3-BEGIN Phase-5 slice-3 egress plane"

# (a) no-net cell: a cleared C-ro-nosec sandbox owns a FRESH netns with ONLY loopback (the historical
# host-netns hole — construct() used to pass no network flag — is shut on the sealed image). Slice-7:
# gate-probe derives T-first; First/C-ro-nosec floors T0, the requested T1 is a legal escalation.
OUT=$("$GK" sandbox --tier T1 --trust T-first --caps C-ro-nosec --profile C-ro-nosec \
        --id s3n --anchor "$SRV" --grant project -- "$GP" nonet)
printf '%s\n' "$OUT"
if printf '%s\n' "$OUT" | grep -q '^SHREK_GATE: PASS gate=s3-nonet-loopback-only'; then
  emit "PASS S3-nonet C-ro-nosec is loopback-only (host-net hole closed on sealed image)"
else
  emit "FAIL S3-nonet (no loopback-only gate)"; s3fail=1
fi

# (b) unknown egress profile ⇒ REFUSED (rc 13) at the sealed re-check; the workload NEVER runs.
"$GK" sandbox --tier T1 --trust T-first --caps C-net --egress-profile bogus-exfil --profile C-net \
      --id s3u --anchor "$SRV" --grant project -- "$GP" nonet >/dev/null 2>&1
urc=$?
[ "$urc" = 13 ] && emit "PASS S3-unknown-profile refused (rc=13)" || { emit "FAIL S3-unknown-profile (rc=$urc)"; s3fail=1; }

# (b) C-broad ⇒ REFUSED (rc 13): no plane for unrestricted egress, no silent downgrade to loopback.
"$GK" sandbox --tier T1 --trust T-first --caps C-broad --profile C-broad \
      --id s3b --anchor "$SRV" --grant project -- "$GP" nonet >/dev/null 2>&1
brc=$?
[ "$brc" = 13 ] && emit "PASS S3-cbroad refused (rc=13)" || { emit "FAIL S3-cbroad (rc=$brc)"; s3fail=1; }

# (c) C-net + a real sealed profile: with no NIC the broker cannot resolve the profile hosts, so
# construction FAILS CLOSED (nonzero) and hands back NO sandbox/egress — never a silent open network.
# (The positive "resolves ⇒ injects ⇒ reaches allowed / drops denied" path is an oracle gate.)
timeout 30 "$GK" sandbox --tier T1 --trust T-first --caps C-net --egress-profile github-https \
      --profile C-net --id s3c --anchor "$SRV" --grant project -- "$GP" nonet >/dev/null 2>&1
crc=$?
[ "$crc" != 0 ] && emit "PASS S3-cnet-failclosed C-net did not egress w/o resolver (rc=$crc)" || { emit "FAIL S3-cnet-failclosed (constructed unexpectedly rc=0)"; s3fail=1; }

[ "$s3fail" = 0 ] && emit "PASS S3 egress-plane VM gate" || emit "FAIL S3 egress-plane VM gate"

# ---- Phase-5 slice-4: GENUINE T0 (Landlock+seccomp+ns+cgroup) on the SEALED image ----
# The oracle (scripts/t0-construct-proof.sh) proves construction against the IDENTICAL release binary;
# the VM proves Landlock actually ENFORCES on the sealed kernel + dm-verity /usr — the one thing a
# container's kernel cannot guarantee. Landlock deliberately denies the sandbox its own /proc + /sys,
# so every probe is in-band. gatekeeperd is launched in a fresh systemd-delegated scope so its cgroup
# self-management (move-self-to-_daemon, then bound the sandbox leaf) has a base it alone occupies.
s4fail=0
emit "S4-BEGIN Phase-5 slice-4 T0 process sandbox"
# T0 has NO mount remap (unlike T1's bind to /srv guest-prefix): the grant is Landlock-allowed at its
# REAL anchor path, so the probe reads "$SRV/project", not "/srv/project". Slice-7: the sealed
# closed-world gate-probe (derives T-first; First/C-ro-nosec ⇒ T0) runs the SAME four T0 mechanics
# checks a shell used to; $SRV is passed as a DATA argument (the anchor to stat), never as code.
# 2>&1 capture is safe here: the T0 path prints NO argv echo (unlike the nspawn path), so the only
# SHREK_GATE lines are real in-sandbox results, and the construct-at=T0 decision line is grep-able.
if command -v systemd-run >/dev/null 2>&1; then
  OUT=$(systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T0 --trust T-first \
          --caps C-ro-nosec --profile C-ro-nosec --id s4 --anchor "$SRV" --grant project \
          -- "$GP" landlock "$SRV" 2>&1)
else
  OUT=$("$GK" sandbox --tier T0 --trust T-first --caps C-ro-nosec --profile C-ro-nosec \
          --id s4 --anchor "$SRV" --grant project -- "$GP" landlock "$SRV" 2>&1)
fi
printf '%s\n' "$OUT"
printf '%s\n' "$OUT" | grep -q 'construct-at=T0 effective=T0' \
  && emit "PASS S4-decision genuine-T0-on-sealed-kernel" || { emit "FAIL S4-decision (no construct-at=T0)"; s4fail=1; }
for g in t0-grant-readable t0-vault-landlock-denied t0-seccomp-mount-eperm t0-sys-landlock-denied; do
  printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" && emit "PASS S4-$g" || { emit "FAIL S4-$g"; s4fail=1; }
done
[ "$s4fail" = 0 ] && emit "PASS S4 T0-plane VM gate" || emit "FAIL S4 T0-plane VM gate"

# ---- Phase-5 slice-6: GENUINE T2 (gVisor/runsc) on the SEALED image (docs/phase5-slice6-t2.md §S5) ----
# The oracle (scripts/t2-construct-proof.sh) proves construction against the IDENTICAL release
# gatekeeperd + PINNED runsc; the VM proves the SEALED artifacts drive off gatekeeperd's compiled-in
# PROD default paths (/usr/lib/shrek/{runsc,t2-rootfs} on dm-verity /usr — NO SHREK_T2_* override here)
# AND that platform selection is correct: this VM is NESTED, so systemd-detect-virt reports a VM and
# the KVM_CREATE_VM probe must fail ⇒ platform=systrap. platform=kvm here would be a policy regression
# (nested-KVM attack surface). gatekeeperd runs in a fresh systemd-delegated scope so its cgroup-leaf
# self-management (move-self-to-_daemon, then bound the sandbox leaf) has a base it alone occupies — as S4.
s5fail=0
emit "S5-BEGIN Phase-5 slice-6 T2 gVisor sandbox"
# In-sandbox probe: fixed T2 guest paths (/srv/<grant>); the vault is simply not mounted ⇒ ENOENT. The
# minimal T2 rootfs has no /usr, so a host path like /usr/libexec/shrek is absent = host-fs isolated;
# --network=none makes any egress attempt fail.
T2PROBE='
[ -r /srv/project/marker ] && echo "SHREK_GATE: PASS gate=s5-grant-readable" || echo "SHREK_GATE: FAIL gate=s5-grant-readable"
[ -e /srv/vault ] && echo "SHREK_GATE: FAIL gate=s5-vault-absent" || echo "SHREK_GATE: PASS gate=s5-vault-absent"
[ -e /usr/libexec/shrek ] && echo "SHREK_GATE: FAIL gate=s5-host-fs-isolated" || echo "SHREK_GATE: PASS gate=s5-host-fs-isolated"
if timeout 5 nc -w 2 1.1.1.1 53 </dev/null >/dev/null 2>&1; then echo "SHREK_GATE: FAIL gate=s5-no-egress"; else echo "SHREK_GATE: PASS gate=s5-no-egress"; fi
'
# 2>&1 capture is safe: the T2 construct() path prints NO argv echo (like T0, unlike the nspawn T1
# path), so the only ^SHREK_GATE: lines are real in-sandbox results; the SANDBOX-DECISION line
# (construct-at=T2 … platform=…, on stderr) is grep-able from the same combined capture.
# SHREK_T2_DEBUG=1 (spike-only) makes the T2 constructor emit a runsc Sentry/boot debug log to
# /run/shrek-t2-debug/s5/ (persistent across the sandbox teardown) so a startup failure is diagnosable
# on the sealed image where there is no shell. systemd-run --scope runs GK as a direct child, so the
# env is inherited.
if command -v systemd-run >/dev/null 2>&1; then
  OUT=$(SHREK_T2_DEBUG=1 systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T2 --trust T-untrust \
          --caps C-ro-nosec --profile C-ro-nosec --id s5 --anchor "$SRV" --grant project \
          -- /bin/sh -c "$T2PROBE" 2>&1)
else
  OUT=$(SHREK_T2_DEBUG=1 "$GK" sandbox --tier T2 --trust T-untrust --caps C-ro-nosec --profile C-ro-nosec \
          --id s5 --anchor "$SRV" --grant project -- /bin/sh -c "$T2PROBE" 2>&1)
fi
printf '%s\n' "$OUT"
printf '%s\n' "$OUT" | grep -q 'construct-at=T2 effective=T2' \
  && emit "PASS S5-decision genuine-T2-on-sealed-kernel" || { emit "FAIL S5-decision (no construct-at=T2)"; s5fail=1; }
if printf '%s\n' "$OUT" | grep -q 'platform=systrap'; then
  emit "PASS S5-platform-systrap (nested VM ⇒ systemd-detect-virt + KVM_CREATE_VM probe chose systrap)"
else
  emit "FAIL S5-platform-systrap"; s5fail=1
fi
printf '%s\n' "$OUT" | grep -q 'platform=kvm' \
  && { emit "FAIL S5-picked-nested-KVM (policy regression)"; s5fail=1; } \
  || emit "PASS S5-did-not-pick-nested-kvm"
for g in s5-grant-readable s5-vault-absent s5-host-fs-isolated s5-no-egress; do
  printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" && emit "PASS S5-$g" || { emit "FAIL S5-$g"; s5fail=1; }
done
# On failure, surface the runsc Sentry/boot debug log (SHREK_T2_DEBUG) so we can see WHY the sandbox
# died on the sealed kernel — no shell on the image, so it must come out over the serial console. Kept
# to error-relevant lines + a short tail so it does not flood the console / blow the boot budget.
if [ "$s5fail" != 0 ]; then
  for f in /run/shrek-t2-debug/s5/*; do
    [ -f "$f" ] || continue
    emit "S5-DEBUG ==== $f ===="
    grep -inE 'panic|fatal|error|fail|unsupported|not permitted|denied|refus|cannot|eperm|enosys|lockdown|seccomp|mmap|ptrace|memfd' "$f" 2>/dev/null | tail -40 | sed 's/^/SHREK_GATE: S5-DEBUG /'
    emit "S5-DEBUG ---- tail ----"
    tail -20 "$f" | sed 's/^/SHREK_GATE: S5-DEBUG /'
  done
fi
[ "$s5fail" = 0 ] && emit "PASS S5 T2-plane VM gate" || emit "FAIL S5 T2-plane VM gate"

# ---- Phase-5 slice-8/9: POSITIVE PIN (B1 T-pinned) + T0 EXEC ISLAND on the SEALED image ----
# (docs/phase5-slice8-pin-manifest.md §8 + docs/phase5-slice9-pin-exec-home.md §7 build step 5)
# The oracles drive the IDENTICAL release binary on a genuine fs-verity fs and cover the cases a sealed
# image cannot (open-world/empty/malformed need a WRITABLE manifest; dynamic-pin fail-closed needs a
# PT_INTERP pin). The VM proves what only the sealed image can: the manifest BAKED under dm-verity /usr
# at build time (fsverity digest of the sealed gate-probe, build-in-container.sh) matches the REAL kernel
# FS_IOC_MEASURE_VERITY at runtime ⇒ gatekeeperd DERIVES T-pinned (S6), and — slice-9 — the closed-world
# static-PIE pin then RUNS from a per-inode T0 exec island while mutable grants stay MS_NOEXEC (S7).
# fs-verity is per-file; the sealed root is block-level dm-verity (RO), so the gate provisions a DEDICATED
# ext4 -O verity loopback on the writable tmpfs /run. FAIL, never skip (amendment D): if the sealed
# kernel/fs lacks fs-verity the gate goes RED, not silently green.
s6fail=0
emit "S6-BEGIN Phase-5 slice-8/9 positive pin + exec island (T-pinned)"
PINIMG=/run/shrek-pinfs.img
PINMNT=/run/shrek-pinfs
PINLOOP=
if ! command -v mkfs.ext4 >/dev/null 2>&1; then
  emit "FAIL S6 reason=mkfs.ext4-missing (e2fsprogs not in image)"; s6fail=1
else
  dd if=/dev/zero of="$PINIMG" bs=1M count=64 status=none 2>/dev/null
  # -b 4096: fs-verity requires the Merkle block size to equal the page size; a small ext4 otherwise
  # defaults to 1K blocks and FS_IOC_ENABLE_VERITY returns EINVAL.
  if mkfs.ext4 -q -b 4096 -O verity "$PINIMG" 2>/dev/null; then
    # loop nodes may be absent — pre-create a small range (same STM lesson as the oracle).
    i=0; while [ "$i" -le 15 ]; do [ -e /dev/loop$i ] || mknod -m660 /dev/loop$i b 7 "$i"; i=$((i + 1)); done
    mkdir -p "$PINMNT"
    PINLOOP=$(losetup -f --show "$PINIMG" 2>/dev/null)
    if [ -n "$PINLOOP" ] && mount "$PINLOOP" "$PINMNT" 2>/dev/null; then
      # Copy the SEALED gate-probe; make the rogue differ BEFORE enabling verity (immutable after).
      cp "$GP" "$PINMNT/pinned-probe"
      cp "$GP" "$PINMNT/rogue-probe"
      printf '\000' >> "$PINMNT/rogue-probe"
      if "$GK" pin-verity enable "$PINMNT/pinned-probe" >/dev/null 2>&1 \
         && "$GK" pin-verity enable "$PINMNT/rogue-probe" >/dev/null 2>&1; then
        DL=$("$GK" pin-verity measure "$PINMNT/pinned-probe" 2>/dev/null)
        emit "S6-provisioned fs-verity pinned-probe=[$DL] (vs baked /usr/lib/shrek/pin-manifest)"

        emit "PASS S6 pin-manifest classification provisioned (baked-manifest == kernel measure)"

        # ---- Phase-5 slice-9: the pinned EXECUTION home — the T0 exec ISLAND, on the sealed kernel ----
        # The oracle (pin-manifest-proof.sh §1,§6,§7) proves the full mechanism (island runs, mutable-
        # grant mmap/execve EPERM, rogue no-island, dynamic-pin fail-closed) on genuine fs-verity. The VM
        # proves the SAME positive path on the SEALED kernel: a closed-world static-PIE pin RUNS from a
        # per-inode exec island (NOEXEC dropped for that ONE re-verified inode) while every mutable grant
        # stays MS_NOEXEC — shown by the pinned workload's own mmap(PROT_EXEC)+execve of a mutable grant
        # both returning EPERM (the mmap case is the load-bearing no-laundering control Landlock does not
        # govern). gatekeeperd runs in a systemd-delegated scope so its cgroup self-management has a base
        # it alone occupies (as S4/S5). Dynamic-pin fail-closed is oracle-only (needs a PT_INTERP pin the
        # sealed image does not carry) — not silently skipped, stated here.
        # A mutable grant: a real +x executable on the writable grant dir, so ONLY the island's MS_NOEXEC
        # bind can stop execve/mmap(PROT_EXEC) of it (not file perms). $SRV is writable (S4 staged it).
        install -m0755 "$GP" "$SRV/project/evil"
        if command -v systemd-run >/dev/null 2>&1; then
          OUT=$(systemd-run --scope --quiet -p Delegate=yes -- "$GK" sandbox --tier T0 --trust T-pinned \
                  --caps C-ro-nosec --profile C-ro-nosec --id s7 --anchor "$SRV" --grant project \
                  -- "$PINMNT/pinned-probe" island "$SRV/project/evil" 2>&1); prc=$?
        else
          OUT=$("$GK" sandbox --tier T0 --trust T-pinned --caps C-ro-nosec --profile C-ro-nosec \
                  --id s7 --anchor "$SRV" --grant project -- "$PINMNT/pinned-probe" island "$SRV/project/evil" 2>&1); prc=$?
        fi
        printf '%s\n' "$OUT"
        if printf '%s\n' "$OUT" | grep -q 'derived=T-pinned' \
           && printf '%s\n' "$OUT" | grep -q 'exec_fd_bound=true'; then
          emit "PASS S7-classify baked-manifest ⇒ derived=T-pinned exec_fd_bound=true (offline bake == kernel measure)"
        else
          emit "FAIL S7-classify (baked digest did not derive T-pinned)"; s6fail=1
        fi
        printf '%s\n' "$OUT" | grep -q 'construct-at=T0 island=exec' \
          && emit "PASS S7-island-construct (exec surface opened for exactly one inode on the sealed kernel)" \
          || { emit "FAIL S7-island-construct (no construct-at=T0 island=exec, rc=$prc)"; s6fail=1; }
        for g in island-ran island-grant-mmap-exec-eperm island-grant-execve-denied; do
          printf '%s\n' "$OUT" | grep -q "^SHREK_GATE: PASS gate=$g" \
            && emit "PASS S7-$g" || { emit "FAIL S7-$g"; s6fail=1; }
        done

        # anti-spoof: the one-byte-different second verity inode is not pinned ⇒ T-hostile ⇒ no island is
        # constructed and the pinned bytes never run. Its T0 request is a downgrade-below-floor(T2)
        # refusal, so assert the DERIVED band on the always-printed provenance line, not the rc.
        OUT=$("$GK" sandbox --tier T0 --trust T-pinned --caps C-ro-nosec --profile C-ro-nosec \
                --id s7r --anchor "$SRV" --grant project -- "$PINMNT/rogue-probe" island "$SRV/project/evil" 2>&1)
        if printf '%s\n' "$OUT" | grep -q 'derived=T-hostile' \
           && ! printf '%s\n' "$OUT" | grep -q 'island=exec' \
           && ! printf '%s\n' "$OUT" | grep -q 'gate=island-ran'; then
          emit "PASS S7-antispoof rogue verity inode ⇒ T-hostile, no island, pinned bytes never ran"
        else
          emit "FAIL S7-antispoof"; s6fail=1
        fi
      else
        emit "FAIL S6 reason=enable-verity (sealed kernel/fs lacks fs-verity)"; s6fail=1
      fi
      umount "$PINMNT" 2>/dev/null
    else
      emit "FAIL S6 reason=losetup/mount"; s6fail=1
    fi
    [ -n "$PINLOOP" ] && losetup -d "$PINLOOP" 2>/dev/null
  else
    emit "FAIL S6 reason=mkfs-verity (ext4 -O verity unsupported on sealed kernel)"; s6fail=1
  fi
fi
[ "$s6fail" = 0 ] && emit "PASS S7 pin-exec-plane VM gate" || emit "FAIL S7 pin-exec-plane VM gate"
verdict_done=1

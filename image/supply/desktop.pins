# Desktop Bootstrap-0 version pins — mirrors image/supply/gvisor.pin intent.
# Consumed by scripts/build-desktop-layer.sh + scripts/desktop-smoke.sh.
# NEVER track main/latest in a real build — pin the EXACT tag. As with gvisor.pin, an AUTO
# resolution is permitted ONCE for bring-up; the resolved value is then recorded here.

[desktop]
distribution = "debian"
release      = "trixie"

[quickshell]
# Source-built (unpackaged in Debian). Mirror: github.com/quickshell-mirror/quickshell.
# Qt-runtime-coupled → must be compiled against the same Qt6 it will load (staged-binary delivery,
# NOT a portable supply-pin). See docs/desktop-bootstrap-0.md §Delivery.
repo           = "https://github.com/quickshell-mirror/quickshell"
quickshell_tag = "0fed22a2c47d9568ddf13cf61586b3f2ac4378a2" # Caelestia shell flake.lock pin; validated with Shrek I3/Sway flags

[uwsm]
# trixie-backports only (shell-architecture.md caveat); NOT a stable-suite guarantee.
# Not wired in Bootstrap 0 (no session/login stack yet) — pinned here for the next slice.
uwsm_suite   = "trixie-backports"
uwsm_version = "0.26.4"                # VERIFY at build

[wayland-protocols]
# quickshell v0.3.1 references the ext-background-effect STAGING protocol unconditionally
# (src/wayland/CMakeLists.txt:123), newer than the trixie wayland-protocols package ships. The build
# overlays newer XMLs into pkgdatadir before compiling quickshell (build-desktop-layer.sh); only the
# XML files are needed — trixie already satisfies the >=1.41 pkg-config version check.
source      = "https://gitlab.freedesktop.org/wayland/wayland-protocols"
overlay_tag = "1.49"                   # bring-up resolved 2026-08-21 (newest tag at first green smoke)

# Verified build deps (trixie, discovered by the green smoke run): qt6-base-private-dev,
# qt6-wayland-private-dev, qt6-shadertools-dev, libwayland-bin, libcli11-dev, libdrm-dev — on top of
# qt6-{base,declarative,wayland}-dev + qt6-declarative-private-dev + libwayland-dev.

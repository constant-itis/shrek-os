# Rust build output
/target
# Spike artifacts — image builds and throwaway signing keys never get committed
/build/
/out/
/keys/
*.raw
*.efi
*.img
# Overlay contents staged by build-in-container.sh STAGE 1 (release binaries + installed docs).
# Generated every build; the tracked source under image/overlay/ is only the systemd unit files.
/image/overlay/usr/libexec/
# M2: build-in-container.sh stages the on-PATH shrek/shrekctl symlinks here (into the gitignored
# usr/libexec binaries) — build products, not tracked source.
/image/overlay/usr/bin/
/image/overlay/usr/share/*
!/image/overlay/usr/share/dbus-1/
!/image/overlay/usr/share/dbus-1/system.d/
!/image/overlay/usr/share/dbus-1/system.d/bluetooth.conf
!/image/overlay/usr/share/dbus-1/system-services/
!/image/overlay/usr/share/dbus-1/system-services/org.bluez.service
# S7: per-build version input (build-in-container.sh writes it), and mkosi's local cache/output dirs.
/image/mkosi.version
/image/mkosi.cache/
/image/mkosi.output/
# S8: deliberately-broken build marker, staged only for BREAK=1 builds (never committed).
/image/overlay/usr/lib/shrek/boot-poison
# Phase-5 slice-8 (S6 gate): the sealed pin-manifest is BAKED at build time (build-in-container.sh
# writes gate-probe's fs-verity digest here). A build artifact, not source.
/image/overlay/usr/lib/shrek/pin-manifest
# Phase 2: the Shrek verity cert is staged from keys/ at build time (a build artifact, not source).
/image/overlay/usr/lib/verity.d/
# Phase-5 slice-6: the T2 gVisor ExtraTree (pinned runsc ~100MB + busybox rootfs), assembled at build
# time by scripts/seal-t2-artifacts.sh and sealed via 30-t2-gvisor.conf. Build artifact, not source.
/image/mkosi.extra.t2/
# Broadcom b43 Wi-Fi firmware: non-free blobs extracted from the Broadcom wl driver by
# scripts/stage-b43-firmware.sh (the reproducible recipe IS tracked). Opt-in real-hardware artifact.
/image/overlay/usr/lib/firmware/b43/
# Desktop Bootstrap-0: EPHEMERAL staged layer artifacts. ui/ is the source of record (staged into the
# overlay at build); the Quickshell binary + its Qt QML plugins are build products. The tracked overlay
# source is only the wrapper, sway.config, and layer marker.
/layers/shrek-desktop/overlay/usr/share/shrek/ui/
/layers/shrek-desktop/overlay/usr/bin/quickshell
/layers/shrek-desktop/overlay/usr/bin/qs
/layers/shrek-desktop/overlay/usr/lib/x86_64-linux-gnu/
/layers/shrek-desktop/overlay/usr/lib/qt6/
/layers/shrek-desktop/overlay/usr/share/qt6/
/layers/shrek-desktop/overlay/usr/share/quickshell/
/layers/shrek-desktop/overlay/usr/share/applications/
/layers/shrek-desktop/overlay/usr/share/icons/

# ADR-003 Part 2 step 6: the offline Bench "Scratch" seed (alpine+coreutils+ffmpeg+exit42) is a ~52M build
# product of scripts/build-bench-seed.sh (pinned base/pkgs; needs build-time network like every apt layer),
# NOT git history — same posture as the source-built quickshell binaries above. The exit42.elf helper
# (the rule-2 proof ELF + the negative-control artifact) IS tracked; only the built image tar + its digest
# sidecar are ignored.
/layers/shrek-bench/overlay/usr/share/shrek/bench/seeds/scratch.tar
/layers/shrek-bench/overlay/usr/share/shrek/bench/seeds/scratch.tar.digest
/layers/shrek-bench/overlay/usr/share/shrek/bench/seeds/debian.tar
/layers/shrek-bench/overlay/usr/share/shrek/bench/seeds/debian.tar.digest

# Dogfood-0 (M0): build-time systemd masks staged by DOGFOOD=1 (interactive image) — like boot-poison,
# these are build inputs, not tracked units (the real units live under image/overlay/usr/lib).
/image/overlay/etc/systemd/system/shrek-mount-gate.service
/image/overlay/etc/systemd/system/shrek-desktop-gate.service
# LIVE_INSTALLER-only mask (the live medium has no writable shrek-data disk to back /var/lib/swamp); the
# LIVE_INSTALLER branch stages it, every other variant removes it. Generated build input, not a tracked unit.
/image/overlay/etc/systemd/system/var-lib-swamp.mount
# Dogfood-0 (M1): DOGFOOD-only enable symlinks (home.mount + the persistence probe) — staged by
# DOGFOOD=1, removed on a normal build. The unit FILES under image/overlay/usr/lib are tracked source;
# only the .wants enablement is a build input (like the masks above). Scoped so the tracked symlinks in
# the same .wants dirs (shrek-onion, gatekeeperd, systemd-networkd, …) stay under version control.
/image/overlay/usr/lib/systemd/system/local-fs.target.wants/home.mount
# ADR-003 Part 2 step 3: the quota-retrofit + Bench pool sub-mount enable symlinks are staged in lockstep
# with home.mount (ride /home), so they are DOGFOOD/INSTALLABLE-gated the same way. The unit FILES are tracked.
/image/overlay/usr/lib/systemd/system/local-fs.target.wants/shrek-home-quota-prep.service
/image/overlay/usr/lib/systemd/system/local-fs.target.wants/shrek-bench-pool.service
# ADR-003 Part 2 step 5: boot re-issuance of Bench quotas + FS grants — same DOGFOOD/INSTALLABLE gating.
/image/overlay/usr/lib/systemd/system/local-fs.target.wants/shrek-bench-reissue.service
/image/overlay/usr/lib/systemd/system/multi-user.target.wants/shrek-dogfood-persist.service
# Bench authz slice step 4: the dev NOPASSWD placeholder is a build input staged ONLY for LIVE_INSTALLER
# (source of truth: image/live-installer/sudoers.d/dev-nopasswd); every other variant removes it. The
# DOGFOOD-only root debug-shell enable is staged the same way. Both gitignored so the tree stays byte-clean.
/image/overlay/etc/sudoers.d/dev-nopasswd
/image/overlay/usr/lib/systemd/system/multi-user.target.wants/debug-shell.service
# Owner-account provisioning (#2939): the first-boot wizard's ENABLEMENT is a build input staged ONLY for
# INSTALLABLE/DOGFOOD (source of truth: image/owner-provision/getty-owner-provision.conf + the env/seed
# written inline by build-in-container.sh). The oneshot unit + helper under image/overlay are tracked; only
# these generated copies are gitignored so LIVE_INSTALLER/plain-CI trees stay byte-clean. The DOGFOOD seed
# is a fixed PUBLIC test credential — it must NEVER be committed.
/image/overlay/etc/systemd/system/getty@tty1.service.d/50-owner-provision.conf
/image/overlay/etc/shrek/owner-provision.env
/image/overlay/etc/shrek/owner-seed
# Dogfood artifacts (generated VM definition + captured screenshots + the disposable oracle data disk;
# the daily persistent /home disk out/shrek-data.raw is also under out/ and never committed).
/out/dogfood-shrek.xml
/out/dogfood_VARS.fd
/out/dogfood-screen*.png
/out/dogfood-screen*.ppm
/out/dogfood-console.log
/out/dogfood-data.raw
/out/shrek-data.raw

# Vendored rEFInd loader staged by scripts/stage-refind.sh (build input, not source)
/layers/shrek-installer/overlay/usr/share/refind/

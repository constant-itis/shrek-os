# Rust build output
/target
# Spike artifacts — image builds and throwaway signing keys never get committed
/build/
/out/
/keys/
*.raw
*.efi
*.img
# Overlay contents staged by build-in-container.sh STAGE 1 (release binaries + installed docs).
# Generated every build; the tracked source under image/overlay/ is only the systemd unit files.
/image/overlay/usr/libexec/
/image/overlay/usr/share/
# S7: per-build version input (build-in-container.sh writes it), and mkosi's local cache/output dirs.
/image/mkosi.version
/image/mkosi.cache/
/image/mkosi.output/
# S8: deliberately-broken build marker, staged only for BREAK=1 builds (never committed).
/image/overlay/usr/lib/shrek/boot-poison
# Phase-5 slice-8 (S6 gate): the sealed pin-manifest is BAKED at build time (build-in-container.sh
# writes gate-probe's fs-verity digest here). A build artifact, not source.
/image/overlay/usr/lib/shrek/pin-manifest
# Phase 2: the Shrek verity cert is staged from keys/ at build time (a build artifact, not source).
/image/overlay/usr/lib/verity.d/
# Phase-5 slice-6: the T2 gVisor ExtraTree (pinned runsc ~100MB + busybox rootfs), assembled at build
# time by scripts/seal-t2-artifacts.sh and sealed via 30-t2-gvisor.conf. Build artifact, not source.
/image/mkosi.extra.t2/
# Desktop Bootstrap-0: EPHEMERAL staged layer artifacts. ui/ is the source of record (staged into the
# overlay at build); the Quickshell binary + its Qt QML plugins are build products. The tracked overlay
# source is only the wrapper, sway.config, and layer marker.
/layers/shrek-desktop/overlay/usr/share/shrek/ui/
/layers/shrek-desktop/overlay/usr/bin/quickshell
/layers/shrek-desktop/overlay/usr/lib/x86_64-linux-gnu/
/layers/shrek-desktop/overlay/usr/lib/qt6/
/layers/shrek-desktop/overlay/usr/share/qt6/
/layers/shrek-desktop/overlay/usr/share/quickshell/
/layers/shrek-desktop/overlay/usr/share/applications/
/layers/shrek-desktop/overlay/usr/share/icons/

# Shrek INSTALL-0 live session: keep the installer path minimal and deterministic.
# The normal desktop layer starts DMS and desktop portals; the live installer only needs Sway plus the
# welcome chooser and the Quickshell graphical installer it launches.
xwayland disable
output * bg /usr/share/shrek/installer/live-wallpaper.jpg fill
font pango:DejaVu Sans 10
default_border pixel 2
title_align left
client.focused          #7cc67a #14141a #e8e8e6 #7cc67a   #7cc67a
client.unfocused        #242429 #14141a #8a8a8a #242429   #242429
# Live session is USER-DRIVEN, not an auto-erase. shrek-live-welcome lets the user open GParted,
# a terminal, or start the install — the whole point of a live medium. Keybinds are an escape
# hatch if the chooser is closed. (Previously this auto-launched the erase picker with no way to
# reach gparted or decline — that defeated "live USB, decide by hand".)
set $mod Mod4
floating_modifier $mod
bindsym $mod+Return exec foot
bindsym $mod+w exec shrek-live-welcome
bindsym $mod+Shift+q kill
# shrek-live-welcome waits for the compositor itself and reads /run/shrek-live-autorun on its own,
# so the launch line stays simple (no fragile nested quoting).
exec sh -c 'exec shrek-live-welcome'

# "Try Shrek Desktop (live)" (#3110) — reload-swap seam. This glob is EMPTY on a normal boot (so the
# session above is just the chooser). When the user picks "Try Shrek Desktop (live)", shrek-live-welcome
# drops sway-try-desktop.config here and runs `swaymsg reload`; reload re-globs this include and pulls in
# the full DMS desktop (keybinds + surfaces + wallpaper). sway expands $XDG_RUNTIME_DIR (wordexp) and a
# zero-match glob is a no-op — the dir is the dev-writable tmpfs runtime dir, so no root/seed needed.
# Must be LAST: the fragment re-declares keybinds and they must win over the minimal live binds above.
include $XDG_RUNTIME_DIR/shrek-live.d/*.config

# Shrek INSTALL-0 live session: keep the installer path minimal and deterministic.
# The normal desktop layer starts DMS and desktop portals; the live installer only needs Sway and Calamares.
xwayland disable
output * bg /usr/share/shrek/installer/live-wallpaper.jpg fill
font pango:DejaVu Sans 10
default_border pixel 2
title_align left
client.focused          #7cc67a #14141a #e8e8e6 #7cc67a   #7cc67a
client.unfocused        #242429 #14141a #8a8a8a #242429   #242429
exec sh -c 'sleep 3; shrek-install-calamares'

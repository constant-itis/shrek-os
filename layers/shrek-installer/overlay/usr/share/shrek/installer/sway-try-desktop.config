# Shrek OS "Try Shrek Desktop (live)" fragment (#3110).
#
# NOT loaded on a normal live boot. shrek-live-welcome symlinks this into $XDG_RUNTIME_DIR/shrek-live.d/
# and runs `swaymsg reload` when the user chooses "Try Shrek Desktop (live)"; sway-live.config globs this
# dir, so the reload pulls this fragment in and the minimal chooser session becomes the full DMS desktop.
# Everything the live medium needs is already present (the installer store merges the desktop sysext:
# the dms binary, /usr/share/quickshell/dms, and the desktop sway.config), and /home is ephemeral (the
# home.mount mask + shrek-desktop's XDG->/run redirect), so the whole session is throwaway — decide, then
# install.

# Reuse the REAL desktop config verbatim (single source of truth for keybinds / surfaces / colours /
# wallpaper). This re-runs `output * bg .../desktop/wallpaper.jpg`, redefines every desktop keybind, and
# fires the exec_always shrek surfaces (shrek-menu / shrek-connectivity). Its plain `exec dms ...` and
# `exec shrek-boot-toast` do NOT run here: sway only re-runs exec_always on a reload, not exec — which is
# exactly why DMS is (re)launched below with exec_always instead of relying on that line.
include /usr/share/shrek/desktop/sway.config

# Launch DankMaterialShell. exec_always so the reload that pulls this fragment in actually starts it (the
# desktop config's own `exec dms` is inert on reload). The pgrep guard makes a later `$mod+Shift+c` reload
# a no-op instead of a second DMS. Mirrors the desktop config's dbus/systemd env import so D-Bus-activated
# portals inherit a usable Wayland env. ($SWAYSOCK etc. are already in sway's environment here.)
exec_always sh -c 'pgrep -x dms >/dev/null 2>&1 || { dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION GDK_BACKEND; systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION GDK_BACKEND; exec dms run -c /usr/share/quickshell/dms; }'

# One-shot welcome toast (real DMS notification): explains this is a throwaway trial and how to install.
# exec_always (fires on the reload that enters try-mode; the script self-guards against a repeat reload).
exec_always shrek-try-desktop-hello

# A way back OUT of the live desktop: $mod+i opens the graphical installer, $mod+w reopens the live
# chooser. (The desktop config binds neither, so this fragment is the only place they exist in try-mode.)
bindsym $mod+i exec shrek-install-ui
bindsym $mod+w exec shrek-live-welcome

#!/usr/bin/env bash
# Shrek OS INSTALL-0 launcher.
#
# INSTALL-0 is a whole-disk image writer, so target selection is Shrek-owned: we
# pick the disk here (Calamares' generic partition editor is bypassed) and hand
# the choice to the shrekdeploy job via SHREK_TARGET_DISK. Calamares then only
# runs the deploy + finished pages.
set -euo pipefail

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shrek-installer"
mkdir -p "$LOG_DIR"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LOG="$LOG_DIR/calamares-$STAMP.log"
DISK_LOG="$LOG_DIR/disks-$STAMP.log"

LIST_DISKS=/usr/libexec/shrek/shrek-list-disks

kmsg() {
    if sudo -n true >/dev/null 2>&1; then
        sudo -n sh -c 'printf "%s\n" "$1" > /dev/kmsg' _ "$1" 2>/dev/null || true
    fi
    printf '%s\n' "$1"
}

kmsg "shrek-install-calamares: enumerating install targets"

# Capture block topology up front so a stuck selection is diagnosable from logs.
"$LIST_DISKS" --diagnose >"$DISK_LOG" 2>&1 || true

# Enumerate erasable whole disks (excludes live media, layer store, payload,
# and any already-installed Shrek disk).
mapfile -t DISK_ROWS < <("$LIST_DISKS" 2>>"$DISK_LOG" || true)
kmsg "shrek-install-calamares: ${#DISK_ROWS[@]} eligible target(s)"

if [ "${#DISK_ROWS[@]}" -eq 0 ]; then
    kmsg "shrek-install-calamares: no eligible target disk found"
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --width=420 \
            --title="Shrek OS Installer" \
            --text="No eligible target disk was found.\n\nAttach a blank disk to install onto, then relaunch the installer." || true
    fi
    exit 1
fi

TARGET_DISK=""
if command -v zenity >/dev/null 2>&1 && [ "${#DISK_ROWS[@]}" -ge 1 ]; then
    # Build the radiolist: <selected> <path> <size> <model> per row.
    args=()
    first=TRUE
    while IFS=$'\t' read -r path size model; do
        [ -n "$path" ] || continue
        args+=("$first" "$path" "$size" "${model:-disk}")
        first=FALSE
    done < <(printf '%s\n' "${DISK_ROWS[@]}")

    TARGET_DISK="$(zenity --list --radiolist --width=560 --height=340 \
        --title="Shrek OS Installer" \
        --text="Select the disk to <b>ERASE</b> and install Shrek OS onto." \
        --column="" --column="Disk" --column="Size" --column="Model" \
        --print-column=2 \
        "${args[@]}" 2>/dev/null || true)"

    if [ -z "$TARGET_DISK" ]; then
        kmsg "shrek-install-calamares: disk selection cancelled"
        exit 0
    fi

    zenity --question --width=460 \
        --title="Shrek OS Installer" \
        --text="This will <b>ERASE ALL DATA</b> on:\n\n    $TARGET_DISK\n\nand install Shrek OS. Continue?" \
        --ok-label="Erase and Install" --cancel-label="Go Back" 2>/dev/null || {
        kmsg "shrek-install-calamares: erase confirmation declined"
        exit 0
    }
else
    # No zenity available: only proceed if the choice is unambiguous.
    if [ "${#DISK_ROWS[@]}" -eq 1 ]; then
        TARGET_DISK="$(printf '%s' "${DISK_ROWS[0]}" | cut -f1)"
        kmsg "shrek-install-calamares: zenity absent, auto-selecting sole target $TARGET_DISK"
    else
        kmsg "shrek-install-calamares: zenity absent and multiple disks eligible; refusing to guess"
        exit 1
    fi
fi

kmsg "shrek-install-calamares: launching calamares (target=$TARGET_DISK)"

run_calamares() {
    "$@" env \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}" \
        SHREK_TARGET_DISK="$TARGET_DISK" \
        /usr/bin/calamares -c /usr/share/shrek/installer/calamares -D8 2>&1 | tee "$LOG"
}

if sudo -n true >/dev/null 2>&1; then
    run_calamares sudo -n
elif command -v pkexec >/dev/null 2>&1; then
    run_calamares pkexec
else
    run_calamares sudo
fi

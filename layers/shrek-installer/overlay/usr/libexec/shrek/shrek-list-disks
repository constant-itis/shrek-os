#!/bin/sh
# Shrek OS INSTALL-0 target-disk lister.
#
# INSTALL-0 is a whole-disk image writer, not a partition editor, so target
# selection is Shrek-owned rather than derived from Calamares' generic partition
# module. This helper enumerates the whole disks that are safe to erase and emits
# them one per line as:  PATH<TAB>SIZE<TAB>MODEL
#
# A disk is INELIGIBLE when it (or any of its children) is part of the running
# live system: it backs a live mount, carries a Shrek/ESP partition or filesystem
# label (live media, layer store, install payload, or a previously installed
# Shrek disk), or is a read-only medium. Everything else is a candidate target.
#
# `--diagnose` dumps the raw block topology instead, for install logs.
#
# lsblk/findmnt can be overridden via SHREK_LSBLK / SHREK_FINDMNT so the filter
# logic can be exercised headlessly against fixtures (see
# scripts/install0-diskpick-proof.sh).
set -eu

LSBLK="${SHREK_LSBLK:-lsblk}"
FINDMNT="${SHREK_FINDMNT:-findmnt}"

if [ "${1:-}" = "--diagnose" ]; then
    echo "== lsblk =="
    "$LSBLK" -o NAME,PATH,SIZE,TYPE,RO,MOUNTPOINTS,PARTLABEL,LABEL,MODEL 2>&1 || true
    echo "== findmnt =="
    "$FINDMNT" -rn -o TARGET,SOURCE 2>&1 || true
    exit 0
fi

# Snapshot the block topology once. One row per device (disks and partitions).
# NB: no PATH column - lsblk -P emits it as PATH="..." and `eval` would clobber
# the shell's own $PATH; we derive /dev/NAME instead.
rows="$("$LSBLK" -P -b -o NAME,PKNAME,TYPE,RO,MOUNTPOINT,PARTLABEL,LABEL,SIZE,MODEL)"

# A label that marks a disk as off-limits. ONLY the install SOURCE marker (shrek-payload) protects by
# label: it exists solely on the live installer medium, never on an installed target. A previously-installed
# Shrek disk carries ESP / shrek_1 / shrek-layers / shrek-data labels too, but those MUST stay erasable so
# the machine can be reinstalled from the GUI (otherwise the picker shows "no eligible disk" on any box that
# already has Shrek). The live medium is still fully protected by shrek-payload plus the read-only and
# root-backing rules below.
is_reserved_label() {
    case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in
        shrek-payload) return 0 ;;
        *) return 1 ;;
    esac
}

base_of() {
    # Base whole-disk name for a row: itself if a disk, else its parent.
    if [ "$2" = disk ]; then
        printf '%s' "$1"
    elif [ -n "$3" ]; then
        printf '%s' "$3"
    else
        printf '%s' "$1"
    fi
}

# Pass 1 - collect the set of protected base disks.
protected=" "
while IFS= read -r line; do
    [ -n "$line" ] || continue
    NAME=; PKNAME=; TYPE=; RO=; MOUNTPOINT=; PARTLABEL=; LABEL=
    eval "$line"
    base="$(base_of "$NAME" "$TYPE" "$PKNAME")"
    reserve=0
    # A mount at a SYSTEM path protects the disk (the running live medium mounts at /, /usr, /run/shrek/*).
    # A courtesy auto-mount of a secondary/target disk under /media or /run/media does NOT protect it — the
    # target must stay selectable for reinstall, and the writer unmounts it before erasing. /home is also
    # non-protective: the live installer has no legitimate persistent /home, so a /home mount can only be a
    # spurious by-label grab of a previously-installed target's shrek-data (defense-in-depth alongside the
    # LIVE_INSTALLER home.mount mask).
    case "$MOUNTPOINT" in
        ""|/media/*|/run/media/*|/home|/home/*) ;;
        *) reserve=1 ;;
    esac
    [ "$RO" = 1 ] && reserve=1
    is_reserved_label "$PARTLABEL" && reserve=1
    is_reserved_label "$LABEL" && reserve=1
    if [ "$reserve" = 1 ]; then
        case "$protected" in
            *" $base "*) ;;
            *) protected="$protected$base " ;;
        esac
    fi
done <<EOF
$rows
EOF

# The disk backing "/" is always protected, even if the mount rule missed it
# (dm-verity/mapper indirection can hide the parent chain).
root_src="$("$FINDMNT" -rn -o SOURCE / 2>/dev/null || true)"
if [ -n "$root_src" ]; then
    root_base="$("$LSBLK" -ndo PKNAME "$root_src" 2>/dev/null | head -1 || true)"
    [ -z "$root_base" ] && root_base="$(basename "$root_src" 2>/dev/null || true)"
    if [ -n "$root_base" ]; then
        case "$protected" in
            *" $root_base "*) ;;
            *) protected="$protected$root_base " ;;
        esac
    fi
fi

# Pass 2 - emit eligible whole disks.
while IFS= read -r line; do
    [ -n "$line" ] || continue
    NAME=; TYPE=; SIZE=; MODEL=
    eval "$line"
    [ "$TYPE" = disk ] || continue
    case "$protected" in
        *" $NAME "*) continue ;;
    esac
    # Skip empty removable slots (card readers etc.) that report zero size.
    [ "${SIZE:-0}" -gt 0 ] 2>/dev/null || continue
    human="$(printf '%s' "${SIZE:-0}" | awk '{ b=$1; u="B"; s["1"]="KB"; s["2"]="MB"; s["3"]="GB"; s["4"]="TB"; i=0; while (b>=1024 && i<4){ b=b/1024; i++ } if(i>0)u=s[i""]; printf (b==int(b) ? "%d%s" : "%.1f%s"), b, u }')"
    printf '/dev/%s\t%s\t%s\n' "$NAME" "$human" "${MODEL:-}"
done <<EOF
$rows
EOF

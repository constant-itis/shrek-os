#!/bin/sh
# shrek-desktop — Bootstrap-0 desktop session launcher.
#
# Sets the minimum Wayland env and execs Sway; Sway's config execs DMS, which owns the ordinary desktop
# shell surfaces (bar / launcher / settings / control center). This is deliberately NOT a full login/session stack (no
# greetd, no UWSM) — Bootstrap 0 proves the runtime, not the login flow. The caller may override any
# env (the desktop smoke test sets the headless/software path).
set -eu

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-sway}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-sway}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export DESKTOP_SESSION="${DESKTOP_SESSION:-sway}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# The sealed headless proof runs without a persistent /home. Give DMS writable XDG dirs there while
# leaving the dogfood login's real persistent home alone.
if [ -n "${HOME:-}" ] && [ ! -w "$HOME" ]; then
  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$XDG_RUNTIME_DIR/cache}"
  export XDG_STATE_HOME="${XDG_STATE_HOME:-$XDG_RUNTIME_DIR/state}"
  export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$XDG_RUNTIME_DIR/config}"
  mkdir -p "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" 2>/dev/null || true
fi

# The sealed/headless gate passes QT_QUICK_BACKEND=software explicitly. Leave interactive dogfood sessions
# on Qt's normal renderer; DMS relies heavily on animated translucent Qt Quick surfaces, and forcing the
# software scenegraph in a graphical VM can make hover/reveal layers repaint inconsistently.
if [ "${WLR_BACKENDS:-}" = "headless" ]; then
  export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"
fi

# Icon theme: the sealed image has no /etc gtk config, so point Qt's generic theme at a gtk settings
# file baked in /usr (sysext-friendly) via XDG_CONFIG_DIRS. This makes QIcon::fromTheme (Quickshell's
# image://icon provider) resolve real app icons from Papirus-Dark instead of a placeholder.
export XDG_CONFIG_DIRS="/usr/share/shrek/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"

if [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/settings.json" ] && [ -r /usr/share/shrek/dms/default-settings.json ]; then
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell" 2>/dev/null || true
  cp /usr/share/shrek/dms/default-settings.json "${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/settings.json" 2>/dev/null || true
fi

if [ ! -e "${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell/session.json" ] && [ -r /usr/share/shrek/dms/default-session.json ]; then
  mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell" 2>/dev/null || true
  cp /usr/share/shrek/dms/default-session.json "${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell/session.json" 2>/dev/null || true
fi

# S5 dynamic theming — make foot follow the palette. (1) Seed the user matugen config first-run so
# `dms matugen queue` (runUserMatugenTemplates=true) regenerates ~/.local/state/shrek/foot-colors.ini
# from the wallpaper on every theme change. (2) Seed an INITIAL foot-colors.ini so foot.ini's
# `include=` is never missing — foot refuses to start otherwise (before matugen's first pass). Both
# are first-run-only; a user-edited config is left alone.
_shrek_matugen_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/config.toml"
if [ ! -e "$_shrek_matugen_cfg" ] && [ -r /usr/share/shrek/matugen/config.toml ]; then
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/matugen" 2>/dev/null || true
  cp /usr/share/shrek/matugen/config.toml "$_shrek_matugen_cfg" 2>/dev/null || true
fi
_shrek_foot_colors="${XDG_STATE_HOME:-$HOME/.local/state}/shrek/foot-colors.ini"
if [ ! -e "$_shrek_foot_colors" ] && [ -r /usr/share/shrek/matugen/foot-colors.default.ini ]; then
  mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/shrek" 2>/dev/null || true
  cp /usr/share/shrek/matugen/foot-colors.default.ini "$_shrek_foot_colors" 2>/dev/null || true
fi

# Self-heal existing installs. The seeds above are first-run-only, so a /home created before a given
# default existed keeps the stale value. Three heals, one atomic in-place rewrite (python3 from the base
# image; skipped harmlessly if absent):
#   (1) WALLPAPER — a blank wallpaperPath makes DMS paint its fallback background OVER the swamp sway
#       draws (the double-owner conflict: swamp flashes, then the flat pattern covers it). Backfill the
#       Shrek swamp so the two agree. Only EMPTY fields are touched — a user-chosen wallpaper is kept.
#   (2) WEATHER LOCATION — a /home predating the Florida seed keeps DankMaterialShell's built-in
#       New York default, so weather + the forecast are wrong out of the box and can't be fixed via the
#       (egress-blocked) IP auto-locate. Heal to the sealed default location read from default-session.json
#       ONLY when the session still holds the untouched "New York, NY" default (or has none) — any city
#       the user actually chose is left alone. The canonical values come from the seed file, never
#       duplicated here.
#   (3) IP GEOLOCATION — night-mode IP lookup needs ip-api.com over plaintext HTTP:80, which the desktop
#       egress policy permanently refuses; a stale `true` just makes DMS retry a blocked host forever, so
#       normalize it off.
_shrek_sess="${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell/session.json"
if [ -w "$_shrek_sess" ] && command -v python3 >/dev/null 2>&1; then
  SHREK_WP=/usr/share/shrek/desktop/wallpaper.jpg \
  SHREK_SEED=/usr/share/shrek/dms/default-session.json \
  python3 - "$_shrek_sess" <<'PY' 2>/dev/null || true
import json, os, sys
path, wp = sys.argv[1], os.environ["SHREK_WP"]
try:
    data = json.load(open(path))
except Exception:
    sys.exit(0)
changed = False

# (1) wallpaper — only empty fields
for key in ("wallpaperPath", "wallpaperPathDark", "wallpaperPathLight"):
    if not data.get(key):
        data[key] = wp
        changed = True

# (2) weather location — replace ONLY the untouched DMS New York default with the sealed seed
try:
    seed = json.load(open(os.environ.get("SHREK_SEED", "")))
except Exception:
    seed = {}
loc = data.get("weatherLocation")
untouched = (not loc) or str(loc).strip().lower() == "new york, ny"
if untouched and seed:
    for key in ("weatherLocation", "weatherCoordinates", "latitude", "longitude"):
        if key in seed and data.get(key) != seed[key]:
            data[key] = seed[key]
            changed = True

# (3) IP geolocation can never succeed on the sealed desktop — normalize it off
if data.get("nightModeUseIPLocation"):
    data["nightModeUseIPLocation"] = False
    changed = True

if changed:
    tmp = path + ".shrek.tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
    os.replace(tmp, path)
PY
fi

if [ -e /usr/share/shrek/installer/live-mode ]; then
  export DMS_DISABLE_MATUGEN="${DMS_DISABLE_MATUGEN:-1}"
fi

sway_config=/usr/share/shrek/desktop/sway.config
if [ -r /usr/share/shrek/installer/sway-live.config ]; then
  sway_config=/usr/share/shrek/installer/sway-live.config
fi

exec sway -c "$sway_config" "$@"

#!/bin/sh
# shrek-desktop — Bootstrap-0 desktop session launcher.
#
# Sets the minimum Wayland env and execs Sway; Sway's config execs Quickshell, which owns ALL shell
# surfaces (bar / launcher / work-drawer). This is deliberately NOT a full login/session stack (no
# greetd, no UWSM) — Bootstrap 0 proves the runtime, not the login flow. The caller may override any
# env (the desktop smoke test sets the headless/software path).
set -eu

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Render backend. The Caelestia.Blobs shell geometry is a custom QSGMaterial shader; Qt Quick's
# "software" scenegraph backend CANNOT paint custom shaders (the whole blob frame renders as nothing),
# so we run the RHI/OpenGL backend over Mesa's llvmpipe — software GL that needs NO GPU hardware, so
# the shell stays GPU-free while still executing the blob shaders. QSG_RENDER_LOOP=basic avoids an
# llvmpipe crash in Qt's threaded render loop. Every var is overridable so the smoke/headless gates
# (and a future real-GPU path) can set their own.
unset QT_QUICK_BACKEND 2>/dev/null || true
export QSG_RHI_BACKEND="${QSG_RHI_BACKEND:-opengl}"
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"
export QSG_RENDER_LOOP="${QSG_RENDER_LOOP:-basic}"

# QML import path. The GPLv3 Caelestia.Blobs module (the shell's frame/panel geometry) is staged into
# /usr/lib/qt6/qml by scripts/build-desktop-layer.sh, but Debian's Qt6 only scans the multiarch dir
# (/usr/lib/x86_64-linux-gnu/qt6/qml) by default, so without this the shell fails to load with
# "module Caelestia.Blobs is not installed" and nothing renders. Add our staging dir explicitly.
export QML_IMPORT_PATH="/usr/lib/qt6/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QML2_IMPORT_PATH="$QML_IMPORT_PATH"

# Icon theme: the sealed image has no /etc gtk config, so point Qt's generic theme at a gtk settings
# file baked in /usr (sysext-friendly) via XDG_CONFIG_DIRS. This makes QIcon::fromTheme (Quickshell's
# image://icon provider) resolve real app icons from Papirus-Dark instead of a placeholder.
export XDG_CONFIG_DIRS="/usr/share/shrek/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"

exec sway -c /usr/share/shrek/desktop/sway.config "$@"

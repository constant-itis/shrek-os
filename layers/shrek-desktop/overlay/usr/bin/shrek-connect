#!/bin/sh
# shrek-connect — hook a model provider up to YOUR broker's address (ADR-008: root-mediated, no sudo).
#
# Shrek OS ships with NO model wired. The sealed image carries the agent-launch UX and the sealed egress
# NAMES (shrek-model, shrek-model-proxy, shrek-claude-cli, shrek-codex-cli) but no ADDRESS for any of them
# — so ONE image is universal and nobody's homelab is baked into everyone's OS. This command is the
# hook-up: it binds a sealed name to an IPv4 YOU choose.
#
# ADR-008 (#3121 fix): shrek-connect NO LONGER writes /etc/hosts itself. The old design chowned the hosts
# store to uid 1000, handing a compromised desktop user name-resolution authority over every root daemon.
# Now ROOT owns /etc/hosts; this command sends a NARROW, closed-token request over the egressd supervisor
# socket (`egressd ask bind <provider> <ipv4>`), and root composes /run/shrek/hosts. No sudo — the
# socket's SO_PEERCRED gate is the authority; a uid-1000 process can only ever name the 4 model providers,
# never an NTP/CA/public host. The address must be an IPv4 LITERAL (glibc NSS `files` needs a literal; a
# hostname line is silently skipped — ADR-008 §1c).
#
#   shrek-connect <provider> <ipv4>     bind the provider's broker to an IPv4 address
#   shrek-connect --list                show every provider's sealed name + current binding
#   shrek-connect --forget <provider>   remove a binding (back to unwired)
#
#   provider ids: local | anthropic | claude | codex
#   `local` is the no-credential path (your own OpenAI-wire model server); the rest need a broker.
set -eu

# The egressd binary (not on PATH — it lives in libexec). SHREK_EGRESSD lets a proof point at an
# oracle-env build; the sealed image uses the real one.
EGRESSD="${SHREK_EGRESSD:-/usr/libexec/shrek/egressd}"
# The world-readable root projection `--list` reads (root:root 0644). Overridable for a proof fixture.
PROJECTION="${SHREK_HOSTS:-/run/shrek/hosts}"
PROVIDERS="local anthropic claude codex"

# provider -> the sealed egress HOST NAME it resolves (crates/shrek-policy provider_bind / egress). Kept
# for the `--list` DISPLAY only — the bind/unbind path sends the TOKEN and the daemon maps it server-side
# (the single source of truth). The dogfood S-connect group cross-checks this map against the policy.
host_for() {
    case "$1" in
        local)     echo "shrek-model" ;;
        anthropic) echo "shrek-model-proxy" ;;
        claude)    echo "shrek-claude-cli" ;;
        codex)     echo "shrek-codex-cli" ;;
        *) return 1 ;;
    esac
}
# loop var is _p, NOT p (POSIX sh has no function-local scope; a `for p` would clobber the caller's `p`).
valid_provider() { for _p in $PROVIDERS; do [ "$1" = "$_p" ] && return 0; done; return 1; }

cmd="${1:-}"
case "$cmd" in
    ''|-h|--help)
        cat >&2 <<EOF
usage:
  shrek-connect <provider> <ipv4>     bind a provider to your broker address
  shrek-connect --list                show current bindings
  shrek-connect --forget <provider>   remove a binding
  provider ids: $PROVIDERS
EOF
        [ -z "$cmd" ] && exit 1 || exit 0 ;;
    --list|list|show)
        # Read the ROOT-owned projection and show each provider's sealed name + bound IPv4 (if any).
        for p in $PROVIDERS; do
            h="$(host_for "$p")"
            # projection lines are `<ipv4> <sealed-host>`; find this host's address.
            a="$(awk -v h="$h" '$2==h {print $1; exit}' "$PROJECTION" 2>/dev/null || true)"
            printf '%-10s %-18s %s\n' "$p" "$h" "${a:-<not connected>}"
        done
        exit 0 ;;
    --forget|forget)
        shift; p="${1:-}"
        valid_provider "$p" || { echo "shrek-connect: unknown provider '$p' (want: $PROVIDERS)" >&2; exit 2; }
        # Root-mediated removal over the supervisor socket (idempotent).
        if "$EGRESSD" ask unbind "$p" >/dev/null; then
            echo "shrek-connect: $p ($(host_for "$p")) disconnected"; exit 0
        fi
        echo "shrek-connect: could not reach the egress supervisor to disconnect '$p'." >&2
        echo "  (is the desktop session up? the egressd bless supervisor serves the hook-up socket.)" >&2
        exit 1 ;;
    *)
        p="$cmd"; shift; addr="${1:-}"
        valid_provider "$p" || { echo "shrek-connect: unknown provider '$p' (want: $PROVIDERS)" >&2; exit 2; }
        [ -n "$addr" ] || { echo "shrek-connect: need an IPv4 address — shrek-connect $p <ipv4>" >&2; exit 2; }
        # Root-mediated bind over the supervisor socket. egressd validates the token (closed set) + the
        # address (strict IPv4 literal) and composes /run/shrek/hosts; a bad address is refused there.
        if "$EGRESSD" ask bind "$p" "$addr" >/dev/null; then
            echo "shrek-connect: $p ($(host_for "$p")) -> $addr"; exit 0
        fi
        rc=$?
        if [ "$rc" = 2 ]; then
            echo "shrek-connect: could not reach the egress supervisor (is the desktop session up?)." >&2
        else
            echo "shrek-connect: '$addr' was refused — the address must be an IPv4 literal (e.g. 192.168.1.152)." >&2
        fi
        exit 1 ;;
esac

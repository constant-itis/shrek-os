# Shrek Desktop Bootstrap-0 — minimal Sway config.
#
# Quickshell owns ALL shell surfaces, so Sway draws no bar and defines almost no UX. Only:
#   - autostart Quickshell against the shell entry point
#   - one terminal spawn + one logout binding
# Later slices add the real session/keybind/output config.

set $mod Mod4

# Quickshell is the ONLY autostart — it draws the bar, launcher placeholder, and Work drawer.
# Entry is the config-root ui/shell.qml (see the comment in that file re: config-folder scoping).
exec quickshell -p /usr/share/shrek/ui/shell.qml

# Minimal keybinds.
bindsym $mod+Return exec foot
bindsym $mod+Shift+e exit

# No default Sway bar (Quickshell provides the bar).
bar {
    mode invisible
}

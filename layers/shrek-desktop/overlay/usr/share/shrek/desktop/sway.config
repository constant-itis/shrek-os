# Shrek Desktop — Sway config (DMS-BOOT-0).
#
# Sway remains the compositor; DankMaterialShell owns the ordinary desktop shell. Keep this upstream-ish:
# start DMS, wire DMS IPC keybinds, and do not add Shrek Work/authority UI yet.

set $mod Mod4

# No Xwayland: the desktop ships none, and disabling it keeps the sealed desktop-gate log clean.
xwayland disable

# Shrek swamp wallpaper; live installer overrides belong in the installer sysext's wrapper config.
output * bg /usr/share/shrek/desktop/wallpaper.jpg fill
gaps inner 10
gaps outer 8
font pango:DejaVu Sans 10
default_border pixel 2
title_align left
client.focused          #7cc67a #14141a #e8e8e6 #7cc67a   #7cc67a
client.unfocused        #242429 #14141a #8a8a8a #242429   #242429
client.focused_inactive #242429 #14141a #8a8a8a #242429   #242429

# DMS is the ONLY shell autostart. Import the session environment first so D-Bus-activated portal
# services inherit a usable Wayland desktop env even if DMS asks for portals immediately.
exec sh -c 'dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION GDK_BACKEND; systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION GDK_BACKEND; exec dms run'

# shrek-menu (SPIKE) — a shrek-OWNED standalone Quickshell surface, launched ALONGSIDE dms (NOT a DMS
# plugin; NOT spliced into DMS's instance). It sits hidden until toggled. Its IPC target is scoped to
# THIS qs instance, so the toggle bind addresses it via `qs -p <this file>`, never `dms ipc`. exec_always
# so a sway `reload` respawns it; -n makes a second launch a no-op instead of a duplicate.
exec_always qs -p /usr/share/shrek/dms/shrek-menu/shell.qml -n

### apps / shell surfaces ###
bindsym $mod+Return exec foot --font="DejaVu Sans Mono:size=11"
bindsym $mod+space exec dms ipc call spotlight toggle
bindsym $mod+v exec dms ipc call clipboard toggle
bindsym $mod+m exec dms ipc call processlist focusOrToggle
bindsym $mod+comma exec dms ipc call settings focusOrToggle
bindsym $mod+n exec dms ipc call notifications toggle
# Launch a walled coding agent (L4 shrek-agent -> shrek run -> T2 wall). --pick chooses+persists a provider.
bindsym $mod+a exec foot --app-id=shrek.agent sh -c 'shrek-agent --pick'
# shrek-menu (SPIKE): toggle the shrek-owned command surface. Addresses ITS qs instance by config path
# (NOT `dms ipc` — that only reaches DMS's own instance).
bindsym $mod+slash exec qs -p /usr/share/shrek/dms/shrek-menu/shell.qml ipc call shrek-menu toggle
# Alt fallbacks (a host compositor can swallow Super before the guest sees it).
bindsym Mod1+Return exec foot --font="DejaVu Sans Mono:size=11"
bindsym Mod1+space exec dms ipc call spotlight toggle
bindsym Mod1+v exec dms ipc call clipboard toggle
bindsym Mod1+m exec dms ipc call processlist focusOrToggle
bindsym Mod1+comma exec dms ipc call settings focusOrToggle
bindsym Mod1+n exec dms ipc call notifications toggle
bindsym Mod1+a exec foot --app-id=shrek.agent sh -c 'shrek-agent --pick'
bindsym Mod1+slash exec qs -p /usr/share/shrek/dms/shrek-menu/shell.qml ipc call shrek-menu toggle

### window management ###
bindsym $mod+q kill
bindsym Mod1+q kill
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+b splith
bindsym $mod+Shift+v splitv
focus_follows_mouse yes
floating_modifier $mod normal
tiling_drag enable
bindsym --whole-window $mod+button2 kill

# focus (arrows + vim keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### workspaces ###
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym Mod1+1 workspace number 1
bindsym Mod1+2 workspace number 2
bindsym Mod1+3 workspace number 3
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3

### hardware keys ###
bindsym XF86AudioRaiseVolume exec dms ipc call audio increment 3
bindsym XF86AudioLowerVolume exec dms ipc call audio decrement 3
bindsym XF86AudioMute exec dms ipc call audio mute
bindsym XF86MonBrightnessUp exec dms ipc call brightness increment 5
bindsym XF86MonBrightnessDown exec dms ipc call brightness decrement 5
# Keyboard backlight (Apple F5/F6 → XF86KbdBrightness*). No DMS IPC for kbd backlight, so drive the SMC
# LED directly via brightnessctl (in base; its udev rule grants the `video` group — dev is in it — write
# access to the leds subsystem). Resolve the LED by glob so it works regardless of the exact applesmc name
# (smc::kbd_backlight / apple::kbd_backlight). Real-Mac only: no kbd-backlight LED exists in the VM, so
# this is inert there (the glob finds nothing). Hard-coding %+/%- steps; brightnessctl clamps at the ends.
bindsym XF86KbdBrightnessUp   exec sh -c 'd=$(ls -d /sys/class/leds/*kbd_backlight 2>/dev/null | head -1); [ -n "$d" ] && brightnessctl -d "$(basename "$d")" set 10%+'
bindsym XF86KbdBrightnessDown exec sh -c 'd=$(ls -d /sys/class/leds/*kbd_backlight 2>/dev/null | head -1); [ -n "$d" ] && brightnessctl -d "$(basename "$d")" set 10%-'

### session ###
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

# Shrek Desktop — Sway config (shell-v2).
#
# Quickshell owns every shell surface (rail / frame / panel); Sway only does compositor operability —
# workspaces, window management, focus, launching. Surface visibility is toggled by asking Quickshell
# over its IPC socket (`quickshell ipc call <target> <function>`), so keybinds and shell state stay in
# one place. Keybinds are trimmed to what shell-v2 actually implements today; more get added as the
# corresponding surfaces land.

set $mod Mod4

# No Xwayland: the desktop ships none, and disabling it keeps the sealed desktop-gate log clean.
xwayland disable

# Organic swamp wallpaper; the rail reserves its width via layer-shell exclusion, the desktop frame
# (surfaces/Frame.qml) draws its inset border in the outer gap.
output * bg /usr/share/shrek/desktop/wallpaper.png fill
gaps inner 10
gaps outer 8
font pango:DejaVu Sans 10
default_border pixel 2
title_align left
client.focused          #7cc67a #14141a #e8e8e6 #7cc67a   #7cc67a
client.unfocused        #242429 #14141a #8a8a8a #242429   #242429
client.focused_inactive #242429 #14141a #8a8a8a #242429   #242429

# Quickshell is the ONLY autostart — it draws every surface. Entry is the config-root shell.qml.
exec quickshell -p /usr/share/shrek/ui/shell.qml

### apps / shell surfaces ###
bindsym $mod+Return exec foot --font="DejaVu Sans Mono:size=11"
bindsym $mod+space exec quickshell ipc call ui toggle
# Alt fallbacks (a host compositor can swallow Super before the guest sees it).
bindsym Mod1+Return exec foot --font="DejaVu Sans Mono:size=11"
bindsym Mod1+space exec quickshell ipc call ui toggle

### window management ###
bindsym $mod+q kill
bindsym Mod1+q kill
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+b splith
bindsym $mod+v splitv
focus_follows_mouse yes
floating_modifier $mod normal
tiling_drag enable
bindsym --whole-window $mod+button2 kill

# focus (arrows + vim keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### workspaces ###
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym Mod1+1 workspace number 1
bindsym Mod1+2 workspace number 2
bindsym Mod1+3 workspace number 3
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3

### hardware keys ###
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### session ###
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

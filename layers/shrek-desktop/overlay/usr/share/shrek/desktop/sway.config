# Shrek Desktop — Sway config (Desktop Slice 1).
#
# Quickshell owns ALL shell surfaces (bar / launcher / drawers / notifications / OSD), so Sway draws no
# bar and defines no chrome beyond window management. Sway's job here is compositor operability:
# workspaces, window management, focus, and launching. Drawer visibility is toggled by asking Quickshell
# over its IPC socket (`quickshell ipc call <target> <function>`), so the keybinds and the shell stay in
# one place.

set $mod Mod4

# No Xwayland: the desktop ships none, and disabling it keeps the sealed desktop-gate log clean
# (otherwise Sway logs a benign `Cannot find Xwayland binary` [ERROR] the qs-load scan would trip on).
xwayland disable

# Calm, layered look — organic swamp wallpaper; small gaps; thin accent border.
output * bg /usr/share/shrek/desktop/wallpaper.png fill
gaps inner 10
default_border pixel 2
# class                 border  bg      text    indicator child_border
client.focused          #5aa02c #101014 #e8e8e6 #5aa02c   #5aa02c
client.unfocused        #2a2a2e #101014 #8a8a8a #2a2a2e   #2a2a2e
client.focused_inactive #2a2a2e #101014 #8a8a8a #2a2a2e   #2a2a2e

# Quickshell is the ONLY autostart — it draws every surface. Entry is the config-root ui/shell.qml.
exec quickshell -p /usr/share/shrek/ui/shell.qml

### apps / shell surfaces ###
# Force the monospace font: bare `foot` resolves "monospace" -> DejaVu Sans (proportional) because the
# minimal image ships no fontconfig generic-alias config. Point it at DejaVu Sans Mono (fonts-dejavu-core).
bindsym $mod+Return exec foot --font="DejaVu Sans Mono:size=11"
bindsym $mod+d exec quickshell ipc call launcher toggle
bindsym $mod+w exec quickshell ipc call work toggle
bindsym $mod+s exec quickshell ipc call system toggle

### window management ###
bindsym $mod+q kill
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+b splith
bindsym $mod+v splitv

# focus (arrows + vim keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

### workspaces ###
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

### hardware keys (drive the OSD in a later phase) ###
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### Alt fallback modifier ###
# A host compositor (e.g. Pop!_OS) can swallow the Super key before the guest sees it. These Alt
# duplicates keep the shell operable from the keyboard regardless (mouse affordances on the bar cover
# launcher/terminal too). Ordinary letters/Enter/arrows always reach the focused guest window.
bindsym Mod1+Return exec foot --font="DejaVu Sans Mono:size=11"
bindsym Mod1+d exec quickshell ipc call launcher toggle
bindsym Mod1+w exec quickshell ipc call work toggle
bindsym Mod1+s exec quickshell ipc call system toggle
bindsym Mod1+q kill
bindsym Mod1+1 workspace number 1
bindsym Mod1+2 workspace number 2
bindsym Mod1+3 workspace number 3
bindsym Mod1+4 workspace number 4
bindsym Mod1+5 workspace number 5

### session ###
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

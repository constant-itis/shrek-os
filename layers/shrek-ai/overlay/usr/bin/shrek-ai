#!/bin/sh
# shrek-ai — back-compat alias for the ShrekOS AI front door (ADR-006 §6). The canonical entry is now the
# Rust CLI dispatch `shrek ai` (crates/shrek); this thin wrapper stays as a convenience alias. Both forward
# to the same logic in /usr/lib/shrek/ai/shrek-ai-front-door.
exec /usr/lib/shrek/ai/shrek-ai-front-door "$@"
